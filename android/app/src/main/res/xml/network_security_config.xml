<?xml version="1.0" encoding="utf-8"?>
<!--
  The app's network use:
  - raw TCP to the paired PC's private LAN address (protected by the LAN protocol's own encryption, which this config
    does not govern);
  - Play Billing through the Play Store app;
  - HTTPS to the licence server (licenses.localgatekeys.app), to claim the desktop licence after a Play purchase;
  - HTTPS to Have I Been Pwned's range API (api.pwnedpasswords.com), only when the person starts a breach check in the
    Security tab (off by default; only a 5-character hash prefix is sent).
  No cleartext and only the system's certificate authorities (never user-added ones), with no per-domain exceptions.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
