# Extension text is LF everywhere: the Safari resources under ios/ (LF) are built from these files and a test
# compares them byte for byte, also on a Windows checkout with core.autocrlf on.
browser-extension/**/*.js text eol=lf
browser-extension/**/*.json text eol=lf
browser-extension/**/*.html text eol=lf
browser-extension/**/*.css text eol=lf
browser-extension/**/*.txt text eol=lf

# The website build writes _headers with LF and a test compares it with the source byte for byte.
website/**/_headers text eol=lf

# Compared byte for byte with browser-extension/site-logos.json (LF, see above).
src/localvault/assets/site_logos.json text eol=lf

# Translation catalogs are LF (a tool run on Windows once rewrote them with CRLF, 2026-11-18).
src/localvault/assets/i18n/*.json text eol=lf
