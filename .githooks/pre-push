#!/usr/bin/env bash
# Runs the local CI before every push (enable once: git config core.hooksPath .githooks).
# Only the jobs whose files the push changes run: a docs-only push runs nothing.
# Windows: scripts/ci_local.ps1 without the slow build job and the network security scans.
# macOS: the Swift package tests, when ios/ or the shared test vectors change.
# A push that only deletes branches skips the checks. LGK_PUSH_FULL=1 runs every job.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
pushing=0
files=""
full="${LGK_PUSH_FULL:-0}"
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  pushing=1
  base=""
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base="$remote_sha"
  else
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
  fi
  if [ -z "$base" ]; then full=1; continue; fi
  files="$files"$'\n'"$(git diff --name-only "$base" "$local_sha")"
done
[ "$pushing" -eq 0 ] && exit 0

python=0; node=0; webui=0; kotlin=0; worker=0; dotnet=0; swift=0
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    docs/*|*.md|*.png|*.jpg|*.jpeg|*.gif|*.webp|*.csv) continue ;;
  esac
  case "$f" in
    ios/*) swift=1 ;;
    android/*) kotlin=1 ;;
    tests/vectors/*) kotlin=1; swift=1 ;;
  esac
  case "$f" in
    browser-extension/*|package.json|package-lock.json|tests/*.cjs|tests/extension/*) node=1 ;;
    webui/*) webui=1 ;;
    cloudflare/*) worker=1 ;;
    windows-passkey-provider/*) dotnet=1 ;;
  esac
  # The Python tests also read the other platforms' files (vectors, parity, packaging).
  python=1
done <<< "$files"

case "$(uname -s)" in
  Darwin)
    if [ "$full" = 1 ] || [ "$swift" = 1 ]; then exec scripts/ci_local_mac.sh --core-only; fi
    echo "pre-push: no Swift changes, skipping the Swift tests"; exit 0 ;;
esac

if [ "$full" = 1 ]; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/ci_local.ps1 -NoInstall -SkipSecurity
fi
jobs=""
for j in python node webui kotlin worker dotnet; do
  [ "${!j}" = 1 ] && jobs="$jobs${jobs:+,}$j"
done
if [ -z "$jobs" ]; then echo "pre-push: nothing testable changed, skipping the local CI"; exit 0; fi
echo "pre-push: running $jobs"
exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/ci_local.ps1 -NoInstall -SkipSecurity -Only "$jobs"
