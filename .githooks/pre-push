#!/usr/bin/env bash
# Runs the local CI before every push (enable once: git config core.hooksPath .githooks).
# Windows: scripts/ci_local.ps1 without the slow build job. macOS: the Swift
# package tests. A push that only deletes branches skips the checks.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

pushing=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" != "0000000000000000000000000000000000000000" ] && pushing=1
done
[ "$pushing" -eq 0 ] && exit 0

case "$(uname -s)" in
  Darwin) exec scripts/ci_local_mac.sh --core-only ;;
  *) exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/ci_local.ps1 -NoInstall ;;
esac
