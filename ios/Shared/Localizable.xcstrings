    "At least %lld characters. You'll need this password to restore the backup; it can't be recovered." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens %lld Zeichen. Sie brauchen dieses Passwort, um das Backup wiederherzustellen; es kann nicht wiederhergestellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al menos %lld caracteres. Necesitarás esta contraseña para restaurar la copia de seguridad; no se puede recuperar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almeno %lld caratteri. Ti servirà questa password per ripristinare il backup; non può essere recuperata."
