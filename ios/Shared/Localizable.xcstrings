    "sync.lostChecklistCloudSignOut" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie das verlorene Gerät von dem Cloud-Konto ab, in dem der Synchronisierungsordner liegt, damit es den Ordner nicht mehr lesen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign the lost device out of the cloud account that holds the sync folder, so it can no longer read the folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra la sesión del dispositivo perdido en la cuenta en la nube que guarda la carpeta de sincronización, para que ya no pueda leerla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déconnectez l’appareil perdu du compte cloud qui contient le dossier de synchronisation, afin qu’il ne puisse plus lire le dossier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disconnetti il dispositivo perso dall'account cloud che contiene la cartella di sincronizzazione, così non potrà più leggerla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期フォルダーがあるクラウドアカウントから紛失したデバイスをサインアウトして、フォルダーを読めないようにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화 폴더가 있는 클라우드 계정에서 분실한 기기를 로그아웃해 더 이상 폴더를 읽을 수 없게 하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meld het verloren apparaat af bij het cloudaccount met de synchronisatiemap, zodat het de map niet meer kan lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyloguj zgubione urządzenie z konta w chmurze, na którym jest folder synchronizacji, aby nie mogło już go odczytać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desconecte o dispositivo perdido da conta na nuvem que guarda a pasta de sincronização, para que ele não consiga mais lê-la."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将丢失的设备从存放同步文件夹的云账户中退出登录，使其无法再读取该文件夹。"
          }
        }
      }
    },
    "sync.lostChecklistEncrypted" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie auf dem verlorenen Gerät bleibt verschlüsselt, ist aber nur so sicher wie Ihr Master-Passwort. Ist Ihr Master-Passwort kurz oder auch anderswo in Gebrauch, ändern Sie die Passwörter in diesem Tresor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The copy on the lost device stays encrypted, but it is only as safe as your master password. If your master password is short or used anywhere else, change the passwords in this vault."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia del dispositivo perdido sigue cifrada, pero solo es tan segura como tu contraseña maestra. Si tu contraseña maestra es corta o la usas en otro sitio, cambia las contraseñas de esta bóveda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie sur l’appareil perdu reste chiffrée, mais elle n’est aussi sûre que votre mot de passe principal. Si votre mot de passe principal est court ou utilisé ailleurs, changez les mots de passe de ce coffre-fort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia sul dispositivo perso resta cifrata, ma è sicura solo quanto la tua password principale. Se la tua password principale è corta o la usi altrove, cambia le password di questa cassaforte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紛失したデバイス上のコピーは暗号化されたままですが、その安全性はマスターパスワード次第です。マスターパスワードが短い場合やほかでも使っている場合は、この保管庫のパスワードを変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분실한 기기의 사본은 암호화된 상태로 남지만, 안전성은 마스터 비밀번호에 달려 있습니다. 마스터 비밀번호가 짧거나 다른 곳에서도 쓰고 있다면 이 보관함의 비밀번호를 변경하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kopie op het verloren apparaat blijft versleuteld, maar is maar zo veilig als uw hoofdwachtwoord. Is uw hoofdwachtwoord kort of gebruikt u het ook ergens anders, wijzig dan de wachtwoorden in deze kluis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopia na zgubionym urządzeniu pozostaje zaszyfrowana, ale jest tylko tak bezpieczna jak Twoje główne hasło. Jeśli główne hasło jest krótkie lub używasz go gdzie indziej, zmień hasła z tego sejfu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cópia no dispositivo perdido continua criptografada, mas só é tão segura quanto a sua senha mestra. Se a sua senha mestra for curta ou usada em outro lugar, troque as senhas deste cofre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "丢失设备上的副本仍处于加密状态，但其安全性取决于你的主密码。如果你的主密码较短或在其他地方也使用过，请更改此保管库中的密码。"
          }
        }
      }
    },
    "sync.lostChecklistEraseFolder" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das verlorene Gerät löscht seine Kopie nur, wenn es mit laufendem LocalGateKeys online geht, seine Löschen-Einstellung an ist und es den Synchronisierungsordner erreicht. Wer es offline hält oder die Tresordatei vorher kopiert, wird nicht aufgehalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The lost device erases its copy only if it goes online with LocalGateKeys running, its erase setting on, and the sync folder in reach. Someone who keeps it offline or copies the vault file first is not stopped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo perdido borra su copia solo si se conecta con LocalGateKeys en ejecución, con su ajuste de borrado activado y la carpeta de sincronización a su alcance. Quien lo mantenga sin conexión o copie antes el archivo de la bóveda no queda detenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil perdu n’efface sa copie que s’il se connecte avec LocalGateKeys en cours d’exécution, son paramètre d’effacement activé et le dossier de synchronisation à portée. Une personne qui le garde hors ligne ou copie d’abord le fichier du coffre-fort n’est pas arrêtée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo perso cancella la sua copia solo se va online con LocalGateKeys in esecuzione, l'impostazione di cancellazione attiva e la cartella di sincronizzazione raggiungibile. Chi lo tiene offline o copia prima il file della cassaforte non viene fermato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紛失したデバイスがコピーを消去するのは、LocalGateKeysを実行した状態でオンラインになり、消去の設定がオンで、同期フォルダーに届く場合だけです。オフラインのままにされたり、先に保管庫ファイルをコピーされたりした場合は防げません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분실한 기기는 LocalGateKeys가 실행 중인 상태로 온라인이 되고, 지우기 설정이 켜져 있고, 동기화 폴더에 연결될 수 있을 때만 사본을 지웁니다. 기기를 오프라인으로 두거나 보관함 파일을 먼저 복사하는 사람은 막을 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het verloren apparaat wist zijn kopie alleen als het online komt terwijl LocalGateKeys draait, de wisinstelling aan staat en de synchronisatiemap bereikbaar is. Wie het offline houdt of eerst het kluisbestand kopieert, wordt niet tegengehouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgubione urządzenie wymaże swoją kopię tylko wtedy, gdy połączy się z siecią przy uruchomionym LocalGateKeys, z włączonym ustawieniem wymazywania i dostępem do folderu synchronizacji. Ktoś, kto trzyma je offline lub najpierw skopiuje plik sejfu, nie zostanie powstrzymany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo perdido só apaga a cópia se ficar online com o LocalGateKeys em execução, a opção de apagar ativada e a pasta de sincronização ao alcance. Quem o mantiver offline ou copiar antes o arquivo do cofre não é impedido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有当丢失的设备在运行 LocalGateKeys 的情况下联网、其清除设置已开启并且能访问同步文件夹时，它才会清除其副本。让设备保持离线或先复制保管库文件的人无法被阻止。"
          }
        }
      }
    },
    "sync.lostChecklistFindDevice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperren oder löschen Sie das Gerät nach Möglichkeit aus der Ferne über das Konto, mit dem es angemeldet ist (bei einem Apple-Gerät „Wo ist?“)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you can, lock or erase the device remotely through the account it is signed in to (for an Apple device, Find My)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si puedes, bloquea o borra el dispositivo a distancia desde la cuenta con la que tiene la sesión iniciada (en un dispositivo Apple, Buscar)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous le pouvez, verrouillez ou effacez l’appareil à distance via le compte auquel il est connecté (pour un appareil Apple, Localiser)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se puoi, blocca o inizializza il dispositivo a distanza tramite l'account con cui è connesso (per un dispositivo Apple, Dov'è)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能であれば、デバイスがサインインしているアカウントからリモートでロックまたは消去してください（Apple デバイスなら「探す」）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가능하면 기기가 로그인된 계정을 통해 원격으로 잠그거나 지우세요(Apple 기기는 나의 찾기)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrendel of wis het apparaat zo mogelijk op afstand via het account waarmee het is ingelogd (bij een Apple-apparaat: Zoek mijn)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli możesz, zablokuj lub wymaż urządzenie zdalnie przez konto, na które jest zalogowane (w przypadku urządzenia Apple: Znajdź)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se puder, bloqueie ou apague o dispositivo remotamente pela conta em que ele está conectado (em um dispositivo Apple, Buscar)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果可以，请通过设备登录的账户远程锁定或抹掉该设备（Apple 设备使用“查找”）。"
          }
        }
      }
    },
    "sync.lostChecklistPasswords" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändern Sie zuerst die Passwörter Ihrer wichtigen Konten: E-Mail, Bank, Einkauf und jedes Passwort, das Sie an mehreren Stellen verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change the passwords of your important accounts first: email, banking, shopping, and any password you use in more than one place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia primero las contraseñas de tus cuentas importantes: correo, banco, compras y cualquier contraseña que uses en más de un sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changez d’abord les mots de passe de vos comptes importants : e-mail, banque, achats, et tout mot de passe que vous utilisez à plusieurs endroits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia prima le password dei tuoi account importanti: email, banca, acquisti e qualsiasi password che usi in più di un posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず重要なアカウントのパスワードを変更してください。メール、銀行、ショッピング、そして複数の場所で使っているパスワードです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 중요한 계정의 비밀번호를 변경하세요. 이메일, 은행, 쇼핑, 그리고 여러 곳에서 쓰는 비밀번호입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzig eerst de wachtwoorden van uw belangrijke accounts: e-mail, bank, winkelen en elk wachtwoord dat u op meer dan één plek gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw zmień hasła do ważnych kont: poczty, banku, zakupów oraz każde hasło używane w więcej niż jednym miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troque primeiro as senhas das suas contas importantes: e-mail, banco, compras e qualquer senha que você use em mais de um lugar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先更改重要账户的密码：电子邮件、银行、购物，以及你在多个地方使用的任何密码。"
          }
        }
      }
    },
    "sync.noSyncGroupPaired" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Ordner gibt es keine Synchronisierungsgruppe. Wählen Sie den Ordner, den ein anderes Gerät dieser Gruppe bereits verwendet. Wenn die Gruppe noch keinen Cloud-Ordner hat, wählen Sie „Cloud-Ordner zu dieser Gruppe hinzufügen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This folder has no sync group. Choose the folder another device in this group already uses. If the group has no cloud folder yet, choose Add a cloud folder to this group."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ningún grupo de sincronización en esta carpeta. Elige la carpeta que ya usa otro dispositivo de este grupo. Si el grupo aún no tiene una carpeta en la nube, elige «Añadir una carpeta en la nube a este grupo»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a pas de groupe de synchronisation dans ce dossier. Choisissez le dossier qu’un autre appareil de ce groupe utilise déjà. Si le groupe n’a pas encore de dossier cloud, choisissez « Ajouter un dossier cloud à ce groupe »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In questa cartella non c'è nessun gruppo di sincronizzazione. Scegli la cartella già usata da un altro dispositivo di questo gruppo. Se il gruppo non ha ancora una cartella cloud, scegli «Aggiungi una cartella cloud a questo gruppo»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフォルダーには同期グループがありません。このグループのほかのデバイスがすでに使っているフォルダーを選んでください。グループにまだクラウドフォルダーがない場合は、「このグループにクラウドフォルダーを追加」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 폴더에는 동기화 그룹이 없습니다. 이 그룹의 다른 기기가 이미 사용하는 폴더를 선택하세요. 그룹에 아직 클라우드 폴더가 없으면 ‘이 그룹에 클라우드 폴더 추가’를 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen synchronisatiegroep in deze map. Kies de map die een ander apparaat in deze groep al gebruikt. Heeft de groep nog geen cloudmap, kies dan ‘Een cloudmap aan deze groep toevoegen’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tym folderze nie ma grupy synchronizacji. Wybierz folder, którego używa już inne urządzenie z tej grupy. Jeśli grupa nie ma jeszcze folderu w chmurze, wybierz „Dodaj folder w chmurze do tej grupy”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há um grupo de sincronização nesta pasta. Escolha a pasta que outro dispositivo deste grupo já usa. Se o grupo ainda não tiver uma pasta na nuvem, escolha “Adicionar uma pasta na nuvem a este grupo”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件夹中没有同步组。请选择此组中另一台设备已在使用的文件夹。如果此组还没有云文件夹，请选择“向此组添加云文件夹”。"
          }
        }
      }
    },
    "sync.oneItemFromCouldNot" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Eintrag von %@ konnte auf diesem PC nicht gelesen werden und wurde übersprungen; alles andere wurde synchronisiert. Ein Update von LocalGateKeys auf diesem PC behebt das meist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One item from %@ could not be read on this PC and was skipped; everything else synced. Updating LocalGateKeys on this PC usually fixes this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un elemento de %@ no se pudo leer en este PC y se omitió; todo lo demás se sincronizó. Actualizar LocalGateKeys en este PC suele solucionarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un élément de %@ n’a pas pu être lu sur ce PC et a été ignoré ; tout le reste a été synchronisé. Mettre à jour LocalGateKeys sur ce PC règle généralement le problème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un elemento di %@ non ha potuto essere letto su questo PC ed è stato saltato; tutto il resto è stato sincronizzato. Aggiornare LocalGateKeys su questo PC di solito risolve il problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の項目1件をこのPCで読み取れずスキップしましたが、ほかはすべて同期されました。このPCのLocalGateKeysを更新すると、通常は解決します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 항목 하나를 이 PC에서 읽을 수 없어 건너뛰었으며 나머지는 모두 동기화되었습니다. 이 PC의 LocalGateKeys를 업데이트하면 대개 해결됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén item van %@ kon op deze pc niet worden gelezen en is overgeslagen; al het andere is gesynchroniseerd. Het bijwerken van LocalGateKeys op deze pc lost dit meestal op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednego elementu z %@ nie udało się odczytać na tym komputerze i został pominięty; wszystko inne zsynchronizowano. Zaktualizowanie LocalGateKeys na tym komputerze zwykle to naprawia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um item de %@ não pôde ser lido neste PC e foi ignorado; todo o resto foi sincronizado. Atualizar o LocalGateKeys neste PC costuma resolver isso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自%@的一个项目无法在这台电脑上读取，已被跳过；其余内容均已同步。更新这台电脑上的 LocalGateKeys 通常可以解决此问题。"
          }
        }
      }
    },
