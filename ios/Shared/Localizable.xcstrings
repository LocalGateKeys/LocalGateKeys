    "The duress password is too close to your app password. Change more than one character." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zwangspasswort ist Ihrem App-Passwort zu ähnlich. Ändern Sie mehr als ein Zeichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La contraseña de coacción se parece demasiado a tu contraseña de la app. Cambia más de un carácter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
