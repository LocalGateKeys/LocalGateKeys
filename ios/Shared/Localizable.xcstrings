        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインとパスキーを入力するには、Safari機能拡張と自動入力をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인과 패스키를 채우려면 Safari 확장 프로그램과 자동 완성을 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
