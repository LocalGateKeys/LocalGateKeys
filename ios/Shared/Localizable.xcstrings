    "whatsNew.1.2.notes.detail" : {
      "comment" : "What's new 1.2 sheet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notizen zeigen Überschriften, Listen, Checklisten und Code. Schalten Sie „Formatierung anzeigen“ aus, um den reinen Text zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes show headings, lists, checklists and code. Turn off Show formatting to see the plain text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notas muestran títulos, listas, listas de tareas y código. Desactiva Mostrar formato para ver el texto sin formato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notes affichent titres, listes, listes de tâches et code. Désactivez Afficher la mise en forme pour voir le texte brut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le note mostrano titoli, elenchi, liste di controllo e codice. Disattiva Mostra formattazione per vedere il testo semplice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモに見出し、リスト、チェックリスト、コードが表示されます。プレーンテキストで見るには「書式を表示」をオフにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모에 제목, 목록, 체크리스트, 코드가 표시됩니다. 일반 텍스트로 보려면 서식 표시를 끄세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notities tonen koppen, lijsten, checklists en code. Zet Opmaak tonen uit om de platte tekst te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notatki pokazują nagłówki, listy, listy kontrolne i kod. Wyłącz Pokaż formatowanie, aby zobaczyć zwykły tekst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notas mostram títulos, listas, listas de verificação e código. Desative Mostrar formatação para ver o texto simples."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "笔记会显示标题、列表、清单和代码。关闭“显示格式”即可查看纯文本。"
          }
        }
      }
    },
