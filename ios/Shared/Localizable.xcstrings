    "Runs while unlocked. A run missed while the app was closed happens at the next unlock." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft, solange entsperrt ist. Ein Lauf, der bei geschlossener App verpasst wurde, erfolgt beim nächsten Entsperren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecuta mientras está desbloqueada. Una ejecución perdida mientras la aplicación estaba cerrada se hace en el siguiente desbloqueo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona mentre la cassaforte è sbloccata. Un backup saltato mentre l'app era chiusa viene eseguito al prossimo sblocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック解除中に実行されます。アプリを閉じていて実行できなかった分は、次回のロック解除時に実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 해제된 동안 실행됩니다. 앱이 닫혀 있는 동안 놓친 실행은 다음 잠금 해제 때 수행됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draait terwijl ontgrendeld. Een run die is gemist terwijl de app gesloten was, gebeurt bij de volgende ontgrendeling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Działa przy odblokowanym sejfie. Przebieg pominięty, gdy aplikacja była zamknięta, odbywa się przy następnym odblokowaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa enquanto está desbloqueado. Uma execução perdida enquanto o app estava fechado acontece no próximo desbloqueio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在解锁状态下运行。应用关闭期间错过的备份会在下次解锁时进行。"
          }
        }
      }
    },
