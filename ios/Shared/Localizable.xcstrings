      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie Ihre Wiederherstellungsphrase aus 24 Wörtern ein und wählen Sie ein neues Master-Passwort. Touch ID bleibt aus, bis Sie es in den Einstellungen wieder aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
