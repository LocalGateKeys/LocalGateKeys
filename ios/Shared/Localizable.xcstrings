    "sync.didNotMatchItsPairing" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stimmte nicht mit seiner Kopplung überein und wurde nicht synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ did not match its pairing and was not synced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no coincidió con su emparejamiento y no se sincronizó."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non corrispondeva al suo abbinamento e non è stato sincronizzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がペアリングと一致しなかったため、同期されませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 페어링과 일치하지 않아 동기화되지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
