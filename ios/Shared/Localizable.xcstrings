          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro dispositivo ha modificato la cartella di sincronizzazione nello stesso momento. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のデバイスが同時に同期フォルダーを変更しました。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
