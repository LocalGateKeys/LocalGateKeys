    "ipad.sync.thisPcCannotRemoveItself" : {
      "comment" : "iPad wording of \"This iPhone cannot remove itself. Use Leave sync instead.\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPad kann sich nicht selbst entfernen. Verwenden Sie stattdessen „Sync verlassen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPad cannot remove itself. Use Leave sync instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPad no puede quitarse a sí mismo. Usa Salir de la sincronización en su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPad ne peut pas se retirer lui-même. Utilisez plutôt Quitter la synchronisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo iPad non può rimuovere se stesso. Usa invece Esci dalla sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPadは自分自身を削除できません。代わりに「同期から退出」を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPad는 스스로를 제거할 수 없습니다. 대신 동기화 나가기를 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze iPad kan zichzelf niet verwijderen. Gebruik in plaats daarvan Synchronisatie verlaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten iPad nie może usunąć samego siebie. Użyj zamiast tego Opuść synchronizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPad não pode remover a si mesmo. Use Sair da sincronização."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPad 无法移除自己。请改用“退出同步”。"
          }
        }
      }
    },
    "ipad.sync.thisPcCouldNotWrite" : {
      "comment" : "iPad wording of \"This iPhone could not write its sync file. Check that the f…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPad konnte seine Sync-Datei nicht schreiben. Prüfen Sie, ob der Ordner verfügbar und nicht schreibgeschützt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPad could not write its sync file. Check that the folder is available and not read-only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPad no pudo escribir su archivo de sincronización. Comprueba que la carpeta esté disponible y no sea de solo lectura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPad n’a pas pu écrire son fichier de synchronisation. Vérifiez que le dossier est disponible et n’est pas en lecture seule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo iPad non ha potuto scrivere il suo file di sincronizzazione. Controlla che la cartella sia disponibile e non di sola lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPadは同期ファイルを書き込めませんでした。フォルダが利用可能で、読み取り専用でないことを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPad가 동기화 파일을 쓸 수 없었습니다. 폴더를 사용할 수 있고 읽기 전용이 아닌지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze iPad kon zijn synchronisatiebestand niet schrijven. Controleer of de map beschikbaar is en niet alleen-lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten iPad nie mógł zapisać swojego pliku synchronizacji. Sprawdź, czy folder jest dostępny i nie jest tylko do odczytu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPad não conseguiu gravar o arquivo de sincronização dele. Verifique se a pasta está disponível e não é somente leitura."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPad 无法写入其同步文件。请检查该文件夹是否可用且不是只读的。"
          }
        }
      }
    },
    "ipad.sync.thisPcHadNotSynced" : {
      "comment" : "iPad wording of \"This iPhone had not synced for over a year. Items deleted e…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPad hatte über ein Jahr nicht synchronisiert. Einträge, die vor mehr als einem Jahr anderswo gelöscht wurden, können zurückkommen; löschen Sie sie dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPad had not synced for over a year. Items deleted elsewhere more than a year ago may come back; delete them again if they do."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPad llevaba más de un año sin sincronizarse. Los elementos eliminados en otro sitio hace más de un año pueden volver; elimínalos de nuevo si vuelven."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPad ne s’était pas synchronisé depuis plus d’un an. Les éléments supprimés ailleurs il y a plus d’un an peuvent revenir ; supprimez-les de nouveau le cas échéant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo iPad non si sincronizzava da oltre un anno. Gli elementi eliminati altrove più di un anno fa potrebbero tornare; eliminali di nuovo se succede."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPadは1年以上同期されていませんでした。1年以上前に他のデバイスで削除された項目が戻ることがあります。戻った場合は、もう一度削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPad는 1년이 넘도록 동기화하지 않았습니다. 1년도 더 전에 다른 곳에서 삭제한 항목이 다시 나타날 수 있으며, 나타나면 다시 삭제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze iPad had al meer dan een jaar niet gesynchroniseerd. Items die elders meer dan een jaar geleden zijn verwijderd, kunnen terugkomen; verwijder ze dan opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten iPad nie synchronizował się od ponad roku. Elementy usunięte gdzie indziej ponad rok temu mogą wrócić; usuń je ponownie, jeśli tak się stanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPad não sincronizava havia mais de um ano. Itens excluídos em outro lugar há mais de um ano podem voltar; exclua-os de novo se isso acontecer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPad 已超过一年没有同步。在其他地方一年多以前删除的项目可能会重新出现；如果出现，请再次删除它们。"
          }
        }
      }
    },
    "ipad.sync.thisPcHasAnOlder" : {
      "comment" : "iPad wording of \"This iPhone has an older sync key than %@. Leave sync on th…\"",
