    "%@ did not answer. Check that Windows Firewall allows LocalGateKeys on Private networks, and that the PC is on this Wi-Fi." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat nicht geantwortet. Prüfen Sie, ob die Windows-Firewall LocalGateKeys in privaten Netzwerken erlaubt und der PC in diesem WLAN ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no respondió. Comprueba que el Firewall de Windows permita LocalGateKeys en redes privadas y que el PC esté en esta Wi-Fi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas répondu. Vérifiez que le pare-feu Windows autorise LocalGateKeys sur les réseaux privés, et que le PC est sur ce Wi-Fi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha risposto. Controlla che Windows Firewall consenta LocalGateKeys sulle reti private e che il PC sia su questo Wi-Fi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@から応答がありません。WindowsファイアウォールでプライベートネットワークのLocalGateKeysが許可されていること、PCがこのWi-Fiに接続されていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 응답이 없습니다. Windows 방화벽이 비공개 네트워크에서 LocalGateKeys를 허용하는지, PC가 이 Wi-Fi에 연결되어 있는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reageerde niet. Controleer of Windows Firewall LocalGateKeys toestaat op privénetwerken en of de pc op dit wifi-netwerk zit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie odpowiada. Sprawdź, czy Zapora systemu Windows zezwala LocalGateKeys w sieciach prywatnych i czy komputer jest w tej samej sieci Wi-Fi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não respondeu. Verifique se o Firewall do Windows permite o LocalGateKeys em redes privadas e se o PC está neste Wi-Fi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 没有响应。请检查 Windows 防火墙是否允许 LocalGateKeys 在专用网络上通信，以及 PC 是否在此 Wi-Fi 上。"
          }
        }
      }
    },
