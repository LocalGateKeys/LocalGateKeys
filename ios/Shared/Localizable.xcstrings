    "agents.approve.listBody" : {
      "comment" : "AI agents (Mac): Settings > Developer and the approval panel",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er sieht die Titel und Domains der Logins, die du für KI-Agenten erlaubt hast, nie Benutzernamen oder Passwörter. Du erlaubst das einmal für diese Agenten-Sitzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It sees the titles and domains of the logins you allowed for AI agents, never user names or passwords. You allow this once for this agent session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve los títulos y dominios de los inicios de sesión que permitiste a los agentes de IA, nunca nombres de usuario ni contraseñas. Lo permites una vez para esta sesión del agente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il voit les titres et les domaines des identifiants que vous avez autorisés pour les agents IA, jamais les noms d’utilisateur ni les mots de passe. Vous l’autorisez une fois pour cette session de l’agent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vede i titoli e i domini degli accessi che hai consentito agli agenti IA, mai nomi utente o password. Lo consenti una volta per questa sessione dell'agente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI エージェントに許可したログインのタイトルとドメインだけが見えます。ユーザ名やパスワードは見えません。このエージェントのセッションで一度だけ許可します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 에이전트에 허용한 로그인의 제목과 도메인만 보며, 사용자 이름이나 비밀번호는 절대 보지 않습니다. 이 에이전트 세션에 한 번만 허용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hij ziet de titels en domeinen van de logins die je voor AI-agents hebt toegestaan, nooit gebruikersnamen of wachtwoorden. Je staat dit één keer toe voor deze agentsessie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widzi tytuły i domeny loginów, na które zezwolono agentom AI, nigdy nazw użytkowników ani haseł. Zezwalasz na to raz dla tej sesji agenta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele vê os títulos e domínios dos logins que você permitiu para agentes de IA, nunca nomes de usuário ou senhas. Você permite isso uma vez para esta sessão do agente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它只能看到你允许 AI 代理使用的登录项的标题和域名，看不到用户名或密码。你为这次代理会话允许一次。"
          }
        }
      }
    },
    "agents.approve.listTitle" : {
