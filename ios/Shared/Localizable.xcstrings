    "factors.phone.addConfirm" : {
      "comment" : "iPhone app password: key file / YubiKey (NFC).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab jetzt braucht LocalGateKeys zum Entsperren das App-Passwort und diesen Faktor. Die Wiederherstellungsphrase öffnet es weiterhin ohne den Faktor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From now on LocalGateKeys needs the app password and this factor to unlock. The recovery phrase still opens it without the factor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partir de ahora LocalGateKeys necesita la contraseña de la app y este factor para desbloquearse. La frase de recuperación lo sigue abriendo sin el factor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désormais, LocalGateKeys a besoin du mot de passe de l’app et de ce facteur pour se déverrouiller. La phrase de récupération l’ouvre toujours sans le facteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’ora in poi LocalGateKeys richiede la password per app e questo fattore per sbloccarsi. La frase di recupero lo apre comunque senza il fattore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後、LocalGateKeys のロック解除にはアプリパスワードとこの要素が必要です。復旧フレーズでは引き続きこの要素なしで開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제부터 LocalGateKeys를 잠금 해제하려면 앱 비밀번호와 이 요소가 필요합니다. 복구 문구로는 여전히 이 요소 없이 열 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanaf nu heeft LocalGateKeys het app-wachtwoord en deze factor nodig om te ontgrendelen. De herstelzin opent het nog steeds zonder de factor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Od teraz do odblokowania LocalGateKeys potrzebne są hasło aplikacji i ten składnik. Fraza odzyskiwania nadal otwiera aplikację bez niego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partir de agora o LocalGateKeys precisa da senha do app e deste fator para desbloquear. A frase de recuperação ainda o abre sem o fator."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从现在起，解锁 LocalGateKeys 需要应用密码和此因素。恢复短语仍可在没有此因素的情况下打开。"
          }
        }
      }
    },
    "factors.phone.addHint" : {
      "comment" : "iPhone app password: key file / YubiKey (NFC).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dann ist zusammen mit dem App-Passwort eine Schlüsseldatei oder ein YubiKey nötig, um LocalGateKeys zu entsperren. Die Wiederherstellungsphrase öffnet es weiterhin ohne sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A key file or YubiKey is then needed together with the app password to unlock LocalGateKeys. The recovery phrase still opens it without them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después se necesita un archivo de clave o una YubiKey junto con la contraseña de la app para desbloquear LocalGateKeys. La frase de recuperación lo sigue abriendo sin ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier de clé ou une YubiKey sera alors nécessaire avec le mot de passe de l’app pour déverrouiller LocalGateKeys. La phrase de récupération l’ouvre toujours sans eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servirà poi un file chiave o una YubiKey insieme alla password per app per sbloccare LocalGateKeys. La frase di recupero lo apre comunque senza di essi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以後、LocalGateKeys のロック解除にはアプリパスワードと一緒にキーファイルまたは YubiKey が必要になります。復旧フレーズでは引き続きそれらなしで開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그러면 LocalGateKeys를 잠금 해제하려면 앱 비밀번호와 함께 키 파일 또는 YubiKey가 필요합니다. 복구 문구로는 여전히 이것들 없이 열 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daarna is samen met het app-wachtwoord een sleutelbestand of YubiKey nodig om LocalGateKeys te ontgrendelen. De herstelzin opent het nog steeds zonder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do odblokowania LocalGateKeys potrzebny będzie wtedy plik klucza lub klucz YubiKey razem z hasłem aplikacji. Fraza odzyskiwania nadal otwiera aplikację bez nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois disso, um arquivo de chave ou uma YubiKey será necessário junto com a senha do app para desbloquear o LocalGateKeys. A frase de recuperação ainda o abre sem eles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此后解锁 LocalGateKeys 需要应用密码以及密钥文件或 YubiKey。恢复短语仍可在没有它们的情况下打开。"
          }
        }
      }
    },
    "factors.phone.alwaysAskNote" : {
      "comment" : "iPhone app password: key file / YubiKey (NFC).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schaltet das Entsperren mit Face ID aus, solange eine Schlüsseldatei oder ein YubiKey eingerichtet ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
