          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La extensión de Safari está activada. Activa el autorrelleno para rellenar en apps y otros lugares."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'estensione di Safari è attiva. Attiva la compilazione automatica per compilare nelle app e in altri posti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari機能拡張はオンです。Appなど他の場所で入力するには、自動入力をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari 확장 프로그램이 켜져 있습니다. 앱과 다른 곳에서 채우려면 자동 완성을 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
