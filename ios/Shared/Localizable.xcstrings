    "collectionShare.undoFailed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys konnte nicht in diesen Ordner schreiben, und das Teilen konnte nicht rückgängig gemacht werden. Wählen Sie „Teilen beenden“ und versuchen Sie es dann mit einem anderen Ordner erneut."
          }
        },
        "en" : {
          "stringUnit" : {
