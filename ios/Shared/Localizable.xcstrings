          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie zgadzało się ze swoim parowaniem i nie zostało zsynchronizowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não correspondeu ao pareamento dele e não foi sincronizado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@与其配对不符，没有同步。"
          }
        }
      }
    },
    "sync.disappearedFromTheMemberList" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ohne Passwortänderung aus der Mitgliederliste verschwunden. Wenn Sie es nicht entfernt haben, ändern Sie das Synchronisierungspasswort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ disappeared from the member list without a password change. If you did not remove it, change the sync password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ desapareció de la lista de miembros sin un cambio de contraseña. Si no lo quitaste tú, cambia la contraseña de sincronización."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è sparito dall'elenco dei membri senza un cambio di password. Se non l'hai rimosso tu, cambia la password di sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が、パスワードの変更なしにメンバー一覧から消えました。削除した覚えがない場合は、同期パスワードを変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 비밀번호 변경 없이 구성원 목록에서 사라졌습니다. 직접 제거하지 않았다면 동기화 비밀번호를 변경하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is zonder wachtwoordwijziging uit de ledenlijst verdwenen. Als je het niet hebt verwijderd, wijzig dan het synchronisatiewachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zniknęło z listy członków bez zmiany hasła. Jeśli go nie usuwano, zmień hasło synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ desapareceu da lista de membros sem uma alteração de senha. Se você não o removeu, altere a senha de sincronização."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@在没有更改密码的情况下从成员列表中消失了。如果不是您移除的，请更改同步密码。"
          }
        }
      }
    },
    "sync.hasADifferentSigningKey" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat in der Mitgliederliste des Synchronisierungsordners einen anderen Signaturschlüssel als zuvor. Wenn Sie dieses Gerät nicht neu eingerichtet haben, entfernen Sie Geräte, denen Sie nicht vertrauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has a different signing key in the sync folder's member list than before. If you did not set that device up again, remove devices you do not trust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiene en la lista de miembros de la carpeta de sincronización una clave de firma distinta de la de antes. Si no volviste a configurar ese dispositivo, quita los dispositivos en los que no confíes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha nell'elenco dei membri della cartella di sincronizzazione una chiave di firma diversa da prima. Se non hai configurato di nuovo quel dispositivo, rimuovi i dispositivi di cui non ti fidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の署名キーが、同期フォルダーのメンバー一覧で以前と異なっています。そのデバイスを設定し直していない場合は、信頼できないデバイスを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 서명 키가 동기화 폴더의 구성원 목록에서 이전과 다릅니다. 해당 기기를 다시 설정하지 않았다면 신뢰하지 않는 기기를 제거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft in de ledenlijst van de synchronisatiemap een andere ondertekeningssleutel dan eerder. Als je dat apparaat niet opnieuw hebt ingesteld, verwijder dan apparaten die je niet vertrouwt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ma w liście członków folderu synchronizacji inny klucz podpisu niż wcześniej. Jeśli nie konfigurowano tego urządzenia ponownie, usuń urządzenia, którym nie ufasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tem na lista de membros da pasta de sincronização uma chave de assinatura diferente da anterior. Se você não configurou esse dispositivo de novo, remova os dispositivos em que não confia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@在同步文件夹成员列表中的签名密钥与之前不同。如果您没有重新设置过该设备，请移除您不信任的设备。"
          }
        }
      }
    },
    "sync.hasAnOlderSyncKey" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat einen älteren Synchronisierungsschlüssel. Koppeln Sie es erneut über „QR-Code anzeigen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has an older sync key. Pair it again with Show QR code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiene una clave de sincronización más antigua. Vuelve a emparejarlo con Mostrar código QR."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha una chiave di sincronizzazione più vecchia. Associalo di nuovo con Mostra codice QR."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の同期キーが古くなっています。「QRコードを表示」でもう一度ペアリングしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 동기화 키가 오래되었습니다. QR 코드 표시로 다시 페어링하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ heeft een oudere synchronisatiesleutel. Koppel het opnieuw met QR-code tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ma starszy klucz synchronizacji. Sparuj je ponownie za pomocą Pokaż kod QR."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tem uma chave de sincronização mais antiga. Pareie-o novamente com Mostrar QR code."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@使用的是较旧的同步密钥。请通过“显示二维码”重新配对。"
          }
        }
      }
    },
    "sync.hasNoNetworkAddressIt" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat keine Netzwerkadresse; es verbindet sich stattdessen mit diesem PC."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has no network address; it connects to this PC instead."
