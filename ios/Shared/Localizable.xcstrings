    "ipad.trashView.deletedItemsStayEncrypted" : {
      "comment" : "iPad wording of \"Deleted items stay encrypted on this iPhone and are removed…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschte Einträge bleiben auf diesem iPad verschlüsselt und werden nach dieser Zeit endgültig entfernt. Sie zählen nicht zu den Einträgen des kostenlosen Tarifs. Ältere Backups können sie noch enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted items stay encrypted on this iPad and are removed for good after this time. They don't count toward the free plan's items. Older backups may still contain them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos eliminados siguen cifrados en este iPad y se borran definitivamente pasado este tiempo. No cuentan para los elementos del plan gratuito. Las copias de seguridad más antiguas aún pueden contenerlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments supprimés restent chiffrés sur cet iPad et sont définitivement retirés après ce délai. Ils ne comptent pas dans les éléments de l’offre gratuite. D’anciennes sauvegardes peuvent encore les contenir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi eliminati restano cifrati su questo iPad e vengono rimossi definitivamente dopo questo periodo. Non contano per gli elementi del piano gratuito. I backup meno recenti potrebbero ancora contenerli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除した項目は、このiPad上で暗号化されたまま保持され、この期間が過ぎると完全に削除されます。無料プランの項目数には含まれません。古いバックアップには、まだ含まれている場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제된 항목은 이 iPad에 암호화된 상태로 남아 있다가 이 기간이 지나면 완전히 제거됩니다. 무료 플랜의 항목 수에는 포함되지 않습니다. 이전 백업에는 여전히 포함되어 있을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijderde items blijven versleuteld op deze iPad staan en worden na deze tijd definitief verwijderd. Ze tellen niet mee voor de items van het gratis abonnement. Oudere back-ups kunnen ze nog bevatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięte elementy pozostają zaszyfrowane na tym iPadzie i po tym czasie są usuwane na stałe. Nie liczą się do elementów planu darmowego. Starsze kopie zapasowe mogą je nadal zawierać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os itens excluídos continuam criptografados neste iPad e são removidos definitivamente após esse tempo. Eles não contam para os itens do plano gratuito. Backups mais antigos ainda podem contê-los."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已删除的项目在这台 iPad 上保持加密，超过此时间后将被永久移除。它们不计入免费版的项目数。较早的备份中可能仍包含这些项目。"
          }
        }
      }
    },
