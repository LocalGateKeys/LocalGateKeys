    "sync.anotherDeviceSentAReply" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderes Gerät hat eine Antwort gesendet, die dieser PC nicht verstehen konnte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another device sent a reply this PC could not understand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otro dispositivo envió una respuesta que este PC no pudo entender."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro dispositivo ha inviato una risposta che questo PC non ha capito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のデバイスから、このPCが理解できない応答が届きました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기가 이 PC에서 이해할 수 없는 응답을 보냈습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een ander apparaat stuurde een antwoord dat deze pc niet kon begrijpen."
