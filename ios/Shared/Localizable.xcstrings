    "ipad.editorView.movesRecentlyDeletedAnd" : {
      "comment" : "iPad wording of \"It moves to Recently deleted on this iPhone and is removed …\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird auf diesem iPad nach „Zuletzt gelöscht“ verschoben und bei der nächsten Synchronisierung von Ihren anderen Geräten entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It moves to Recently deleted on this iPad and is removed from your other devices at the next sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa a Eliminados recientemente en este iPad y se quita de tus otros dispositivos en la siguiente sincronización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est déplacé dans Supprimés récemment sur cet iPad et retiré de vos autres appareils à la prochaine synchronisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene spostato in Eliminati di recente su questo iPad e rimosso dagli altri tuoi dispositivi alla prossima sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPadの「最近削除した項目」に移動し、次回の同期時に他のデバイスから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPad의 최근 삭제됨으로 이동하며 다음 동기화 때 다른 기기에서 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het gaat naar Onlangs verwijderd op deze iPad en wordt bij de volgende synchronisatie van je andere apparaten verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trafia do Ostatnio usuniętych na tym iPadzie i zostaje usunięty z Twoich pozostałych urządzeń przy następnej synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele vai para Excluídos recentemente neste iPad e é removido dos seus outros dispositivos na próxima sincronização."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它会移至这台 iPad 的“最近删除”，并在下次同步时从您的其他设备上移除。"
          }
        }
      }
    },
