        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次检查由您启动。它发送哈希的 5 个字符，绝不发送密码。"
          }
        }
      }
    },
    "You will also need the master password of the backed-up vault." : {
