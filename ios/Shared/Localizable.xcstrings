    "sync.areYouSureThisCannot" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher? Dies kann nicht rückgängig gemacht werden. Synchronisierung auf diesem PC jetzt zurücksetzen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure? This cannot be undone. Reset sync on this PC now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro? Esto no se puede deshacer. ¿Restablecer ahora la sincronización en este PC?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro? Non si può annullare. Reimpostare ora la sincronizzazione su questo PC?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よろしいですか? この操作は元に戻せません。今すぐこのPCの同期をリセットしますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정말 진행하시겠습니까? 되돌릴 수 없습니다. 지금 이 PC의 동기화를 초기화하시겠습니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je het zeker? Dit kan niet ongedaan worden gemaakt. Synchronisatie op deze pc nu resetten?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na pewno? Tej operacji nie można cofnąć. Zresetować synchronizację na tym komputerze teraz?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza? Isto não pode ser desfeito. Redefinir a sincronização neste PC agora?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确定吗？此操作无法撤销。现在重置这台电脑上的同步吗？"
          }
        }
      }
    },
