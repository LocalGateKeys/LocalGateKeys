    },
    "A full backup from a computer: type its backup password and the master password of the computer that made it. Nothing is restored or kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine vollständige Sicherung von einem Computer: Geben Sie ihr Sicherungspasswort und das Master-Passwort des Computers ein, der sie erstellt hat. Nichts wird wiederhergestellt oder behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia completa de un ordenador: escribe su contraseña de copia y la contraseña maestra del ordenador que la creó. No se restaura ni se guarda nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sauvegarde complète d'un ordinateur : saisissez son mot de passe de sauvegarde et le mot de passe principal de l'ordinateur qui l'a créée. Rien n'est restauré ni conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un backup completo di un computer: inserisci la sua password di backup e la password principale del computer che l'ha creato. Nulla viene ripristinato o conservato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンピュータのフルバックアップです。バックアップのパスワードと、作成したコンピュータのマスターパスワードを入力してください。何も復元・保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴퓨터의 전체 백업입니다. 백업 비밀번호와 백업을 만든 컴퓨터의 마스터 비밀번호를 입력하세요. 아무것도 복원되거나 보관되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een volledige back-up van een computer: typ het back-upwachtwoord en het hoofdwachtwoord van de computer die hem maakte. Er wordt niets hersteld of bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pełna kopia zapasowa z komputera: wpisz jej hasło kopii i hasło główne komputera, który ją utworzył. Nic nie jest przywracane ani zachowywane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um backup completo de um computador: digite a senha do backup e a senha mestra do computador que o criou. Nada é restaurado nem mantido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自电脑的完整备份:请输入其备份密码以及创建它的那台电脑的主密码。不会恢复或保留任何内容。"
          }
        }
      }
    },
    "A list of connections isn't available on this device yet." : {
      "comment" : "Feature pack (item history, travel mode, access rules, clean-up, privacy proof, passkeys)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
