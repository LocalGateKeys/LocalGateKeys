    "sync.changesFromYourOtherDevices" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen Ihrer anderen Geräte konnten nicht gespeichert werden. Die Synchronisierung versucht es später erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changes from your other devices could not be saved. Sync tries again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron guardar los cambios de tus otros dispositivos. La sincronización lo intentará de nuevo más tarde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare le modifiche dei tuoi altri dispositivi. La sincronizzazione riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのデバイスからの変更を保存できませんでした。同期は後でもう一度試します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기의 변경 사항을 저장할 수 없습니다. 나중에 동기화를 다시 시도합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wijzigingen van je andere apparaten konden niet worden opgeslagen. Synchronisatie probeert het later opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać zmian z Twoich pozostałych urządzeń. Synchronizacja spróbuje ponownie później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As alterações dos seus outros dispositivos não puderam ser salvas. A sincronização tenta de novo mais tarde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存来自您其他设备的更改。同步稍后会重试。"
          }
        }
      }
    },
    "sync.chooseANewSyncPassword" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie ein neues Synchronisierungspasswort; es muss sich vom aktuellen unterscheiden."
          }
        },
        "en" : {
          "stringUnit" : {
