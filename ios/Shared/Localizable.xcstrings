    "A copy of each scheduled backup also goes to this folder, for example one your cloud app syncs. Only encrypted backups are copied." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kopie jedes geplanten Backups wird auch in diesen Ordner gelegt, zum Beispiel in einen, den Ihre Cloud-App synchronisiert. Es werden nur verschlüsselte Backups kopiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia de cada copia de seguridad programada también va a esta carpeta, por ejemplo una que tu aplicación en la nube sincronice. Solo se copian las copias de seguridad cifradas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia di ogni backup programmato viene salvata anche in questa cartella, ad esempio una che la tua app cloud sincronizza. Vengono copiati solo i backup cifrati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スケジュールされた各バックアップのコピーが、このフォルダ(たとえばクラウドアプリが同期するフォルダ)にも保存されます。コピーされるのは暗号化されたバックアップのみです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예약된 백업의 사본이 이 폴더에도 저장됩니다(예: 클라우드 앱이 동기화하는 폴더). 암호화된 백업만 복사됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een kopie van elke geplande back-up gaat ook naar deze map, bijvoorbeeld een map die je cloud-app synchroniseert. Alleen versleutelde back-ups worden gekopieerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopia każdej zaplanowanej kopii zapasowej trafia też do tego folderu, na przykład synchronizowanego przez Twoją aplikację chmurową. Kopiowane są tylko zaszyfrowane kopie zapasowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma cópia de cada backup agendado também vai para esta pasta, por exemplo uma que seu app de nuvem sincroniza. Só backups criptografados são copiados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次定时备份的副本也会存入此文件夹，例如您的云应用同步的文件夹。只会复制已加密的备份。"
          }
        }
      }
    },
    "A new home" : {
