    "It is removed from this iPhone and from your other devices at the next sync." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird bei der nächsten Synchronisierung von diesem iPhone und von Ihren anderen Geräten entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quita de este iPhone y de tus otros dispositivos en la siguiente sincronización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est retiré de cet iPhone et de vos autres appareils à la prochaine synchronisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene rimosso da questo iPhone e dagli altri tuoi dispositivi alla prossima sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次回の同期時に、このiPhoneと他のデバイスから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone에서 제거되며 다음 동기화 때 다른 기기에서도 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wordt bij de volgende synchronisatie van deze iPhone en van je andere apparaten verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostanie usunięty z tego iPhone'a i z Twoich pozostałych urządzeń przy następnej synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele é removido deste iPhone e dos seus outros dispositivos na próxima sincronização."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它会在下次同步时从这台 iPhone 和您的其他设备上移除。"
          }
        }
      }
    },
    "It is removed from this iPhone and from your other devices at the next sync. It can only be edited on your PC." : {
