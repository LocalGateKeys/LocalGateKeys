    "Checked %lld unique passwords · %lld logins exposed · %lld errors. Not found does not prove a password is safe." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld einzigartige Passwörter geprüft · %2$lld Anmeldungen betroffen · %3$lld Fehler. „Nicht gefunden“ beweist nicht, dass ein Passwort sicher ist."
          }
        },
        "en" : {
          "stringUnit" : {
