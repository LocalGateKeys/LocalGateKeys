    "The backup destination appears to be on the same disk as the live profile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Backup-Ziel scheint sich auf demselben Datenträger wie das aktive Profil zu befinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El destino de la copia de seguridad parece estar en el mismo disco que el perfil activo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La destinazione del backup sembra trovarsi sullo stesso disco del profilo in uso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップの保存先が、使用中のプロファイルと同じディスクにあるようです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업 대상이 활성 프로필과 같은 디스크에 있는 것 같습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De back-upbestemming lijkt op dezelfde schijf te staan als het actieve profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miejsce docelowe kopii zapasowej wydaje się znajdować na tym samym dysku co działający profil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
