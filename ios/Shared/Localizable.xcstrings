    },
    "On your PC open Sync and choose Show QR code, then scan it. Only the address is updated; the pairing stays as it is." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie auf Ihrem PC Sync, wählen Sie „QR-Code anzeigen“ und scannen Sie ihn dann. Es wird nur die Adresse aktualisiert; die Kopplung bleibt bestehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu PC abre Sincronización y elige Mostrar código QR; luego escanéalo. Solo se actualiza la dirección; el emparejamiento se queda como está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur votre PC, ouvrez Synchronisation et choisissez Afficher le code QR, puis scannez-le. Seule l’adresse est mise à jour ; l’association reste telle quelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sul tuo PC apri Sincronizzazione e scegli Mostra codice QR, poi scansionalo. Viene aggiornato solo l'indirizzo; l'associazione resta com'è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PCで「同期」を開き、「QRコードを表示」を選んでスキャンしてください。更新されるのはアドレスのみで、ペアリングはそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PC에서 동기화를 열고 QR 코드 표시를 선택한 다음 스캔하세요. 주소만 업데이트되며 페어링은 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Synchronisatie op je pc, kies QR-code tonen en scan de code. Alleen het adres wordt bijgewerkt; de koppeling blijft zoals ze is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na komputerze otwórz Sync i wybierz Pokaż kod QR, a potem zeskanuj go. Aktualizowany jest tylko adres; parowanie pozostaje bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No PC, abra Sincronização e escolha Mostrar QR code; depois escaneie. Só o endereço é atualizado; o pareamento continua como está."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在您的 PC 上打开“同步”并选择“显示二维码”，然后扫描它。只会更新地址；配对保持不变。"
          }
        }
      }
    },
