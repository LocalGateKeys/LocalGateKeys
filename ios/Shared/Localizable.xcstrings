    "sync.syncCouldNotKeepItem" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung konnte den Eintragsverlauf nicht behalten, weil das Verlaufslimit erreicht wurde. Löschen Sie den alten Verlauf und synchronisieren Sie dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync could not keep item history because the history limit was reached. Clear old history, then sync again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización no pudo conservar el historial de elementos porque se alcanzó el límite del historial. Borra el historial antiguo y vuelve a sincronizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation n’a pas pu conserver l’historique de l’élément car la limite d’historique est atteinte. Effacez l’ancien historique, puis synchronisez de nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione non ha potuto conservare la cronologia dell'elemento perché è stato raggiunto il limite della cronologia. Cancella la cronologia vecchia, poi sincronizza di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目の履歴の上限に達したため、同期で項目の履歴を保持できませんでした。古い履歴を消去してから、もう一度同期してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록 한도에 도달하여 동기화가 항목 기록을 유지할 수 없었습니다. 오래된 기록을 지운 다음 다시 동기화하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisatie kon de itemgeschiedenis niet bewaren omdat de geschiedenislimiet is bereikt. Wis oude geschiedenis en synchroniseer opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja nie mogła zachować historii elementu, ponieważ osiągnięto limit historii. Wyczyść starą historię, a potem zsynchronizuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização não conseguiu manter o histórico do item porque o limite do histórico foi atingido. Limpe o histórico antigo e sincronize novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于已达到历史记录上限，同步无法保留项目历史记录。请清理旧的历史记录，然后再次同步。"
          }
        }
      }
    },
    "sync.syncCouldNotMoveDeleted" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung konnte gelöschte Einträge nicht in den Papierkorb verschieben, weil der Papierkorb voll ist. Leeren Sie den Papierkorb und synchronisieren Sie dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync could not move deleted items to the trash because the trash is full. Empty the trash, then sync again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización no pudo mover los elementos eliminados a la papelera porque está llena. Vacía la papelera y vuelve a sincronizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation n’a pas pu mettre les éléments supprimés dans la corbeille car elle est pleine. Videz la corbeille, puis synchronisez de nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione non ha potuto spostare gli elementi eliminati nel cestino perché è pieno. Svuota il cestino, poi sincronizza di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゴミ箱がいっぱいのため、同期で削除された項目をゴミ箱へ移せませんでした。ゴミ箱を空にしてから、もう一度同期してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴지통이 가득 차서 동기화가 삭제된 항목을 휴지통으로 이동할 수 없었습니다. 휴지통을 비운 다음 다시 동기화하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisatie kon verwijderde items niet naar de prullenbak verplaatsen omdat de prullenbak vol is. Leeg de prullenbak en synchroniseer opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja nie mogła przenieść usuniętych elementów do kosza, ponieważ kosz jest pełny. Opróżnij kosz, a potem zsynchronizuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização não conseguiu mover os itens excluídos para a lixeira porque a lixeira está cheia. Esvazie a lixeira e sincronize novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于回收站已满，同步无法将已删除的项目移到回收站。请清空回收站，然后再次同步。"
          }
        }
      }
    },
