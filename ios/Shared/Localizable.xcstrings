          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wordt bij de volgende synchronisatie van deze iPhone en van je andere apparaten verwijderd. Het kan alleen op je pc worden bewerkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostanie usunięty z tego iPhone'a i z Twoich pozostałych urządzeń przy następnej synchronizacji. Można go edytować tylko na Twoim komputerze."
          }
        },
        "pt-BR" : {
