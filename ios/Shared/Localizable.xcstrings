        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrendeld · deze login vraagt altijd om het hoofdwachtwoord. Toon om te bekijken of te bewerken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zablokowane · ten login zawsze pyta o hasło główne. Pokaż, aby wyświetlić lub edytować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
