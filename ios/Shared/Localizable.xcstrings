          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit · bij aan helemaal geen netwerktoegang"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączone — brak jakiegokolwiek dostępu do sieci, gdy włączone"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado · nenhum acesso à rede quando ativado"
