    "syncPage.lostIntroFolder" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie das verlorene Gerät. Es wird aus der Synchronisierung entfernt, Ihre anderen Geräte wechseln zu einem NEUEN Synchronisierungspasswort, und das verlorene Gerät löscht seinen Tresor, falls es je wieder mit laufendem LocalGateKeys online geht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the lost device. It is removed from sync, your other devices move to a NEW sync password, and the lost device erases its vault if it ever goes online again with LocalGateKeys running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el dispositivo perdido. Se quita de la sincronización, tus otros dispositivos pasan a una contraseña de sincronización NUEVA y el dispositivo perdido borra su bóveda si alguna vez vuelve a conectarse con LocalGateKeys en ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez l’appareil perdu. Il est retiré de la synchronisation, vos autres appareils passent à un NOUVEAU mot de passe de synchronisation, et l’appareil perdu efface son coffre-fort s’il se reconnecte un jour avec LocalGateKeys en cours d’exécution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli il dispositivo perso. Viene rimosso dalla sincronizzazione, gli altri tuoi dispositivi passano a una NUOVA password di sincronizzazione e il dispositivo perso cancella la sua cassaforte se torna online con LocalGateKeys in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "紛失したデバイスを選んでください。そのデバイスは同期から削除され、ほかのデバイスは新しい同期パスワードに切り替わります。紛失したデバイスは、LocalGateKeysを実行した状態で再びオンラインになると保管庫を消去します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "분실한 기기를 선택하세요. 그 기기는 동기화에서 제거되고, 다른 기기는 새 동기화 비밀번호로 바뀌며, 분실한 기기는 LocalGateKeys가 실행 중인 상태로 다시 온라인이 되면 보관함을 지웁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies het verloren apparaat. Het wordt uit de synchronisatie verwijderd, uw andere apparaten krijgen een NIEUW synchronisatiewachtwoord en het verloren apparaat wist zijn kluis als het ooit weer online komt terwijl LocalGateKeys draait."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz zgubione urządzenie. Zostanie usunięte z synchronizacji, Twoje pozostałe urządzenia przejdą na NOWE hasło synchronizacji, a zgubione urządzenie wymaże swój sejf, jeśli kiedykolwiek połączy się z siecią przy uruchomionym LocalGateKeys."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o dispositivo perdido. Ele é removido da sincronização, seus outros dispositivos passam para uma NOVA senha de sincronização e o dispositivo perdido apaga o cofre se voltar a ficar online com o LocalGateKeys em execução."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择丢失的设备。它将从同步中移除，你的其他设备会改用新的同步密码；如果丢失的设备再次在运行 LocalGateKeys 的情况下联网，它会清除其保管库。"
          }
        }
      }
    },
