    "Suggestions are offered by domain, so a login saved for one site can also be offered on other pages of the same domain." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorschläge werden nach Domain angeboten, daher kann eine für eine Website gespeicherte Anmeldung auch auf anderen Seiten derselben Domain angeboten werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sugerencias se ofrecen por dominio, así que un inicio de sesión guardado para un sitio también puede ofrecerse en otras páginas del mismo dominio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suggerimenti vengono proposti per dominio, quindi un accesso salvato per un sito può essere proposto anche in altre pagine dello stesso dominio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "候補はドメイン単位で表示されるため、あるサイト用に保存したログインが、同じドメインの他のページにも表示されることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제안은 도메인 기준으로 제공되므로, 한 사이트용으로 저장한 로그인이 같은 도메인의 다른 페이지에도 제안될 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggesties worden per domein aangeboden, dus een login die voor één site is bewaard, kan ook op andere pagina's van hetzelfde domein worden aangeboden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sugestie są oferowane według domeny, więc login zapisany dla jednej witryny może być proponowany także na innych stronach tej samej domeny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As sugestões são oferecidas por domínio, então um login salvo para um site também pode ser oferecido em outras páginas do mesmo domínio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建议按域名提供，因此为某个网站保存的登录也可能在同一域名的其他页面中提供。"
          }
        }
      }
    },
    "Switch on the Safari extension and AutoFill to fill logins and passkeys." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie die Safari-Erweiterung und AutoFill, um Anmeldungen und Passkeys auszufüllen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa la extensión de Safari y el autorrelleno para rellenar inicios de sesión y claves de acceso."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva l'estensione di Safari e la compilazione automatica per compilare accessi e passkey."
