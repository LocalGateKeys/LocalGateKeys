    "sync.anotherDeviceChangedTheSync" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderes Gerät hat den Synchronisierungsordner im selben Moment geändert. Versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another device changed the sync folder at the same moment. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otro dispositivo cambió la carpeta de sincronización al mismo tiempo. Inténtalo de nuevo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro dispositivo ha modificato la cartella di sincronizzazione nello stesso momento. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
