    "Bring passwords in from another password manager or a phone backup, or write a copy of this vault to a file. Nothing leaves this Mac unless you move the file." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holen Sie Passwörter aus einem anderen Passwortmanager oder einem Telefon-Backup herein oder schreiben Sie eine Kopie dieses Tresors in eine Datei. Nichts verlässt diesen Mac, solange Sie die Datei nicht verschieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trae contraseñas de otro gestor de contraseñas o de una copia de seguridad del teléfono, o escribe una copia de esta bóveda en un archivo. Nada sale de este Mac a menos que muevas el archivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa password da un altro gestore di password o da un backup del telefono, oppure scrivi una copia di questa cassaforte in un file. Nulla lascia questo Mac a meno che tu non sposti il file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のパスワードマネージャやiPhoneのバックアップからパスワードを取り込んだり、この保管庫のコピーをファイルに書き出したりできます。ファイルを移動しない限り、このMacの外には何も出ません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 비밀번호 관리자나 휴대폰 백업에서 비밀번호를 가져오거나, 이 보관함의 사본을 파일로 기록합니다. 파일을 옮기지 않는 한 이 Mac 밖으로 나가는 것은 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haal wachtwoorden binnen uit een andere wachtwoordmanager of een telefoonback-up, of schrijf een kopie van deze kluis naar een bestand. Er verlaat niets deze Mac, tenzij je het bestand verplaatst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenieś hasła z innego menedżera haseł lub kopii zapasowej z telefonu albo zapisz kopię tego sejfu do pliku. Nic nie opuszcza tego Maka, jeśli nie przeniesiesz pliku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traga senhas de outro gerenciador de senhas ou de um backup do celular, ou grave uma cópia deste cofre em um arquivo. Nada sai deste Mac a menos que você mova o arquivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从其他密码管理器或手机备份导入密码，或将此保管库的副本写入文件。除非您移动该文件，否则不会有任何内容离开这台 Mac。"
          }
        }
      }
    },
