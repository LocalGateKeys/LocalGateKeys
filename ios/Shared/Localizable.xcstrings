          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro dei tuoi dispositivi fa parte di questa raccolta condivisa. Gestisci la condivisione su quel dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いの別のデバイスがこの共有コレクションに参加しています。共有はそのデバイスで管理してください。"
