            "state" : "translated",
            "value" : "이 iPad의 보관함만 삭제합니다. PC와 동기화 폴더는 변경되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert alleen de kluis op deze iPad. Je pc en de synchronisatiemap blijven ongewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa sejf tylko na tym iPadzie. Twój komputer i folder synchronizacji nie zostają zmienione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
