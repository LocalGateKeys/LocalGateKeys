          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está danificado ou não pôde ser verificado e foi ignorado. Nada foi alterado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@已损坏或无法验证，已被跳过。没有任何更改。"
          }
        }
      }
    },
    "sync.isNowUsingAnOlder" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verwendet jetzt eine ältere Kopie seines Tresors. Wenn dort niemand ein Backup wiederhergestellt hat, prüfen Sie dieses Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is now using an older copy of its vault. If nobody restored a backup there, check that device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ahora usa una copia más antigua de su bóveda. Si nadie restauró una copia de seguridad allí, revisa ese dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ora usa una copia più vecchia della sua cassaforte. Se nessuno ha ripristinato un backup lì, controlla quel dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は、保管庫の古いコピーを使うようになりました。そこでバックアップを復元した人がいない場合は、そのデバイスを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 이제 보관함의 이전 사본을 사용하고 있습니다. 아무도 그곳에서 백업을 복원하지 않았다면 해당 기기를 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gebruikt nu een oudere kopie van de kluis. Als daar niemand een back-up heeft hersteld, controleer dan dat apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ używa teraz starszej kopii swojego sejfu. Jeśli nikt tam nie przywracał kopii zapasowej, sprawdź to urządzenie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ agora usa uma cópia mais antiga do cofre dele. Se ninguém restaurou um backup lá, verifique esse dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@现在使用的是其保管库的较旧副本。如果那里没有人还原过备份，请检查该设备。"
          }
        }
      }
    },
