    "collectionShare.rejoinRequired.mac" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac kann die geteilte Sammlung nicht mehr öffnen. Fragen Sie die Person, die sie geteilt hat, ob Sie entfernt wurden, und treten Sie dann erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac can no longer open the shared collection. Ask the person who shared it whether you were removed, then join again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac ya no puede abrir la colección compartida. Pregunta a quien la compartió si te quitó y luego vuelve a unirte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac ne peut plus ouvrir la collection partagée. Demandez à la personne qui l’a partagée si vous avez été retiré, puis rejoignez-la à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Mac non riesce più ad aprire la raccolta condivisa. Chiedi a chi l'ha condivisa se sei stato rimosso, poi unisciti di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacでは共有コレクションを開けなくなりました。共有した人に削除されたかどうかを確認してから、もう一度参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 더 이상 공유 컬렉션을 열 수 없습니다. 공유한 사람에게 제거되었는지 확인한 뒤 다시 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze Mac kan de gedeelde verzameling niet meer openen. Vraag degene die hem deelde of je bent verwijderd en doe daarna opnieuw mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten Mac nie może już otworzyć udostępnionej kolekcji. Zapytaj osobę, która ją udostępniła, czy Cię usunęła, a potem dołącz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac não consegue mais abrir a coleção compartilhada. Pergunte a quem a compartilhou se você foi removido e depois entre de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 无法再打开此共享集合。请询问共享者您是否已被移出，然后重新加入。"
          }
        }
      }
    },
