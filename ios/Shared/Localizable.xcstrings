            "state" : "translated",
            "value" : "コレクションの名前を入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컬렉션 이름을 입력하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer een naam in voor de verzameling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz nazwę kolekcji."
          }
        },
        "pt-BR" : {
