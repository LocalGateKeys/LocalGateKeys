    "collectionShare.linkedMember" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderes Ihrer Geräte ist in dieser geteilten Sammlung. Verwalten Sie die Freigabe auf jenem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
