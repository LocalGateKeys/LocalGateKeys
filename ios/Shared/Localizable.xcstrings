    "Automatic emptying is off, so entries stay encrypted here until you delete them. Older backups may retain copies." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das automatische Leeren ist ausgeschaltet, daher bleiben Einträge hier verschlüsselt, bis Sie sie löschen. Ältere Backups können Kopien enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vaciado automático está desactivado, así que las entradas permanecen cifradas aquí hasta que las elimines. Las copias de seguridad más antiguas pueden conservar copias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le vidage automatique est désactivé ; les éléments restent donc chiffrés ici jusqu’à ce que vous les supprimiez. Les anciennes sauvegardes peuvent en conserver des copies."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo svuotamento automatico è disattivato, quindi le voci restano cifrate qui finché non le elimini. I backup più vecchi possono conservarne delle copie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動で空にする設定がオフのため、エントリは削除するまでここに暗号化されたまま残ります。古いバックアップにコピーが残っている場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 비우기가 꺼져 있어 삭제하기 전까지 항목은 암호화된 상태로 여기에 남아 있습니다. 이전 백업에 사본이 남아 있을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch legen staat uit, dus items blijven hier versleuteld totdat je ze verwijdert. Oudere back-ups kunnen kopieën bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatyczne opróżnianie jest wyłączone, więc wpisy pozostają tu zaszyfrowane, dopóki ich nie usuniesz. Starsze kopie zapasowe mogą zachować kopie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O esvaziamento automático está desativado, então as entradas permanecem criptografadas aqui até você excluí-las. Backups mais antigos podem reter cópias."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动清空已关闭，因此条目会一直加密保存在这里，直到您将其删除。较旧的备份可能保留副本。"
          }
        }
      }
    },
