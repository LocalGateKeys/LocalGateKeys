        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplanowane kopie zapasowe są wstrzymane. Wpisz hasło kopii zapasowej ostatnio ustawione na tym Macu albo zresetuj je frazą odzyskiwania."
          }
        },
