            "value" : "이 iPhone의 최근 삭제됨으로 이동하며 다음 동기화 때 다른 기기에서 제거됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het gaat naar Onlangs verwijderd op deze iPhone en wordt bij de volgende synchronisatie van je andere apparaten verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trafia do Ostatnio usuniętych na tym iPhonie i zostaje usunięty z Twoich pozostałych urządzeń przy następnej synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele vai para Excluídos recentemente neste iPhone e é removido dos seus outros dispositivos na próxima sincronização."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它会移至这台 iPhone 的“最近删除”，并在下次同步时从您的其他设备上移除。"
          }
        }
      }
    },
