    "sync.twoDevicesChangedTheSync" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Geräte haben das Synchronisierungspasswort gleichzeitig geändert. Die Synchronisierung wurde angehalten. Treten Sie dem Ordner mit dem neuesten Synchronisierungspasswort erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two devices changed the sync password at the same time. Sync stopped. Join the folder again with the newest sync password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos dispositivos cambiaron la contraseña de sincronización al mismo tiempo. La sincronización se detuvo. Vuelve a unirte a la carpeta con la contraseña de sincronización más reciente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Due dispositivi hanno cambiato la password di sincronizzazione nello stesso momento. Sincronizzazione interrotta. Unisciti di nuovo alla cartella con la password di sincronizzazione più recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2台のデバイスが同時に同期パスワードを変更しました。同期を停止しました。最新の同期パスワードで、もう一度フォルダーに参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 기기가 동시에 동기화 비밀번호를 변경했습니다. 동기화가 중지되었습니다. 최신 동기화 비밀번호로 폴더에 다시 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twee apparaten hebben tegelijk het synchronisatiewachtwoord gewijzigd. Synchronisatie gestopt. Sluit opnieuw aan bij de map met het nieuwste synchronisatiewachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwa urządzenia zmieniły hasło synchronizacji w tym samym czasie. Synchronizacja zatrzymana. Dołącz do folderu ponownie z najnowszym hasłem synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dois dispositivos alteraram a senha de sincronização ao mesmo tempo. A sincronização parou. Entre na pasta novamente com a senha de sincronização mais recente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两台设备同时更改了同步密码。同步已停止。请使用最新的同步密码重新加入该文件夹。"
          }
        }
      }
    },
    "sync.unknownFilesInTheSync" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unbekannte Dateien im Synchronisierungsordner wurden ignoriert (%@). Cloud-Apps erstellen manchmal solche Kopien; Sie können sie löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unknown files in the sync folder were ignored (%@). Cloud apps sometimes make copies like these; you can delete them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ignoraron archivos desconocidos de la carpeta de sincronización (%@). Las aplicaciones de nube a veces crean copias como estas; puedes eliminarlos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file sconosciuti nella cartella di sincronizzazione sono stati ignorati (%@). A volte le app cloud creano copie di questo tipo; puoi eliminarle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期フォルダー内の不明なファイルは無視されました(%@)。クラウドアプリが、このようなコピーを作ることがあります。削除して問題ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화 폴더의 알 수 없는 파일(%@)은 무시되었습니다. 클라우드 앱이 가끔 이런 사본을 만들며, 삭제해도 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onbekende bestanden in de synchronisatiemap zijn genegeerd (%@). Cloud-apps maken soms zulke kopieën; je kunt ze verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieznane pliki w folderze synchronizacji zostały zignorowane (%@). Aplikacje chmurowe czasem tworzą takie kopie; możesz je usunąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos desconhecidos na pasta de sincronização foram ignorados (%@). Apps de nuvem às vezes criam cópias como essas; você pode excluí-las."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已忽略同步文件夹中的未知文件（%@）。云应用有时会生成这样的副本；您可以将其删除。"
          }
        }
      }
    },
    "sync.updateLocalgatekeysOnThisPc" : {
