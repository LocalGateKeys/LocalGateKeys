            "value" : "De Safari-extensie staat aan. Schakel automatisch invullen in om in apps en op andere plaatsen in te vullen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozszerzenie Safari jest włączone. Włącz AutoFill, aby uzupełniać dane w aplikacjach i innych miejscach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A extensão do Safari está ativada. Ative o preenchimento automático para preencher em apps e outros lugares."
