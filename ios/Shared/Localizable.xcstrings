        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ potrà aprire subito il tuo backup più recente, senza periodo di attesa. Fallo solo dopo aver parlato di persona con %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は待機期間なしで、最新のバックアップをすぐに開けるようになります。%1$@ 本人と直接話してからにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) 대기 기간 없이 최신 백업을 바로 열 수 있게 됩니다. %1$@와(과) 직접 이야기한 뒤에만 허용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kan je nieuwste back-up meteen openen, zonder wachttijd. Doe dit alleen nadat je zelf met %1$@ hebt gesproken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ od razu otworzy Twoją najnowszą kopię zapasową, bez okresu oczekiwania. Zrób to tylko po osobistej rozmowie z %1$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ poderá abrir seu backup mais recente na hora, sem período de espera. Faça isso só depois de falar pessoalmente com %1$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 将能立即打开你最新的备份，无需等待期。请先亲自与 %1$@ 沟通后再这样做。"
          }
        }
      }
    },
    "%@ will be deleted from this folder. The newest %lld backups are kept." : {
