            "state" : "translated",
            "value" : "このiPhoneはメンバーリストから外されました。もう一度フォルダに参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone이 구성원 목록에서 제외되었습니다. 폴더에 다시 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze iPhone is uit de ledenlijst gehaald. Voeg de map opnieuw toe."
          }
        },
