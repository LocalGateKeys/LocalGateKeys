    "collectionShare.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle, die beitreten, behalten ihren eigenen Tresor und ihren eigenen Schlüssel. Nur die Einträge dieser Sammlung gehen über den geteilten Ordner; Ihre anderen Einträge bleiben privat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everyone who joins keeps their own vault and their own key. Only the items in this collection go through the shared folder; your other items stay private."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada persona que se une conserva su propia bóveda y su propia clave. Solo los elementos de esta colección pasan por la carpeta compartida; tus demás elementos siguen siendo privados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque personne qui rejoint garde son propre coffre et sa propre clé. Seuls les éléments de cette collection passent par le dossier partagé ; vos autres éléments restent privés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chi si unisce mantiene la propria cassaforte e la propria chiave. Solo gli elementi di questa raccolta passano dalla cartella condivisa; gli altri tuoi elementi restano privati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参加する人はそれぞれ自分の保管庫と自分のキーを持ちます。共有フォルダーを通るのはこのコレクションの項目だけで、ほかの項目は非公開のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참여하는 사람은 각자 자기 보관함과 자기 키를 유지합니다. 공유 폴더로는 이 컬렉션의 항목만 오가며, 나머지 항목은 비공개로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen die meedoet, houdt een eigen kluis en een eigen sleutel. Alleen de items in deze verzameling gaan via de gedeelde map; je andere items blijven privé."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy, kto dołącza, ma własny sejf i własny klucz. Przez udostępniony folder przechodzą tylko elementy tej kolekcji; Twoje pozostałe elementy pozostają prywatne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada pessoa que entra mantém o próprio cofre e a própria chave. Só os itens desta coleção passam pela pasta compartilhada; seus outros itens continuam privados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个加入的人都保留自己的保管库和自己的密钥。只有此集合中的项目会经过共享文件夹；您的其他项目保持私密。"
          }
        }
      }
    },
    "collectionShare.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilen Sie diese Sammlung mit Familie oder Team über einen Ordner, den alle erreichen, etwa einen geteilten iCloud Drive-Ordner. Jede Person tritt mit dem Freigabepasswort bei. Dieses Passwort schützt die Einträge im Ordner, geben Sie es also nur Personen, die Sie einladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share this collection with family or a team through a folder you all can reach, such as a shared iCloud Drive folder. Each person joins with the share password. That password protects the items in the folder, so give it only to people you invite."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte esta colección con tu familia o tu equipo mediante una carpeta a la que todos tengan acceso, como una carpeta compartida de iCloud Drive. Cada persona se une con la contraseña de la colección compartida. Esa contraseña protege los elementos de la carpeta, así que dásela solo a quien invites."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez cette collection avec votre famille ou une équipe grâce à un dossier accessible à tous, comme un dossier iCloud Drive partagé. Chaque personne rejoint avec le mot de passe de partage. Ce mot de passe protège les éléments du dossier : donnez-le seulement aux personnes que vous invitez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi questa raccolta con la famiglia o un team tramite una cartella a cui tutti accedete, come una cartella iCloud Drive condivisa. Ogni persona si unisce con la password di condivisione. Questa password protegge gli elementi nella cartella, quindi dalla solo a chi inviti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有iCloud Driveフォルダーなど、全員がアクセスできるフォルダーを通じて、このコレクションを家族やチームと共有します。各自が共有パスワードで参加します。このパスワードはフォルダー内の項目を保護するため、招待する人にだけ伝えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 iCloud Drive 폴더처럼 모두가 접근할 수 있는 폴더를 통해 이 컬렉션을 가족이나 팀과 공유하세요. 각자 공유 비밀번호로 참여합니다. 이 비밀번호가 폴더 안의 항목을 보호하므로 초대한 사람에게만 알려 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deel deze verzameling met familie of een team via een map die iedereen kan bereiken, zoals een gedeelde iCloud Drive-map. Iedereen doet mee met het deelwachtwoord. Dat wachtwoord beschermt de items in de map, dus geef het alleen aan mensen die je uitnodigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnij tę kolekcję rodzinie lub zespołowi przez folder, do którego wszyscy mają dostęp, na przykład udostępniony folder iCloud Drive. Każda osoba dołącza za pomocą hasła udostępniania. To hasło chroni elementy w folderze, więc podaj je tylko osobom, które zapraszasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe esta coleção com a família ou uma equipe por meio de uma pasta que todos acessam, como uma pasta compartilhada do iCloud Drive. Cada pessoa entra com a senha de compartilhamento. Essa senha protege os itens da pasta, então passe-a só para quem você convidar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过所有人都能访问的文件夹（例如共享的 iCloud Drive 文件夹）与家人或团队共享此集合。每个人都使用共享密码加入。此密码保护文件夹中的项目，因此只告诉您邀请的人。"
          }
        }
      }
    },
