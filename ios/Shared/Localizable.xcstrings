    "Scheduled backups are paused. Enter the backup password last set on this Mac, or reset it with the recovery phrase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geplante Backups sind pausiert. Geben Sie das zuletzt auf diesem Mac festgelegte Backup-Passwort ein oder setzen Sie es mit der Wiederherstellungsphrase zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias programadas están en pausa. Escribe la última contraseña de copia de seguridad establecida en este Mac o restablécela con la frase de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes planifiées sont en pause. Saisissez le dernier mot de passe de sauvegarde défini sur ce Mac, ou réinitialisez-le avec la phrase de récupération."
          }
        },
        "it" : {
          "stringUnit" : {
