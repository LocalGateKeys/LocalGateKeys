        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odczytać nazwy %@ w pliku klucza; jest pokazywana jako Urządzenie bez nazwy. Synchronizacja trwa dalej."
