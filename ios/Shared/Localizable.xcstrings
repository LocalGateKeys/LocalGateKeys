        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 보관함은 다른 PC에서 동기화용으로 설정되었습니다. 이 PC에서 폴더에 다시 참여하거나 동기화를 초기화하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze kluis is op een andere pc voor synchronisatie ingesteld. Sluit op deze pc opnieuw aan bij de map, of reset de synchronisatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten sejf skonfigurowano do synchronizacji na innym komputerze. Dołącz do folderu ponownie na tym komputerze lub zresetuj synchronizację."
