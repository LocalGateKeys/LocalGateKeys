    "sync.thisVaultWasSetUp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Tresor wurde auf einem anderen PC für die Synchronisierung eingerichtet. Treten Sie dem Ordner auf diesem PC erneut bei oder setzen Sie die Synchronisierung zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This vault was set up for sync on another PC. Join the folder again on this PC, or reset sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta bóveda se configuró para la sincronización en otro PC. Vuelve a unirte a la carpeta en este PC o restablece la sincronización."
