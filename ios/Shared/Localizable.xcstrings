    "sync.thisPcCouldNotWrite" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser PC konnte seine Synchronisierungsdatei nicht schreiben. Prüfen Sie, ob der Ordner verfügbar und nicht schreibgeschützt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This PC could not write its sync file. Check that the folder is available and not read-only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PC no pudo escribir su archivo de sincronización. Comprueba que la carpeta esté disponible y no sea de solo lectura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo PC non è riuscito a scrivere il suo file di sincronizzazione. Controlla che la cartella sia disponibile e non di sola lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このPCは同期ファイルを書き込めませんでした。フォルダーが利用可能で、読み取り専用ではないか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 PC가 동기화 파일을 쓸 수 없습니다. 폴더를 사용할 수 있고 읽기 전용이 아닌지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze pc kon zijn synchronisatiebestand niet schrijven. Controleer of de map beschikbaar is en niet alleen-lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten komputer nie mógł zapisać swojego pliku synchronizacji. Sprawdź, czy folder jest dostępny i nie jest tylko do odczytu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PC não conseguiu gravar o arquivo de sincronização dele. Verifique se a pasta está disponível e não é somente leitura."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台电脑无法写入它的同步文件。请检查该文件夹是否可用且不是只读的。"
          }
        }
      }
    },
