            "state" : "translated",
            "value" : "%@ envió datos firmados para otro dispositivo; se omitieron."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha inviato dati firmati per un altro dispositivo; sono stati saltati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
