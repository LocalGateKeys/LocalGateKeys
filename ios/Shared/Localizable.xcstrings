    "Other browsers aren't supported on the Mac yet. Use Safari, or AutoFill in apps that support it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Browser werden auf dem Mac noch nicht unterstützt. Verwenden Sie Safari oder AutoFill in Apps, die es unterstützen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los otros navegadores aún no se admiten en el Mac. Usa Safari o el autorrelleno en las apps compatibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autres navigateurs ne sont pas encore pris en charge sur le Mac. Utilisez Safari, ou le remplissage automatique dans les apps qui le prennent en charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli altri browser non sono ancora supportati sul Mac. Usa Safari, oppure la compilazione automatica nelle app che la supportano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その他のブラウザはMacではまだサポートされていません。Safariを使うか、対応するAppでAutoFillを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 브라우저는 아직 Mac에서 지원되지 않습니다. Safari를 사용하거나 지원하는 앱에서 자동 완성을 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere browsers worden op de Mac nog niet ondersteund. Gebruik Safari, of automatisch invullen in apps die dat ondersteunen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inne przeglądarki nie są jeszcze obsługiwane na Maku. Użyj Safari lub AutoFill w aplikacjach, które go obsługują."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outros navegadores ainda não são compatíveis no Mac. Use o Safari ou o preenchimento automático em apps compatíveis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 上尚不支持其他浏览器。请使用 Safari，或在支持自动填充的 App 中使用自动填充。"
          }
        }
      }
    },
    "Otherwise choose Decline." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie andernfalls „Ablehnen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De lo contrario, elige Rechazar."
