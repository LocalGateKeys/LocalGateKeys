    "You start each check. It sends 5 characters of a hash, never the password." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie starten jede Prüfung. Sie sendet 5 Zeichen eines Hashs, nie das Passwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú inicias cada comprobación. Envía 5 caracteres de un hash, nunca la contraseña."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvii tu ogni controllo. Invia 5 caratteri di un hash, mai la password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認は毎回あなたが開始します。送信されるのはハッシュの5文字だけで、パスワードは送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인은 직접 시작합니다. 해시의 5자만 보내며 비밀번호는 절대 보내지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je start elke controle zelf. Er worden 5 tekens van een hash verstuurd, nooit het wachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każde sprawdzenie uruchamiasz sam. Wysyła 5 znaków skrótu, nigdy samo hasło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você inicia cada verificação. Ela envia 5 caracteres de um hash, nunca a senha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次检查由您启动。它发送哈希的 5 个字符，绝不发送密码。"
          }
        }
      }
    },
    "You will no longer be able to sign in to this website with it." : {
