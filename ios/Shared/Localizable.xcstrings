          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con %@. Comprueba que el PC esté en esta Wi-Fi y muestre su código."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile connettersi a %@. Controlla che il PC sia su questo Wi-Fi e mostri il suo codice."
