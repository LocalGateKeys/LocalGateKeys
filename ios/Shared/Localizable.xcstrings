    "At least %lld characters. You'll need this password to restore the backup; it can't be recovered." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens %lld Zeichen. Sie brauchen dieses Passwort, um das Backup wiederherzustellen; es kann nicht wiederhergestellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al menos %lld caracteres. Necesitarás esta contraseña para restaurar la copia de seguridad; no se puede recuperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au moins %lld caractères. Vous aurez besoin de ce mot de passe pour restaurer la sauvegarde ; il ne peut pas être récupéré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almeno %lld caratteri. Ti servirà questa password per ripristinare il backup; non può essere recuperata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld文字以上。バックアップの復元にこのパスワードが必要です。復旧することはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld자 이상. 백업을 복원할 때 이 비밀번호가 필요하며 복구할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minstens %lld tekens. Je hebt dit wachtwoord nodig om de back-up te herstellen; het kan niet worden hersteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co najmniej %lld znaków. Tego hasła będziesz potrzebować do przywrócenia kopii zapasowej; nie można go odzyskać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelo menos %lld caracteres. Você precisará desta senha para restaurar o backup; ela não pode ser recuperada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少 %lld 个字符。还原备份时需要此密码；它无法找回。"
          }
        }
      }
    },
    "At least 12 characters with a Strong rating. Write this password down: your other devices join this folder with it. It is never stored." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens 12 Zeichen mit der Bewertung Stark. Notieren Sie dieses Passwort: Ihre anderen Geräte treten diesem Ordner damit bei. Es wird nie gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al menos 12 caracteres con valoración Fuerte. Anota esta contraseña: tus otros dispositivos se unen a esta carpeta con ella. Nunca se guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au moins 12 caractères avec une évaluation Fort. Notez ce mot de passe : vos autres appareils rejoignent ce dossier avec lui. Il n’est jamais enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almeno 12 caratteri con valutazione Forte. Annota questa password: gli altri tuoi dispositivi si uniscono a questa cartella con essa. Non viene mai salvata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12文字以上で、強度が「強い」であること。このパスワードは書き留めてください。ほかのデバイスはこれを使ってこのフォルダーに参加します。保存されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강함 등급의 12자 이상이어야 합니다. 이 비밀번호를 적어 두세요. 다른 기기가 이 비밀번호로 이 폴더에 참여합니다. 이 비밀번호는 저장되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minstens 12 tekens met de beoordeling Sterk. Schrijf dit wachtwoord op: je andere apparaten voegen zich ermee bij deze map. Het wordt nooit opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co najmniej 12 znaków z oceną Mocne. Zapisz to hasło: Twoje pozostałe urządzenia dołączają do tego folderu za jego pomocą. Nigdy nie jest zapisywane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelo menos 12 caracteres com classificação Forte. Anote esta senha: seus outros dispositivos entram nesta pasta com ela. Ela nunca é armazenada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少 12 个字符，且强度为“强”。请记下此密码：您的其他设备需要用它加入此文件夹。它不会被保存。"
          }
        }
      }
    },
