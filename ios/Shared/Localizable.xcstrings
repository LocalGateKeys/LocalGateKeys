    "collectionShare.joinIntro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie den geteilten Ordner, auf den Sie Zugriff erhalten haben (zum Beispiel einen geteilten iCloud Drive-Ordner), und geben Sie dann das Freigabepasswort ein, das man Ihnen genannt hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the shared folder you were given access to (for example a shared iCloud Drive folder), then type the share password you were told."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la carpeta compartida a la que te dieron acceso (por ejemplo, una carpeta compartida de iCloud Drive) y escribe la contraseña que te dijeron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le dossier partagé auquel on vous a donné accès (par exemple un dossier iCloud Drive partagé), puis saisissez le mot de passe de partage qu’on vous a communiqué."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli la cartella condivisa a cui ti hanno dato accesso (ad esempio una cartella iCloud Drive condivisa), poi digita la password di condivisione che ti hanno comunicato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセス権をもらった共有フォルダー（共有iCloud Driveフォルダーなど）を選び、教えられた共有パスワードを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "접근 권한을 받은 공유 폴더(예: 공유 iCloud Drive 폴더)를 선택한 다음, 전달받은 공유 비밀번호를 입력하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de gedeelde map waartoe je toegang hebt gekregen (bijvoorbeeld een gedeelde iCloud Drive-map) en typ daarna het deelwachtwoord dat je is verteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz udostępniony folder, do którego masz dostęp (na przykład udostępniony folder iCloud Drive), a potem wpisz hasło udostępniania, które Ci przekazano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a pasta compartilhada à qual você recebeu acesso (por exemplo, uma pasta compartilhada do iCloud Drive) e digite a senha de compartilhamento que passaram para você."
          }
        },
        "zh-Hans" : {
