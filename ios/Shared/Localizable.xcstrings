    "sync.thisPcMustJoinSync" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser PC muss der Synchronisierung erneut beitreten (er hat eine Passwortänderung verpasst oder wurde entfernt). Treten Sie dem Ordner mit dem aktuellen Synchronisierungspasswort erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This PC must join sync again (it missed a password change, or it was removed). Join the folder again with the current sync password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PC debe volver a unirse a la sincronización (se perdió un cambio de contraseña, o fue quitado). Vuelve a unirte a la carpeta con la contraseña de sincronización actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce PC doit rejoindre de nouveau la synchronisation (il a manqué un changement de mot de passe, ou il a été retiré). Rejoignez de nouveau le dossier avec le mot de passe de synchronisation actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo PC deve unirsi di nuovo alla sincronizzazione (ha perso un cambio di password, oppure è stato rimosso). Unisciti di nuovo alla cartella con la password di sincronizzazione attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このPCは、もう一度同期に参加する必要があります(パスワードの変更を受け取れなかったか、削除されました)。現在の同期パスワードで、もう一度フォルダーに参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 PC는 동기화에 다시 참여해야 합니다(비밀번호 변경을 놓쳤거나 제거되었습니다). 현재 동기화 비밀번호로 폴더에 다시 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze pc moet opnieuw aansluiten bij de synchronisatie (hij heeft een wachtwoordwijziging gemist, of is verwijderd). Sluit opnieuw aan bij de map met het huidige synchronisatiewachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten komputer musi ponownie dołączyć do synchronizacji (przegapił zmianę hasła lub został usunięty). Dołącz do folderu ponownie z bieżącym hasłem synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PC precisa entrar na sincronização novamente (ele perdeu uma alteração de senha ou foi removido). Entre na pasta novamente com a senha de sincronização atual."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台电脑必须重新加入同步（它错过了一次密码更改，或已被移除）。请使用当前的同步密码重新加入该文件夹。"
          }
        }
      }
    },
