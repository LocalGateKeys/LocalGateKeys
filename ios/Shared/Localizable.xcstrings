    "collectionShare.approveText" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Personen in „%1$@“ hereinlassen: %2$@? Ihre Geräte synchronisieren dann jeden Eintrag dieser Sammlung, und ihre Änderungen zählen. Geben Sie nur Namen frei, die Sie kennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let these people into “%1$@”: %2$@? Their devices then sync every item in this collection, and their edits count. Only approve names you recognise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dejar entrar a estas personas en «%1$@»: %2$@? Sus dispositivos sincronizarán entonces cada elemento de esta colección, y sus cambios contarán. Aprueba solo los nombres que reconozcas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laisser entrer ces personnes dans « %1$@ » : %2$@ ? Leurs appareils synchroniseront alors chaque élément de cette collection, et leurs modifications compteront. N’approuvez que les noms que vous reconnaissez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Far entrare queste persone in «%1$@»: %2$@? I loro dispositivi sincronizzeranno ogni elemento di questa raccolta e le loro modifiche conteranno. Approva solo i nomi che riconosci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の人を「%1$@」に参加させますか: %2$@？ 相手のデバイスがこのコレクションのすべての項目を同期するようになり、相手の編集も反映されます。知っている名前だけを承認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 사람들을 “%1$@”에 참여시킬까요: %2$@? 이들의 기기가 이 컬렉션의 모든 항목을 동기화하고, 이들의 편집도 반영됩니다. 아는 이름만 승인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze mensen toelaten tot “%1$@”: %2$@? Hun apparaten synchroniseren dan elk item in deze verzameling, en hun wijzigingen tellen mee. Keur alleen namen goed die je herkent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpuścić te osoby do „%1$@”: %2$@? Ich urządzenia będą wtedy synchronizować każdy element tej kolekcji, a ich zmiany będą się liczyć. Zatwierdzaj tylko imiona, które rozpoznajesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liberar a entrada destas pessoas em “%1$@”: %2$@? Os dispositivos delas passam a sincronizar cada item desta coleção, e as edições delas passam a valer. Aprove só nomes que você reconhece."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许这些人加入“%1$@”：%2$@？之后他们的设备会同步此集合中的每个项目，他们的编辑也会生效。只批准您认识的名字。"
          }
        }
      }
    },
