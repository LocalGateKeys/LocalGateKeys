          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IBAN 会去除空格后检查并存储。"
          }
        }
      }
    },
    "An OpenSSH line (ssh-ed25519 AAAA…). The fingerprint is worked out from it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine OpenSSH-Zeile (ssh-ed25519 AAAA…). Der Fingerabdruck wird daraus berechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una línea OpenSSH (ssh-ed25519 AAAA…). La huella se calcula a partir de ella."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una riga OpenSSH (ssh-ed25519 AAAA…). L'impronta viene calcolata da essa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenSSHの行(ssh-ed25519 AAAA…)。フィンガープリントはそこから算出されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenSSH 한 줄(ssh-ed25519 AAAA…)입니다. 지문은 이 값에서 계산됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een OpenSSH-regel (ssh-ed25519 AAAA…). De vingerafdruk wordt eruit berekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiersz OpenSSH (ssh-ed25519 AAAA…). Odcisk jest z niego obliczany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma linha OpenSSH (ssh-ed25519 AAAA…). A impressão digital é calculada a partir dela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一行 OpenSSH 密钥（ssh-ed25519 AAAA…）。指纹将由它计算得出。"
