    "New logins have a generated password and the tag needs-password: change it to your real one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Anmeldungen haben ein generiertes Passwort und das Tag „needs-password“: Ändern Sie es in Ihr echtes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los inicios de sesión nuevos tienen una contraseña generada y la etiqueta needs-password: cámbiala por la real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux identifiants ont un mot de passe généré et l’étiquette needs-password : remplacez-le par votre vrai mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nuovi accessi hanno una password generata e il tag needs-password: cambiala con quella vera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいログインには、生成されたパスワードとタグ「needs-password」が付いています。本物のパスワードに変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 로그인에는 생성된 비밀번호와 needs-password 태그가 지정됩니다. 실제 비밀번호로 변경하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe logins hebben een gegenereerd wachtwoord en de tag needs-password: wijzig het in je echte wachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nowe loginy mają wygenerowane hasło i tag needs-password: zmień je na swoje prawdziwe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os novos logins têm uma senha gerada e a tag needs-password: altere-a para a sua senha real."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新登录带有生成的密码和 needs-password 标签：请将其改为您的真实密码。"
          }
        }
      }
    },
