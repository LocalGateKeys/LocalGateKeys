    "After filling a login that has a 2FA code, the current code is copied so you can paste it on the next screen." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Ausfüllen einer Anmeldung mit 2FA-Code wird der aktuelle Code kopiert, damit Sie ihn auf dem nächsten Bildschirm einfügen können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras rellenar un inicio de sesión que tiene código 2FA, se copia el código actual para que puedas pegarlo en la siguiente pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après le remplissage d’un identifiant qui a un code 2FA, le code actuel est copié pour que vous puissiez le coller à l’écran suivant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver compilato un accesso che ha un codice 2FA, il codice attuale viene copiato così puoi incollarlo nella schermata successiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2FAコードのあるログインを入力したあと、現在のコードをコピーするので、次の画面でそのまま貼り付けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2FA 코드가 있는 로그인을 채운 뒤 현재 코드가 복사되어, 다음 화면에서 바로 붙여넣을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na het invullen van een login met een 2FA-code wordt de huidige code gekopieerd, zodat je hem op het volgende scherm kunt plakken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po wypełnieniu loginu, który ma kod 2FA, bieżący kod jest kopiowany, aby można go było wkleić na następnym ekranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de preencher um login que tem código 2FA, o código atual é copiado para você colar na tela seguinte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填充带有 2FA 验证码的登录信息后，会复制当前验证码，方便你在下一个屏幕中粘贴。"
          }
        }
      }
    },
