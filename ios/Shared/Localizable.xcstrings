    "This code does not expire: anyone who scans or photographs it keeps the Wi-Fi password. Change the Wi-Fi password to take it back." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Code läuft nicht ab: Wer ihn scannt oder fotografiert, behält das WLAN-Passwort. Ändere das WLAN-Passwort, um es zurückzunehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código no caduca: quien lo escanee o fotografíe conserva la contraseña de la Wi-Fi. Cambia la contraseña de la Wi-Fi para retirarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce code n'expire pas : toute personne qui le scanne ou le photographie garde le mot de passe Wi-Fi. Changez le mot de passe Wi-Fi pour le reprendre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo codice non scade: chiunque lo scansioni o lo fotografi conserva la password del Wi-Fi. Cambia la password del Wi-Fi per revocarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコードに有効期限はありません。スキャンまたは撮影した人は Wi-Fi パスワードを保持します。取り消すには Wi-Fi パスワードを変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 코드는 만료되지 않습니다. 스캔하거나 사진을 찍은 사람은 Wi-Fi 비밀번호를 계속 알게 됩니다. 되돌리려면 Wi-Fi 비밀번호를 변경하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze code verloopt niet: wie hem scant of fotografeert, houdt het wifiwachtwoord. Wijzig het wifiwachtwoord om het in te trekken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten kod nie wygasa: każdy, kto go zeskanuje lub sfotografuje, zachowa hasło Wi-Fi. Zmień hasło Wi-Fi, aby je odebrać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este código não expira: quem o escanear ou fotografar fica com a senha do Wi-Fi. Altere a senha do Wi-Fi para revogá-la."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此代码不会过期：任何扫描或拍下它的人都会保留 Wi-Fi 密码。要收回，请更改 Wi-Fi 密码。"
          }
        }
      }
    },
