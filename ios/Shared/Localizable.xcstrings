    "sync.thisPcHasAnOlder2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser PC hat einen älteren Synchronisierungsschlüssel als %@. Lassen Sie den Cloud-Ordner die Synchronisierung abschließen oder treten Sie dem Ordner mit dem neuesten Synchronisierungspasswort erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This PC has an older sync key than %@. Let the cloud folder finish syncing, or join the folder again with the newest sync password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PC tiene una clave de sincronización más antigua que %@. Deja que la carpeta en la nube termine de sincronizarse, o vuelve a unirte a la carpeta con la contraseña de sincronización más reciente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo PC ha una chiave di sincronizzazione più vecchia di %@. Lascia che la cartella cloud finisca di sincronizzarsi, oppure unisciti di nuovo alla cartella con la password di sincronizzazione più recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このPCの同期キーは%@より古くなっています。クラウドフォルダーの同期が終わるのを待つか、最新の同期パスワードでもう一度フォルダーに参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 PC의 동기화 키가 %@보다 오래되었습니다. 클라우드 폴더가 동기화를 마치도록 기다리거나, 최신 동기화 비밀번호로 폴더에 다시 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze pc heeft een oudere synchronisatiesleutel dan %@. Laat de cloudmap eerst klaar synchroniseren, of sluit opnieuw aan bij de map met het nieuwste synchronisatiewachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten komputer ma starszy klucz synchronizacji niż %@. Poczekaj, aż folder w chmurze zakończy synchronizację, lub dołącz do folderu ponownie z najnowszym hasłem synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PC tem uma chave de sincronização mais antiga que %@. Deixe a pasta na nuvem terminar de sincronizar ou entre na pasta novamente com a senha de sincronização mais recente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台电脑的同步密钥比%@的旧。请等待云文件夹完成同步，或使用最新的同步密码重新加入该文件夹。"
          }
        }
      }
    },
