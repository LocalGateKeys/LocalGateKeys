          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys no pudo escribir en esa carpeta y no se pudo deshacer el uso compartido. Elige Dejar de compartir y vuelve a intentarlo con otra carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys n’a pas pu écrire dans ce dossier, et le partage n’a pas pu être annulé. Choisissez Arrêter le partage, puis réessayez avec un autre dossier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys non è riuscito a scrivere in quella cartella e la condivisione non è stata annullata. Scegli Interrompi la condivisione, poi riprova con un’altra cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeysはそのフォルダーに書き込めず、共有を取り消すこともできませんでした。「共有を停止」を選んでから、別のフォルダーでもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys가 그 폴더에 쓸 수 없었고 공유를 취소하지도 못했습니다. 공유 중지를 선택한 다음 다른 폴더로 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys kon niet naar die map schrijven, en het delen kon niet ongedaan worden gemaakt. Kies Stoppen met delen en probeer het daarna opnieuw met een andere map."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys nie może zapisywać w tym folderze, a udostępnienia nie udało się cofnąć. Wybierz Zakończ udostępnianie, a potem spróbuj ponownie z innym folderem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LocalGateKeys não conseguiu gravar nessa pasta, e o compartilhamento não pôde ser desfeito. Escolha Parar de compartilhar e tente de novo com outra pasta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
