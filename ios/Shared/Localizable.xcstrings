    "ipad.editor.leftWhileEditing.apiKey" : {
      "comment" : "iPad wording of \"You left the app while editing a api key. Your changes were…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben die App beim Bearbeiten eines API-Schlüssels verlassen. Ihre Änderungen wurden auf diesem iPad behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
