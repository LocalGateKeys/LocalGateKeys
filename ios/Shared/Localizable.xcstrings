    },
    "The code points to %@ but this %@ is on %@. On the PC, set the sync address to its Wi-Fi IPv4 address (ipconfig) and show a new code." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Code verweist auf %1$@, aber dieses Gerät (%2$@) ist unter %3$@. Legen Sie auf dem PC die Sync-Adresse auf seine WLAN-IPv4-Adresse fest (ipconfig) und zeigen Sie einen neuen Code an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The code points to %1$@ but this %2$@ is on %3$@. On the PC, set the sync address to its Wi-Fi IPv4 address (ipconfig) and show a new code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código apunta a %1$@ pero este %2$@ está en %3$@. En el PC, establece la dirección de sincronización en su dirección IPv4 de Wi-Fi (ipconfig) y muestra un código nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le code pointe vers %1$@ mais ce %2$@ est sur %3$@. Sur le PC, définissez l’adresse de synchronisation sur son adresse IPv4 Wi-Fi (ipconfig) et affichez un nouveau code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il codice punta a %1$@ ma questo %2$@ è su %3$@. Sul PC, imposta l'indirizzo di sincronizzazione sul suo indirizzo IPv4 Wi-Fi (ipconfig) e mostra un nuovo codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コードは%1$@を指していますが、この%2$@は%3$@上にあります。PCで、同期アドレスをWi-FiのIPv4アドレス(ipconfig)に設定し、新しいコードを表示してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코드는 %1$@을(를) 가리키지만 이 %2$@는 %3$@에 있습니다. PC에서 동기화 주소를 PC의 Wi-Fi IPv4 주소(ipconfig)로 설정하고 새 코드를 표시하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De code verwijst naar %1$@ maar deze %2$@ zit op %3$@. Stel op de pc het synchronisatieadres in op het wifi-IPv4-adres (ipconfig) en toon een nieuwe code."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod wskazuje %1$@, ale to urządzenie (%2$@) jest pod adresem %3$@. Na komputerze ustaw adres synchronizacji na jego adres IPv4 w Wi-Fi (ipconfig) i pokaż nowy kod."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O código aponta para %1$@, mas este %2$@ está em %3$@. No PC, defina o endereço de sincronização como o endereço IPv4 do Wi-Fi dele (ipconfig) e mostre um novo código."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该验证码指向 %1$@，但这台%2$@位于 %3$@。请在 PC 上将同步地址设为其 Wi-Fi IPv4 地址（ipconfig），并显示新的验证码。"
          }
        }
      }
    },
