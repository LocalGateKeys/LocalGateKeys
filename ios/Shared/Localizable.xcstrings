    "factors.yubikeySetup" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys programmiert Ihren YubiKey nie. Richten Sie ihn in Yubico Authenticator ein: Slots, Challenge-Response, HMAC-SHA1, Steckplatz 2 (oder 1). Ein Backup-YubiKey braucht dasselbe Geheimnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys never programs your YubiKey. Set it up in Yubico Authenticator: Slots, Challenge-response, HMAC-SHA1, slot 2 (or slot 1). A backup YubiKey needs the same secret."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys nunca programa su YubiKey. Configúrela en Yubico Authenticator: Slots, Challenge-response, HMAC-SHA1, ranura 2 (o ranura 1). Una YubiKey de copia de seguridad necesita el mismo secreto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys ne programme jamais votre YubiKey. Configurez-la dans Yubico Authenticator : Slots, Challenge-response, HMAC-SHA1, emplacement 2 (ou 1). Une YubiKey de sauvegarde doit avoir le même secret."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys non programma mai la YubiKey. Configurala in Yubico Authenticator: Slots, Challenge-response, HMAC-SHA1, slot 2 (o slot 1). Una YubiKey di backup richiede lo stesso segreto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys が YubiKey をプログラムすることはありません。Yubico Authenticator で設定してください: Slots、Challenge-response、HMAC-SHA1、スロット 2 (またはスロット 1)。バックアップの YubiKey には同じシークレットが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys는 YubiKey를 프로그래밍하지 않습니다. Yubico Authenticator에서 설정하세요: Slots, Challenge-response, HMAC-SHA1, 슬롯 2(또는 슬롯 1). 백업 YubiKey에는 같은 비밀 값이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys programmeert je YubiKey nooit. Stel hem in met Yubico Authenticator: Slots, Challenge-response, HMAC-SHA1, slot 2 (of slot 1). Een back-up-YubiKey heeft hetzelfde geheim nodig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys nigdy nie programuje klucza YubiKey. Skonfiguruj go w Yubico Authenticator: Slots, Challenge-response, HMAC-SHA1, gniazdo 2 (lub 1). Zapasowy klucz YubiKey wymaga tego samego sekretu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LocalGateKeys nunca programa sua YubiKey. Configure-a no Yubico Authenticator: Slots, Challenge-response, HMAC-SHA1, slot 2 (ou slot 1). Uma YubiKey de backup precisa do mesmo segredo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys 从不编程你的 YubiKey。请在 Yubico Authenticator 中设置：Slots、Challenge-response、HMAC-SHA1、插槽 2（或插槽 1）。备份 YubiKey 需要相同的密钥。"
          }
        }
      }
    },
