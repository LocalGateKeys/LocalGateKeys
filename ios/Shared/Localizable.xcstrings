    "At most 256 accounts can be added from one scan. Add these, then scan the rest separately." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus einem Scan können höchstens 256 Konten hinzugefügt werden. Fügen Sie diese hinzu und scannen Sie den Rest separat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pueden añadir como máximo 256 cuentas con un escaneo. Añade estas y escanea el resto por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul scan peut ajouter au plus 256 comptes. Ajoutez ceux-ci, puis scannez le reste séparément."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da una sola scansione si possono aggiungere al massimo 256 account. Aggiungi questi, poi scansiona il resto separatamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回のスキャンで追加できるアカウントは最大256件です。これらを追加してから、残りを別にスキャンしてください。"
