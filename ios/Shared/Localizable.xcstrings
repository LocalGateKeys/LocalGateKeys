    "Access expired on %@. Confirming it's you is needed for every use." : {
      "comment" : "Feature pack (item history, travel mode, access rules, clean-up, privacy proof, passkeys)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zugriff ist am %@ abgelaufen. Bei jeder Verwendung ist eine Bestätigung nötig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso caducó el %@. Hay que confirmar que eres tú en cada uso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès a expiré le %@. Une confirmation de votre identité est requise à chaque utilisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso è scaduto il %@. Ad ogni uso serve confermare la tua identità."
