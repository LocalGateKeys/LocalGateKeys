    "Too easy to guess. Add more words or characters." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu leicht zu erraten. Fügen Sie weitere Wörter oder Zeichen hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiado fácil de adivinar. Añade más palabras o caracteres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop facile à deviner. Ajoutez des mots ou des caractères."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppo facile da indovinare. Aggiungi altre parole o caratteri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推測されやすすぎます。単語や文字を増やしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "너무 추측하기 쉽습니다. 단어나 문자를 더 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te makkelijk te raden. Voeg meer woorden of tekens toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbyt łatwe do odgadnięcia. Dodaj więcej słów lub znaków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fácil demais de adivinhar. Adicione mais palavras ou caracteres."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太容易被猜到。请增加词或字符。"
          }
        }
      }
    },
    "Too many attempts. Try again in %lld s." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Versuche. Versuchen Sie es in %lld s erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiados intentos. Inténtalo de nuevo en %lld s."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de tentatives. Réessayez dans %lld s."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppi tentativi. Riprova tra %lld s."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試行回数が多すぎます。%lld秒後にもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시도 횟수가 너무 많습니다. %lld초 후에 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te veel pogingen. Probeer het over %lld s opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbyt wiele prób. Spróbuj ponownie za %lld s."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tentativas demais. Tente novamente em %lld s."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尝试次数过多。请在 %lld 秒后重试。"
          }
        }
      }
    },
    "Too many wrong sync passwords. Wait 30 seconds, then try again." : {
