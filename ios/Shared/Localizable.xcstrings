    "An entry no longer matches the chain. Check AI agent access and export the log." : {
      "comment" : "Security centre: access log check",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Eintrag passt nicht mehr zur Kette. Prüfen Sie den Zugriff für KI-Agenten und exportieren Sie das Protokoll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una entrada ya no coincide con la cadena. Revisa el acceso de agentes de IA y exporta el registro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une entrée ne correspond plus à la chaîne. Vérifiez l'accès des agents IA et exportez le journal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una voce non corrisponde più alla catena. Controlla l'accesso degli agenti IA ed esporta il registro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エントリがチェーンと一致しません。AI エージェントのアクセスを確認し、ログを書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목이 체인과 더 이상 일치하지 않습니다. AI 에이전트 접근을 확인하고 기록을 내보내세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een regel past niet meer in de keten. Controleer de toegang voor AI-agents en exporteer het logboek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpis nie pasuje już do łańcucha. Sprawdź dostęp agentów AI i wyeksportuj dziennik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma entrada não corresponde mais à cadeia. Verifique o acesso de agentes de IA e exporte o registro."
