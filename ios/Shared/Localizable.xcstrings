        }
      }
    },
    "ipad.sync.off" : {
      "comment" : "iPad wording of \"Off. Other phones and computers on the s…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus. Andere Telefone und Computer im selben WLAN können sich mit diesem iPad koppeln und mit ihm synchronisieren, solange LocalGateKeys hier geöffnet und entsperrt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off. Other phones and computers on the same Wi-Fi can pair with this iPad and sync with it while LocalGateKeys is open and unlocked here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado. Otros teléfonos y ordenadores de la misma Wi-Fi pueden emparejarse con este iPad y sincronizar con él mientras LocalGateKeys está abierto y desbloqueado aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé. D’autres téléphones et ordinateurs sur le même réseau Wi-Fi peuvent s’associer à cet iPad et se synchroniser avec lui tant que LocalGateKeys est ouvert et déverrouillé ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato. Altri telefoni e computer sullo stesso Wi-Fi possono associarsi a questo iPad e sincronizzarsi con esso mentre LocalGateKeys è aperto e sbloccato qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ。同じWi-Fi上の他のスマートフォンやコンピュータは、ここでLocalGateKeysが開いていてロック解除されている間、このiPadとペアリングして同期できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꺼짐. 여기에서 LocalGateKeys가 열려 있고 잠금 해제된 동안 같은 Wi-Fi의 다른 휴대폰과 컴퓨터가 이 iPad와 페어링하고 동기화할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit. Andere telefoons en computers op hetzelfde wifi-netwerk kunnen met deze iPad koppelen en synchroniseren zolang LocalGateKeys hier open en ontgrendeld is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączone. Inne telefony i komputery w tej samej sieci Wi-Fi mogą sparować się z tym iPadem i synchronizować z nim, gdy LocalGateKeys jest tu otwarty i odblokowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado. Outros celulares e computadores no mesmo Wi-Fi podem parear com este iPad e sincronizar com ele enquanto o LocalGateKeys estiver aberto e desbloqueado aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已关闭。当 LocalGateKeys 在这里打开并已解锁时，同一 Wi-Fi 上的其他手机和电脑可以与这台 iPad 配对并同步。"
          }
        }
      }
    },
    "ipad.sync.oneItemFromCouldNot" : {
      "comment" : "iPad wording of \"One item from %@ could not be read on this iPhone and was s…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Eintrag von %@ konnte auf diesem iPad nicht gelesen werden und wurde übersprungen; alles andere wurde synchronisiert. Ein Update von LocalGateKeys auf diesem iPad behebt das meist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One item from %@ could not be read on this iPad and was skipped; everything else synced. Updating LocalGateKeys on this iPad usually fixes this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer en este iPad un elemento de %@ y se omitió; todo lo demás se sincronizó. Actualizar LocalGateKeys en este iPad suele solucionarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un élément de %@ n’a pas pu être lu sur cet iPad et a été ignoré ; tout le reste a été synchronisé. Mettre à jour LocalGateKeys sur cet iPad règle généralement le problème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un elemento da %@ non ha potuto essere letto su questo iPad ed è stato saltato; tutto il resto è stato sincronizzato. Di solito aggiornare LocalGateKeys su questo iPad risolve il problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の項目が1件、このiPadで読み取れずスキップされましたが、それ以外はすべて同期されました。このiPadのLocalGateKeysをアップデートすると、通常は解決します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 항목 하나를 이 iPad에서 읽을 수 없어 건너뛰었으며 나머지는 모두 동기화되었습니다. 이 iPad에서 LocalGateKeys를 업데이트하면 대개 해결됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén item van %@ kon op deze iPad niet worden gelezen en is overgeslagen; al het andere is gesynchroniseerd. Een update van LocalGateKeys op deze iPad lost dit meestal op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednego elementu z %@ nie udało się odczytać na tym iPadzie i został pominięty; wszystko inne zostało zsynchronizowane. Zwykle pomaga aktualizacja LocalGateKeys na tym iPadzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um item de %@ não pôde ser lido neste iPad e foi ignorado; todo o resto foi sincronizado. Atualizar o LocalGateKeys neste iPad geralmente resolve isso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自 %@ 的一个项目无法在这台 iPad 上读取，已被跳过；其他所有内容均已同步。更新这台 iPad 上的 LocalGateKeys 通常可以解决此问题。"
          }
        }
      }
    },
    "ipad.sync.oneItemNeedsANewer" : {
      "comment" : "iPad wording of \"One item needs a newer LocalGateKeys on this iPhone. Update…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Eintrag benötigt ein neueres LocalGateKeys auf diesem iPad. Aktualisieren Sie LocalGateKeys; dieser Eintrag wartet bis dahin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One item needs a newer LocalGateKeys on this iPad. Update LocalGateKeys; that item waits until then."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un elemento necesita una versión más reciente de LocalGateKeys en este iPad. Actualiza LocalGateKeys; ese elemento espera hasta entonces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un élément nécessite une version plus récente de LocalGateKeys sur cet iPad. Mettez LocalGateKeys à jour ; cet élément attend jusque-là."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un elemento richiede una versione più recente di LocalGateKeys su questo iPad. Aggiorna LocalGateKeys; quell'elemento attende fino ad allora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1件の項目には、このiPadでより新しいLocalGateKeysが必要です。LocalGateKeysをアップデートしてください。それまで、その項目は待機します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목 하나에 이 iPad의 더 최신 LocalGateKeys가 필요합니다. LocalGateKeys를 업데이트하세요. 그때까지 해당 항목은 대기합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén item vereist een nieuwere LocalGateKeys op deze iPad. Werk LocalGateKeys bij; dat item wacht tot die tijd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden element wymaga nowszego LocalGateKeys na tym iPadzie. Zaktualizuj LocalGateKeys; do tego czasu ten element czeka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um item exige um LocalGateKeys mais novo neste iPad. Atualize o LocalGateKeys; esse item espera até lá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一个项目需要这台 iPad 上更新版本的 LocalGateKeys。请更新 LocalGateKeys；在此之前该项目会等待。"
          }
        }
      }
    },
    "ipad.sync.removalNoticeVerified" : {
      "comment" : "iPad wording of \"Another of your devices removed this iPhone from sync. “Era…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderes Ihrer Geräte hat dieses iPad aus der Synchronisierung entfernt. „Dieses Gerät löschen, wenn es aus der Synchronisierung entfernt wird“ ist aus, daher bleibt der Tresor auf diesem iPad. Verlassen Sie die Synchronisierung oder treten Sie dem Ordner erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another of your devices removed this iPad from sync. “Erase this device if it is removed from sync” is off, so the vault stays on this iPad. Leave sync, or join the folder again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otro de tus dispositivos quitó este iPad de la sincronización. «Borrar este dispositivo si se quita de la sincronización» está desactivado, así que la bóveda se queda en este iPad. Sal de la sincronización o vuelve a unirte a la carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un autre de vos appareils a retiré cet iPad de la synchronisation. « Effacer cet appareil s’il est retiré de la synchronisation » est désactivé ; le coffre-fort reste donc sur cet iPad. Quittez la synchronisation, ou rejoignez de nouveau le dossier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro dei tuoi dispositivi ha rimosso questo iPad dalla sincronizzazione. «Cancella questo dispositivo se viene rimosso dalla sincronizzazione» è disattivato, quindi la cassaforte resta su questo iPad. Esci dalla sincronizzazione o unisciti di nuovo alla cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのデバイスがこのiPadを同期から削除しました。「同期から削除されたらこのデバイスを消去」がオフのため、保管庫はこのiPadに残ります。同期から退出するか、フォルダーに再参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기에서 이 iPad를 동기화에서 제거했습니다. '동기화에서 제거되면 이 기기 지우기'가 꺼져 있으므로 보관함은 이 iPad에 남습니다. 동기화를 나가거나 폴더에 다시 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een ander apparaat van u heeft deze iPad uit de synchronisatie verwijderd. ‘Dit apparaat wissen als het uit de synchronisatie wordt verwijderd’ staat uit, dus de kluis blijft op deze iPad. Verlaat de synchronisatie of neem opnieuw deel aan de map."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inne z Twoich urządzeń usunęło ten iPad z synchronizacji. „Wymaż to urządzenie, jeśli zostanie usunięte z synchronizacji” jest wyłączone, więc sejf zostaje na tym iPadzie. Opuść synchronizację lub dołącz ponownie do folderu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro dos seus dispositivos removeu este iPad da sincronização. “Apagar este dispositivo se ele for removido da sincronização” está desativado, então o cofre fica em este iPad. Saia da sincronização ou entre na pasta de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的另一台设备已将这台 iPad从同步中移除。“从同步中移除时清除此设备”已关闭，因此保管库保留在这台 iPad上。请退出同步，或重新加入该文件夹。"
          }
        }
      }
    },
    "ipad.sync.resetSyncOnThisPc" : {
      "comment" : "iPad wording of \"Reset sync on this iPhone?\n\nThis forgets this vault's sync …\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync auf diesem iPad zurücksetzen?\n\nDadurch werden die Sync-Gruppe dieses Tresors, seine Schlüssel und sein Sync-Verlauf vergessen. Ihre Einträge bleiben auf diesem iPad. Um wieder zu synchronisieren, treten Sie einem Ordner bei oder koppeln erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reset sync on this iPad?\n\nThis forgets this vault's sync group, its keys and its sync history. Your items stay on this iPad. To sync again you join a folder or pair again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Restablecer la sincronización en este iPad?\n\nEsto olvida el grupo de sincronización de esta bóveda, sus claves y su historial de sincronización. Tus elementos se quedan en este iPad. Para volver a sincronizar, te unes a una carpeta o empareja de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réinitialiser la synchronisation sur cet iPad ?\n\nCela fait oublier le groupe de synchronisation de ce coffre-fort, ses clés et son historique de synchronisation. Vos éléments restent sur cet iPad. Pour synchroniser de nouveau, vous rejoignez un dossier ou vous associez de nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reimpostare la sincronizzazione su questo iPad?\n\nQuesto dimentica il gruppo di sincronizzazione di questa cassaforte, le sue chiavi e la sua cronologia di sincronizzazione. I tuoi elementi restano su questo iPad. Per sincronizzare di nuovo ti unisci a una cartella o associ di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPadの同期をリセットしますか?\n\nこの保管庫の同期グループ、鍵、同期履歴が削除されます。項目はこのiPadに残ります。もう一度同期するには、フォルダに参加するか、再度ペアリングします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPad의 동기화를 초기화할까요?\n\n이 보관함의 동기화 그룹, 키, 동기화 기록을 잊습니다. 항목은 이 iPad에 남습니다. 다시 동기화하려면 폴더에 참여하거나 다시 페어링하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisatie op deze iPad resetten?\n\nDit vergeet de synchronisatiegroep van deze kluis, de sleutels en de synchronisatiegeschiedenis. Je items blijven op deze iPad. Om opnieuw te synchroniseren voeg je een map toe of koppel je opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zresetować synchronizację na tym iPadzie?\n\nTo zapomina grupę synchronizacji tego sejfu, jej klucze i historię synchronizacji. Twoje elementy zostają na tym iPadzie. Aby znów synchronizować, dołącz do folderu lub sparuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redefinir a sincronização neste iPad?\n\nIsso esquece o grupo de sincronização deste cofre, as chaves dele e o histórico de sincronização. Seus itens continuam neste iPad. Para sincronizar de novo, você entra em uma pasta ou pareia novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重置这台 iPad 上的同步？\n\n这会忘记此保管库的同步群组、密钥和同步历史记录。您的项目保留在这台 iPad 上。要再次同步，您需要加入文件夹或重新配对。"
          }
        }
      }
    },
    "ipad.sync.runsAnOlderLocalgatekeysAnd" : {
      "comment" : "iPad wording of \"%@ runs an older LocalGateKeys and cannot sync over Wi-Fi w…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verwendet ein älteres LocalGateKeys und kann nicht über WLAN mit diesem iPad synchronisieren. Aktualisieren Sie LocalGateKeys auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ runs an older LocalGateKeys and cannot sync over Wi-Fi with this iPad. Update LocalGateKeys on that device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ejecuta una versión anterior de LocalGateKeys y no puede sincronizar por Wi-Fi con este iPad. Actualiza LocalGateKeys en ese dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ utilise une version plus ancienne de LocalGateKeys et ne peut pas se synchroniser par Wi-Fi avec cet iPad. Mettez LocalGateKeys à jour sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usa una versione meno recente di LocalGateKeys e non può sincronizzarsi via Wi-Fi con questo iPad. Aggiorna LocalGateKeys su quel dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は古いLocalGateKeysを使用しており、このiPadとWi-Fi経由で同期できません。そのデバイスのLocalGateKeysをアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 이전 버전의 LocalGateKeys를 사용 중이라 이 iPad와 Wi-Fi로 동기화할 수 없습니다. 해당 기기에서 LocalGateKeys를 업데이트하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gebruikt een oudere LocalGateKeys en kan niet via wifi met deze iPad synchroniseren. Werk LocalGateKeys op dat apparaat bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ używa starszego LocalGateKeys i nie może synchronizować przez Wi-Fi z tym iPadem. Zaktualizuj LocalGateKeys na tamtym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usa um LocalGateKeys mais antigo e não consegue sincronizar por Wi-Fi com este iPad. Atualize o LocalGateKeys nesse dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 运行的是较旧的 LocalGateKeys，无法通过 Wi-Fi 与这台 iPad 同步。请更新那台设备上的 LocalGateKeys。"
          }
        }
      }
    },
