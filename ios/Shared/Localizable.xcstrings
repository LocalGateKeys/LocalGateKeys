    "AutoFill settings could not be opened. Open the Settings app › General › AutoFill & Passwords and turn on LocalGateKeys." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die AutoFill-Einstellungen konnten nicht geöffnet werden. Öffnen Sie die App „Einstellungen“ › Allgemein › AutoFill & Passwörter und aktivieren Sie LocalGateKeys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
