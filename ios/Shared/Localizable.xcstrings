    "whatsNew.1.2.answers.detail" : {
      "comment" : "What's new 1.2 sheet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Modus „Antwort“ im Generator erfindet Antworten, die niemand aus Ihrem Leben erraten kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The generator's Answer mode makes up answers no one can guess from your life."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo Respuesta del generador inventa respuestas que nadie puede adivinar a partir de tu vida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode Réponse du générateur invente des réponses que personne ne peut deviner à partir de votre vie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità Risposta del generatore inventa risposte che nessuno può indovinare dalla tua vita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジェネレータの「回答」モードは、あなたの生活から推測できない回答を作ります。"
