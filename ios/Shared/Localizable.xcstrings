          }
        }
      }
    },
    "No recovery phrase is set, so the backup password can't be reset. Scheduled backups keep using it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist keine Wiederherstellungsphrase festgelegt, daher kann das Backup-Passwort nicht zurückgesetzt werden. Geplante Backups verwenden es weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna frase de recuperación, así que la contraseña de copia de seguridad no se puede restablecer. Las copias programadas la siguen usando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune phrase de récupération n’est définie ; le mot de passe de sauvegarde ne peut donc pas être réinitialisé. Les sauvegardes planifiées continuent de l’utiliser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è impostata alcuna frase di recupero, quindi la password del backup non può essere reimpostata. I backup programmati continuano a usarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リカバリーフレーズが設定されていないため、バックアップパスワードはリセットできません。スケジュールされたバックアップは引き続きこのパスワードを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구 문구가 설정되어 있지 않아 백업 비밀번호를 재설정할 수 없습니다. 예약된 백업은 계속 이 비밀번호를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is geen herstelzin ingesteld, dus het back-upwachtwoord kan niet opnieuw worden ingesteld. Geplande back-ups blijven het gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie ustawiono frazy odzyskiwania, więc hasła kopii zapasowej nie można zresetować. Zaplanowane kopie zapasowe nadal go używają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma frase de recuperação está definida, então a senha de backup não pode ser redefinida. Os backups agendados continuam a usá-la."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
