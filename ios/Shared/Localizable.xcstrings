          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellen Sie eine Wiederherstellungsphrase und geben Sie drei ihrer Wörter erneut ein, damit ein vergessenes Master-Passwort nicht das Ende bedeutet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una frase de recuperación y vuelve a escribir tres de sus palabras, para que olvidar la contraseña maestra no sea el fin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una frase di recupero e riscrivi tre delle sue parole, così una password principale dimenticata non sarà la fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リカバリーフレーズを作成し、そのうち3つの単語を入力し直します。マスターパスワードを忘れても、これで終わりにはなりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구 문구를 만들고 그중 세 단어를 다시 입력하세요. 마스터 비밀번호를 잊어도 끝이 아닙니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een herstelzin en typ drie van de woorden opnieuw in, zodat een vergeten hoofdwachtwoord niet het einde is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz frazę odzyskiwania i przepisz trzy jej słowa, aby zapomniane hasło główne nie oznaczało końca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie uma frase de recuperação e digite novamente três das palavras dela, para que esquecer a senha mestra não seja o fim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建恢复短语并重新输入其中三个词，这样忘记主密码就不会成为终点。"
          }
        }
      }
    },
