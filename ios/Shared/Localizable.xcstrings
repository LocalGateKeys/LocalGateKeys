            "value" : "Schakel de Safari-extensie en automatisch invullen in om logins en passkeys in te vullen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz rozszerzenie Safari i AutoFill, aby uzupełniać loginy i klucze dostępu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative a extensão do Safari e o preenchimento automático para preencher logins e chaves de acesso."
