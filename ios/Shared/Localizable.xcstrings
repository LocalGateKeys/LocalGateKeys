    "These logins have no 2FA code saved. Turn on two-factor sign-in on the site if it offers it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei diesen Anmeldungen ist kein 2FA-Code gespeichert. Aktivieren Sie die Zwei-Faktor-Anmeldung auf der Website, sofern sie angeboten wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
