    "ipad.vault.proNeededSharing" : {
      "comment" : "iPad wording of \"Shared collections need LocalGateKeys Pro. Items already sh…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geteilte Sammlungen erfordern LocalGateKeys Pro. Einträge, die bereits mit Ihnen geteilt wurden, bleiben auf diesem iPad und funktionieren weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shared collections need LocalGateKeys Pro. Items already shared with you stay on this iPad and keep working."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las colecciones compartidas requieren LocalGateKeys Pro. Los elementos que ya se compartieron contigo se quedan en este iPad y siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les collections partagées nécessitent LocalGateKeys Pro. Les éléments déjà partagés avec vous restent sur cet iPad et continuent de fonctionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le raccolte condivise richiedono LocalGateKeys Pro. Gli elementi già condivisi con te restano su questo iPad e continuano a funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有コレクションにはLocalGateKeys Proが必要です。すでに共有された項目はこのiPadに残り、引き続き使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 컬렉션에는 LocalGateKeys Pro가 필요합니다. 이미 공유받은 항목은 이 iPad에 그대로 유지되며 계속 작동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor gedeelde verzamelingen is LocalGateKeys Pro nodig. Items die al met je zijn gedeeld, blijven op deze iPad en blijven werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnione kolekcje wymagają LocalGateKeys Pro. Elementy, które już Ci udostępniono, zostają na tym iPadzie i nadal działają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coleções compartilhadas exigem o LocalGateKeys Pro. Os itens já compartilhados com você continuam neste iPad e funcionando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享集合需要 LocalGateKeys Pro。已与您共享的项目会保留在这台 iPad 上并继续可用。"
          }
        }
      }
    },
    "ipad.vaultEraser.confirm1" : {
      "comment" : "iPad wording of \"Erase this iPhone's vault?\n\nThis deletes every item, the va…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tresor dieses iPads löschen?\n\nDadurch werden alle Einträge, die Schlüssel des Tresors und seine Sync-Einstellungen von diesem iPad gelöscht. Ihr PC und der Sync-Ordner bleiben unverändert. Wenn dieses iPad Ihre einzige Kopie war, sind die Einträge verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erase this iPad's vault?\n\nThis deletes every item, the vault's keys and its sync settings from this iPad. Your PC and the sync folder are not changed. If this iPad was your only copy, the items are gone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Borrar la bóveda de este iPad?\n\nEsto elimina de este iPad todos los elementos, las claves de la bóveda y sus ajustes de sincronización. Tu PC y la carpeta de sincronización no cambian. Si este iPad era tu única copia, los elementos se pierden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effacer le coffre-fort de cet iPad ?\n\nCela supprime de cet iPad tous les éléments, les clés du coffre-fort et ses réglages de synchronisation. Votre PC et le dossier de synchronisation ne sont pas modifiés. Si cet iPad était votre seule copie, les éléments sont perdus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancellare la cassaforte di questo iPad?\n\nQuesto elimina da questo iPad ogni elemento, le chiavi della cassaforte e le sue impostazioni di sincronizzazione. Il tuo PC e la cartella di sincronizzazione non vengono modificati. Se questo iPad era la tua unica copia, gli elementi andranno persi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPadの保管庫を消去しますか?\n\nこのiPadから、すべての項目、保管庫の鍵、同期設定が削除されます。PCと同期フォルダは変更されません。このiPadが唯一のコピーだった場合、項目は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPad의 보관함을 지울까요?\n\n이 iPad에서 모든 항목, 보관함 키, 동기화 설정이 삭제됩니다. PC와 동기화 폴더는 변경되지 않습니다. 이 iPad가 유일한 사본이었다면 항목은 사라집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kluis van deze iPad wissen?\n\nDit verwijdert elk item, de sleutels van de kluis en de synchronisatie-instellingen van deze iPad. Je pc en de synchronisatiemap blijven ongewijzigd. Was deze iPad je enige kopie, dan zijn de items weg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymazać sejf z tego iPada?\n\nTo usuwa z tego iPada każdy element, klucze sejfu i jego ustawienia synchronizacji. Twój komputer i folder synchronizacji nie zostają zmienione. Jeśli ten iPad był Twoją jedyną kopią, elementy przepadną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagar o cofre deste iPad?\n\nIsso exclui todos os itens, as chaves do cofre e os ajustes de sincronização deste iPad. Seu PC e a pasta de sincronização não são alterados. Se este iPad era sua única cópia, os itens estarão perdidos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抹掉这台 iPad 的保管库？\n\n这会从这台 iPad 上删除所有项目、保管库的密钥及其同步设置。您的 PC 和同步文件夹不会有任何更改。如果这台 iPad 是您唯一的副本，这些项目将永远丢失。"
          }
        }
      }
    },
    "ipad.vaultEraser.confirm2" : {
      "comment" : "iPad wording of \"Are you sure? This cannot be undone. Erase this iPhone's va…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher? Das kann nicht rückgängig gemacht werden. Tresor dieses iPads jetzt löschen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure? This cannot be undone. Erase this iPad's vault now?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro? Esto no se puede deshacer. ¿Borrar ahora la bóveda de este iPad?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr ? Cette action est irréversible. Effacer maintenant le coffre-fort de cet iPad ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro? Non si può annullare. Cancellare ora la cassaforte di questo iPad?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よろしいですか? この操作は取り消せません。今すぐこのiPadの保管庫を消去しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정말입니까? 이 작업은 되돌릴 수 없습니다. 지금 이 iPad의 보관함을 지우시겠습니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je het zeker? Dit kan niet ongedaan worden gemaakt. De kluis van deze iPad nu wissen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na pewno? Tego nie można cofnąć. Wymazać teraz sejf z tego iPada?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza? Isso não pode ser desfeito. Apagar o cofre deste iPad agora?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确定吗？此操作无法撤销。现在抹掉这台 iPad 的保管库？"
          }
        }
      }
    },
    "ipad.whatsNew.1.2.languages.detail" : {
      "comment" : "iPad wording of \"LocalGateKeys follows your iPhone's language: English, Fren…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys folgt der Sprache Ihres iPads: Englisch, Französisch, Deutsch, Spanisch, Italienisch, Niederländisch, Polnisch, brasilianisches Portugiesisch, Japanisch, Koreanisch oder vereinfachtes Chinesisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys follows your iPad's language: English, French, German, Spanish, Italian, Dutch, Polish, Brazilian Portuguese, Japanese, Korean or Simplified Chinese."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys usa el idioma de tu iPad: inglés, francés, alemán, español, italiano, neerlandés, polaco, portugués de Brasil, japonés, coreano o chino simplificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys suit la langue de votre iPad : anglais, français, allemand, espagnol, italien, néerlandais, polonais, portugais du Brésil, japonais, coréen ou chinois simplifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys segue la lingua del tuo iPad: inglese, francese, tedesco, spagnolo, italiano, olandese, polacco, portoghese brasiliano, giapponese, coreano o cinese semplificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys は iPad の言語で表示されます:英語、フランス語、ドイツ語、スペイン語、イタリア語、オランダ語、ポーランド語、ポルトガル語(ブラジル)、日本語、韓国語、簡体中国語。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys는 iPad의 언어를 따릅니다: 영어, 프랑스어, 독일어, 스페인어, 이탈리아어, 네덜란드어, 폴란드어, 브라질 포르투갈어, 일본어, 한국어, 중국어 간체."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys volgt de taal van je iPad: Engels, Frans, Duits, Spaans, Italiaans, Nederlands, Pools, Braziliaans Portugees, Japans, Koreaans of vereenvoudigd Chinees."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys używa języka Twojego iPada: angielskiego, francuskiego, niemieckiego, hiszpańskiego, włoskiego, niderlandzkiego, polskiego, portugalskiego (Brazylia), japońskiego, koreańskiego lub chińskiego uproszczonego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LocalGateKeys segue o idioma do seu iPad: inglês, francês, alemão, espanhol, italiano, holandês, polonês, português do Brasil, japonês, coreano ou chinês simplificado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys 会使用你 iPad 的语言:英语、法语、德语、西班牙语、意大利语、荷兰语、波兰语、巴西葡萄牙语、日语、韩语或简体中文。"
