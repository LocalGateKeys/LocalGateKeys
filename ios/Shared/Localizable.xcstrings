        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnione kolekcje wymagają LocalGateKeys Pro. Elementy, które już Ci udostępniono, zostają na tym Macu i nadal działają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
