    "Reminder: change your backup password to finish the upgrade. Copies of the vault from before the upgrade still hold the old one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerung: Ändern Sie Ihr Backup-Passwort, um das Update abzuschließen. Kopien des Tresors von vor dem Update enthalten noch das alte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recordatorio: cambia la contraseña de copia de seguridad para terminar la actualización. Las copias de la bóveda anteriores a la actualización aún contienen la anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rappel : modifiez votre mot de passe de sauvegarde pour terminer la mise à niveau. Les copies du coffre-fort antérieures à la mise à niveau contiennent encore l’ancien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promemoria: cambia la password del backup per completare l'aggiornamento. Le copie della cassaforte precedenti all'aggiornamento contengono ancora quella vecchia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リマインダー: アップグレードを完了するには、バックアップパスワードを変更してください。アップグレード前の保管庫のコピーには古いパスワードが残っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알림: 업그레이드를 마치려면 백업 비밀번호를 변경하세요. 업그레이드 이전의 보관함 사본에는 아직 이전 비밀번호가 들어 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herinnering: wijzig je back-upwachtwoord om de upgrade af te ronden. Kopieën van de kluis van vóór de upgrade bevatten nog het oude."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypomnienie: zmień hasło kopii zapasowej, aby dokończyć aktualizację. Kopie sejfu sprzed aktualizacji nadal zawierają stare hasło."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembrete: altere sua senha de backup para concluir a atualização. Cópias do cofre anteriores à atualização ainda contêm a antiga."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提醒：请更改备份密码以完成升级。升级前的保险库副本中仍保存着旧密码。"
          }
        }
      }
    },
