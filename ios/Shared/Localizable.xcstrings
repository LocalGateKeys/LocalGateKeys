    "Enter your 24-word recovery phrase and choose a new master password. Touch ID is turned off until you turn it on again in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie Ihre Wiederherstellungsphrase aus 24 Wörtern ein und wählen Sie ein neues Master-Passwort. Touch ID bleibt aus, bis Sie es in den Einstellungen wieder aktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce tu frase de recuperación de 24 palabras y elige una contraseña maestra nueva. Touch ID queda desactivado hasta que lo vuelvas a activar en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez votre phrase de récupération de 24 mots et choisissez un nouveau mot de passe principal. Touch ID est désactivé jusqu’à ce que vous le réactiviez dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci la tua frase di recupero di 24 parole e scegli una nuova password principale. Touch ID resta disattivato finché non lo riattivi in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24語のリカバリーフレーズを入力し、新しいマスターパスワードを設定してください。Touch IDはオフになります。設定でもう一度オンにするまで使えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24단어 복구 문구를 입력하고 새 마스터 비밀번호를 정하세요. Touch ID는 설정에서 다시 켤 때까지 꺼집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer je herstelzin van 24 woorden in en kies een nieuw hoofdwachtwoord. Touch ID blijft uit totdat je het in Instellingen weer inschakelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz swoją 24-słowną frazę odzyskiwania i wybierz nowe hasło główne. Touch ID jest wyłączone, dopóki nie włączysz go ponownie w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite sua frase de recuperação de 24 palavras e escolha uma nova senha mestra. O Touch ID fica desativado até você ativá-lo novamente em Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入您的 24 个词的恢复短语，并选择新的主密码。在设置中重新开启之前，Touch ID 将保持关闭。"
          }
        }
      }
    },
