    "factors.addHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Entsperren dieses Tresors ist dann zusätzlich zum Master-Passwort eine Schlüsseldatei oder ein YubiKey nötig. Die Wiederherstellungsphrase öffnet den Tresor weiterhin ohne sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A key file or YubiKey is then needed together with the master password to unlock this vault. The recovery phrase still opens the vault without them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para desbloquear esta bóveda se necesitará entonces un archivo de clave o una YubiKey además de la contraseña maestra. La frase de recuperación sigue abriendo la bóveda sin ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier de clé ou une YubiKey sera alors nécessaire en plus du mot de passe principal pour déverrouiller ce coffre. La phrase de récupération ouvre toujours le coffre sans eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per sbloccare questa cassaforte servirà allora un file chiave o una YubiKey insieme alla password principale. La frase di recupero apre comunque la cassaforte senza di essi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この保管庫のロック解除には、マスターパスワードに加えてキーファイルまたは YubiKey が必要になります。リカバリーフレーズは、それらがなくても保管庫を開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이후 이 보관함을 잠금 해제하려면 마스터 비밀번호와 함께 키 파일 또는 YubiKey가 필요합니다. 복구 문구는 이것들 없이도 보관함을 엽니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om deze kluis te ontgrendelen is dan naast het hoofdwachtwoord een sleutelbestand of YubiKey nodig. De herstelzin opent de kluis nog steeds zonder."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do odblokowania tego sejfu potrzebny będzie wtedy plik klucza lub klucz YubiKey oprócz hasła głównego. Fraza odzyskiwania nadal otwiera sejf bez nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para desbloquear este cofre será então necessário um arquivo de chave ou uma YubiKey, além da senha mestra. A frase de recuperação continua abrindo o cofre sem eles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "之后解锁此保管库除主密码外还需要密钥文件或 YubiKey。恢复短语仍可在没有它们的情况下打开保管库。"
          }
        }
      }
    },
