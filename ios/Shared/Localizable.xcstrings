    "sync.rejoinRefused" : {
      "comment" : "Pairing again after Leave sync: a host on an older app version refused the device's earlier identity; the next try pairs it as a new device.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das andere Gerät konnte dieses Gerät nicht unter seinem früheren Namen koppeln. Zeigen Sie dort einen neuen Code an und scannen Sie ihn erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The other device could not pair this device under its earlier name. Show a new code there and scan it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El otro dispositivo no pudo emparejar este dispositivo con su nombre anterior. Muestra allí un código nuevo y escanéalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autre appareil n’a pas pu associer cet appareil sous son nom précédent. Affichez-y un nouveau code et scannez-le à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'altro dispositivo non ha potuto associare questo dispositivo con il suo nome precedente. Mostra lì un nuovo codice e scansionalo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一方のデバイスは、このデバイスを以前の名前でペアリングできませんでした。そちらで新しいコードを表示し、もう一度スキャンしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기가 이 기기를 이전 이름으로 페어링할 수 없었습니다. 그곳에서 새 코드를 표시하고 다시 스캔하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het andere apparaat kon dit apparaat niet onder zijn eerdere naam koppelen. Toon daar een nieuwe code en scan die opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drugie urządzenie nie mogło sparować tego urządzenia pod jego wcześniejszą nazwą. Pokaż tam nowy kod i zeskanuj go ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O outro dispositivo não conseguiu parear este dispositivo com o nome anterior. Mostre um novo código lá e escaneie-o novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一台设备无法以此设备之前的名称进行配对。请在那里显示新的代码，然后重新扫描。"
          }
        }
      }
    },
    "sync.removalNoticeVerified" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderes Ihrer Geräte hat diesen PC aus der Synchronisierung entfernt. „Dieses Gerät löschen, wenn es aus der Synchronisierung entfernt wird“ ist aus, daher bleibt der Tresor auf diesem PC. Verlassen Sie die Synchronisierung oder treten Sie dem Ordner erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another of your devices removed this PC from sync. “Erase this device if it is removed from sync” is off, so the vault stays on this PC. Leave sync, or join the folder again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otro de tus dispositivos quitó este PC de la sincronización. «Borrar este dispositivo si se quita de la sincronización» está desactivado, así que la bóveda se queda en este PC. Sal de la sincronización o vuelve a unirte a la carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un autre de vos appareils a retiré ce PC de la synchronisation. « Effacer cet appareil s’il est retiré de la synchronisation » est désactivé ; le coffre-fort reste donc sur ce PC. Quittez la synchronisation, ou rejoignez de nouveau le dossier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro dei tuoi dispositivi ha rimosso questo PC dalla sincronizzazione. «Cancella questo dispositivo se viene rimosso dalla sincronizzazione» è disattivato, quindi la cassaforte resta su questo PC. Esci dalla sincronizzazione o unisciti di nuovo alla cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのデバイスがこのPCを同期から削除しました。「同期から削除されたらこのデバイスを消去」がオフのため、保管庫はこのPCに残ります。同期から退出するか、フォルダーに再参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기에서 이 PC를 동기화에서 제거했습니다. '동기화에서 제거되면 이 기기 지우기'가 꺼져 있으므로 보관함은 이 PC에 남습니다. 동기화를 나가거나 폴더에 다시 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een ander apparaat van u heeft deze pc uit de synchronisatie verwijderd. ‘Dit apparaat wissen als het uit de synchronisatie wordt verwijderd’ staat uit, dus de kluis blijft op deze pc. Verlaat de synchronisatie of neem opnieuw deel aan de map."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inne z Twoich urządzeń usunęło ten komputer z synchronizacji. „Wymaż to urządzenie, jeśli zostanie usunięte z synchronizacji” jest wyłączone, więc sejf zostaje na tym komputerze. Opuść synchronizację lub dołącz ponownie do folderu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro dos seus dispositivos removeu este PC da sincronização. “Apagar este dispositivo se ele for removido da sincronização” está desativado, então o cofre fica neste PC. Saia da sincronização ou entre na pasta de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的另一台设备已将此电脑从同步中移除。“从同步中移除时清除此设备”已关闭，因此保管库保留在此电脑上。请退出同步，或重新加入该文件夹。"
          }
        }
      }
    },
