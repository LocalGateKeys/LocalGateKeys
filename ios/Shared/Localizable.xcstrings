    "Asks to confirm it's you for every reveal, copy and fill." : {
      "comment" : "Feature pack (item history, travel mode, access rules, clean-up, privacy proof, passkeys)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt bei jedem Anzeigen, Kopieren und Ausfüllen nach einer Bestätigung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide confirmar que eres tú en cada revelación, copia y relleno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande de confirmer votre identité à chaque affichage, copie et remplissage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiede di confermare la tua identità per ogni visualizzazione, copia e compilazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示、コピー、入力のたびに本人確認を求めます。"
