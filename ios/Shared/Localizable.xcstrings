    "sync.youRestoredAnOlderBackup" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben ein älteres Backup wiederhergestellt. Ihren anderen Geräten wurde mitgeteilt, dass diese Kopie die aktuelle ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You restored an older backup. Your other devices were told this copy is the current one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restauraste una copia de seguridad más antigua. A tus otros dispositivos se les dijo que esta copia es la actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez restauré une sauvegarde plus ancienne. Vos autres appareils ont été informés que cette copie est la copie actuelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai ripristinato un backup più vecchio. Agli altri tuoi dispositivi è stato comunicato che questa copia è quella attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古いバックアップを復元しました。ほかのデバイスには、このコピーが現在のものであると通知されました。"
