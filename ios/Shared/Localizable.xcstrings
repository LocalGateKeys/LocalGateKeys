    "collectionShare.updateRequired" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese geteilte Sammlung braucht eine neuere Version von LocalGateKeys. Aktualisieren Sie die App, damit sie weiter synchronisiert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This shared collection needs a newer version of LocalGateKeys. Update the app to keep syncing it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta colección compartida necesita una versión más reciente de LocalGateKeys. Actualiza la app para seguir sincronizándola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette collection partagée nécessite une version plus récente de LocalGateKeys. Mettez l’app à jour pour continuer à la synchroniser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa raccolta condivisa richiede una versione più recente di LocalGateKeys. Aggiorna l'app per continuare a sincronizzarla."
