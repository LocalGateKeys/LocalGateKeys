      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat für ein anderes Gerät signierte Daten gesendet; sie wurden übersprungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
