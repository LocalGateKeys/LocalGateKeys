    "collectionShare.removedItemError" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wurden aus dieser geteilten Sammlung entfernt, aber einige ihrer Einträge konnten nicht in den Papierkorb verschoben werden. LocalGateKeys versucht es bei der nächsten Synchronisierung erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You were removed from this shared collection, but some of its items could not be moved to the trash. LocalGateKeys tries again at the next sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te quitaron de esta colección compartida, pero algunos de sus elementos no se pudieron mover a la papelera. LocalGateKeys lo intentará de nuevo en la próxima sincronización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez été retiré de cette collection partagée, mais certains de ses éléments n’ont pas pu être placés dans la corbeille. LocalGateKeys réessaie à la prochaine synchronisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei stato rimosso da questa raccolta condivisa, ma alcuni suoi elementi non sono stati spostati nel cestino. LocalGateKeys riprova alla prossima sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この共有コレクションから削除されましたが、一部の項目をごみ箱に移動できませんでした。LocalGateKeysは次回の同期で再試行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 공유 컬렉션에서 제거되었지만 일부 항목을 휴지통으로 옮기지 못했습니다. LocalGateKeys가 다음 동기화 때 다시 시도합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent uit deze gedeelde verzameling verwijderd, maar sommige items konden niet naar de prullenbak. LocalGateKeys probeert het opnieuw bij de volgende synchronisatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięto Cię z tej udostępnionej kolekcji, ale niektórych jej elementów nie udało się przenieść do kosza. LocalGateKeys spróbuje ponownie przy następnej synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você foi removido desta coleção compartilhada, mas alguns itens não puderam ir para a lixeira. O LocalGateKeys tenta de novo na próxima sincronização."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已被移出此共享集合，但它的部分项目无法移到回收站。LocalGateKeys 会在下次同步时重试。"
          }
        }
      }
    },
