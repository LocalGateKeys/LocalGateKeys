    "Move %@ to Recently deleted? You can restore it from Trash later." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nach „Zuletzt gelöscht“ verschieben? Sie können es später aus dem Papierkorb wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Mover %@ a Eliminados recientemente? Podrás restaurarlo más tarde desde la Papelera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spostare %@ in Eliminati di recente? Potrai ripristinarlo dal Cestino più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を「最近削除した項目」に移動しますか?あとでゴミ箱から復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@을(를) 최근 삭제됨으로 이동할까요? 나중에 휴지통에서 복원할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ naar Onlangs verwijderd verplaatsen? Je kunt het later herstellen vanuit de Prullenbak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenieść %@ do Ostatnio usuniętych? Możesz go później przywrócić z Kosza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover %@ para Excluídos recentemente? Você poderá restaurá-lo da Lixeira depois."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 %@ 移至“最近删除”？您之后可以从回收站还原它。"
          }
        }
      }
    },
