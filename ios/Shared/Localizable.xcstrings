    "Due dates stay encrypted. This view shows only safe titles and reminder state." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fälligkeitsdaten bleiben verschlüsselt. Diese Ansicht zeigt nur sichere Titel und den Erinnerungsstatus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fechas de vencimiento permanecen cifradas. Esta vista solo muestra títulos seguros y el estado del recordatorio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le date di scadenza restano cifrate. Questa vista mostra solo titoli sicuri e lo stato dei promemoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期限は暗号化されたままです。この画面には、安全なタイトルとリマインダーの状態だけが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기한은 암호화된 상태로 유지됩니다. 이 보기에는 안전한 제목과 알림 상태만 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervaldatums blijven versleuteld. Deze weergave toont alleen veilige titels en de status van herinneringen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminy pozostają zaszyfrowane. Ten widok pokazuje tylko bezpieczne tytuły i stan przypomnienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As datas de vencimento permanecem criptografadas. Esta exibição mostra apenas títulos seguros e o estado do lembrete."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到期日期保持加密。此视图只显示安全的标题和提醒状态。"
          }
        }
      }
    },
