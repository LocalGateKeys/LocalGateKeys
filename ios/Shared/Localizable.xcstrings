    "Face ID is locked after too many attempts. Lock and unlock your iPhone with its passcode, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID ist nach zu vielen Versuchen gesperrt. Sperren und entsperren Sie Ihr iPhone mit dem Code und versuchen Sie es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID está bloqueado por demasiados intentos. Bloquea y desbloquea tu iPhone con su código y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID est verrouillé après trop de tentatives. Verrouillez puis déverrouillez votre iPhone avec son code, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID è bloccato dopo troppi tentativi. Blocca e sblocca il tuo iPhone con il suo codice, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試行回数が多すぎたため、Face IDがロックされました。iPhoneをロックしてからパスコードで解除し、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시도 횟수가 너무 많아 Face ID가 잠겼습니다. iPhone을 잠갔다가 암호로 잠금 해제한 다음 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID is vergrendeld na te veel pogingen. Vergrendel je iPhone en ontgrendel hem met je toegangscode, en probeer het daarna opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID jest zablokowane po zbyt wielu próbach. Zablokuj i odblokuj iPhone'a kodem dostępu, a potem spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Face ID está bloqueado após muitas tentativas. Bloqueie e desbloqueie o iPhone com o código dele e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多次尝试后，Face ID 已被锁定。请用锁屏密码锁定并解锁 iPhone，然后重试。"
          }
        }
      }
    },
    "Face ID unlock is no longer set up on this device. Type your app password, then turn Face ID on again in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Entsperren mit Face ID ist auf diesem Gerät nicht mehr eingerichtet. Geben Sie Ihr App-Passwort ein und schalten Sie Face ID dann in den Einstellungen wieder ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desbloqueo con Face ID ya no está configurado en este dispositivo. Escribe tu contraseña de la app y luego vuelve a activar Face ID en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le déverrouillage par Face ID n’est plus configuré sur cet appareil. Saisissez votre mot de passe d’app, puis réactivez Face ID dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo sblocco con Face ID non è più configurato su questo dispositivo. Digita la tua password per app, poi riattiva Face ID nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスではFace IDによるロック解除が設定されていません。アプリパスワードを入力してから、設定でFace IDをもう一度オンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에서 Face ID 잠금 해제가 더 이상 설정되어 있지 않습니다. 앱 비밀번호를 입력한 다음 설정에서 Face ID를 다시 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontgrendelen met Face ID is niet meer ingesteld op dit apparaat. Typ je app-wachtwoord en zet Face ID daarna weer aan in Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odblokowywanie za pomocą Face ID nie jest już skonfigurowane na tym urządzeniu. Wpisz hasło aplikacji, a następnie ponownie włącz Face ID w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O desbloqueio com Face ID não está mais configurado neste dispositivo. Digite sua senha do app e depois ative o Face ID de novo nos Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上已不再设置 Face ID 解锁。请输入您的应用密码，然后在设置中重新开启 Face ID。"
          }
        }
      }
    },
