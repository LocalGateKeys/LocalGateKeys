    "There is no image on the clipboard. Copy a screenshot of the QR code (⌃⇧⌘4), then paste." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Zwischenablage ist kein Bild. Kopieren Sie einen Screenshot des QR-Codes (⌃⇧⌘4) und fügen Sie ihn dann ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna imagen en el portapapeles. Copia una captura del código QR (⌃⇧⌘4) y pégala."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
