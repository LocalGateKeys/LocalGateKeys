    "developer.agent.desc.mac" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt die unten eingeschalteten Schlüssel über einen privaten Socket für ssh und Git auf diesem Mac bereit. Jede Signatur fragt dich zuerst. Standardmäßig aus; diese Einstellung bleibt auf diesem Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serves the keys you switch on below to ssh and Git on this Mac, from a private socket. Every signature asks you first. Off by default; this setting stays on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofrece las claves que actives abajo a ssh y Git en este Mac, desde un socket privado. Cada firma te lo pregunta primero. Desactivado por defecto; este ajuste se queda en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fournit les clés que vous activez ci-dessous à ssh et Git sur ce Mac, depuis un socket privé. Chaque signature vous est d’abord demandée. Désactivé par défaut ; ce réglage reste sur ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offre le chiavi che attivi qui sotto a ssh e Git su questo Mac, da un socket privato. Ogni firma ti chiede prima conferma. Disattivato per impostazione predefinita; questa impostazione resta su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下でオンにした鍵を、プライベートソケットからこの Mac の ssh と Git に提供します。署名のたびに最初に確認します。初期設定はオフで、この設定はこの Mac にだけ保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래에서 켠 키를 비공개 소켓으로 이 Mac의 ssh와 Git에 제공합니다. 서명할 때마다 먼저 묻습니다. 기본값은 꺼짐이며, 이 설정은 이 Mac에만 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biedt de sleutels die je hieronder inschakelt aan ssh en Git op deze Mac aan, via een privé-socket. Elke handtekening vraagt het je eerst. Standaard uit; deze instelling blijft op deze Mac."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnia klucze włączone poniżej programom ssh i Git na tym Macu przez prywatne gniazdo. Każdy podpis najpierw wymaga Twojej zgody. Domyślnie wyłączone; to ustawienie zostaje na tym Macu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oferece as chaves que você ativar abaixo ao ssh e ao Git neste Mac, por um socket privado. Cada assinatura pede sua confirmação antes. Desativado por padrão; esta configuração fica neste Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过私有套接字，将你在下方打开的密钥提供给此 Mac 上的 ssh 和 Git。每次签名都会先询问你。默认关闭；此设置只保存在此 Mac 上。"
          }
        }
      }
    },
