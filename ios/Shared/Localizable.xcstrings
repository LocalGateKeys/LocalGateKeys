            "value" : "Ten iPhone nie mógł zapisać swojego pliku synchronizacji. Sprawdź, czy folder jest dostępny i nie jest tylko do odczytu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone não conseguiu gravar o arquivo de sincronização dele. Verifique se a pasta está disponível e não é somente leitura."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPhone 无法写入其同步文件。请检查该文件夹是否可用且不是只读的。"
          }
        }
      }
    },
    "sync.thisPcHadNotSynced" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser PC wurde seit über einem Jahr nicht synchronisiert. Anderswo vor über einem Jahr gelöschte Einträge können zurückkommen; löschen Sie sie erneut, falls sie es tun."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This PC had not synced for over a year. Items deleted elsewhere more than a year ago may come back; delete them again if they do."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PC no se había sincronizado en más de un año. Los elementos eliminados en otro lugar hace más de un año pueden volver; elimínalos de nuevo si vuelven."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo PC non si sincronizzava da più di un anno. Gli elementi eliminati altrove più di un anno fa potrebbero tornare; eliminali di nuovo se succede."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このPCは1年以上同期されていませんでした。1年以上前にほかで削除した項目が戻ってくることがあります。戻ってきた場合は、もう一度削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 PC는 1년 넘게 동기화되지 않았습니다. 1년 이상 전에 다른 곳에서 삭제한 항목이 다시 나타날 수 있으며, 그런 경우 다시 삭제하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze pc was al meer dan een jaar niet gesynchroniseerd. Items die elders meer dan een jaar geleden zijn verwijderd, kunnen terugkomen; verwijder ze dan opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten komputer nie synchronizował się od ponad roku. Elementy usunięte gdzie indziej ponad rok temu mogą wrócić; usuń je ponownie, jeśli tak się stanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PC não sincronizava há mais de um ano. Itens excluídos em outro lugar há mais de um ano podem voltar; exclua-os de novo se isso acontecer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台电脑已超过一年没有同步。在其他地方一年多以前删除的项目可能会重新出现；如果出现，请再次删除。"
          }
        }
      }
    },
