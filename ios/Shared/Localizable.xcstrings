    "agents.approve.passkeyBody" : {
      "comment" : "AI agents (Mac): Settings > Developer and the approval panel",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Login verwendet einen Passkey: Es wird kein Passwort eingesetzt. Wähle die Passkey-Anmeldung der Website und bestätige sie im Passkey-Dialog."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This login uses a passkey: no password is filled. Choose the site's passkey sign-in and confirm it in the passkey dialog."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este inicio de sesión usa una clave de acceso: no se rellena ninguna contraseña. Elige el inicio de sesión con clave de acceso del sitio y confírmalo en el diálogo de la clave de acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet identifiant utilise une clé d’accès : aucun mot de passe n’est rempli. Choisissez la connexion par clé d’accès du site et confirmez-la dans la fenêtre de la clé d’accès."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo accesso usa una passkey: nessuna password viene inserita. Scegli l'accesso con passkey del sito e confermalo nella finestra della passkey."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このログインはパスキーを使います。パスワードは入力されません。サイトのパスキーによるサインインを選び、パスキーのダイアログで確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 로그인은 패스키를 사용합니다. 비밀번호는 입력되지 않습니다. 사이트의 패스키 로그인을 선택하고 패스키 대화상자에서 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze login gebruikt een passkey: er wordt geen wachtwoord ingevuld. Kies op de website inloggen met een passkey en bevestig het in het passkeyvenster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten login używa klucza dostępu: żadne hasło nie jest wpisywane. Wybierz w witrynie logowanie kluczem dostępu i potwierdź je w oknie klucza dostępu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este login usa uma chave de acesso: nenhuma senha é preenchida. Escolha a entrada com chave de acesso do site e confirme na janela da chave de acesso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此登录项使用通行密钥：不会填入密码。请选择网站的通行密钥登录，并在通行密钥对话框中确认。"
          }
        }
      }
    },
    "agents.approve.passwordBody" : {
      "comment" : "AI agents (Mac): Settings > Developer and the approval panel",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Einmal erlauben“ erlaubt eine Anmeldung in den nächsten 5 Minuten. Klicke dann im Anmeldefeld der Website auf das LocalGateKeys-Symbol und wähle das Login: Die Seite erhält das Passwort, und die Seite und Browser-Automatisierung können es dort lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approve once allows one sign-in in the next 5 minutes. Then click the LocalGateKeys icon in the site's sign-in field and pick the login: the page receives the password, where the page and browser automation can read it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprobar una vez permite un inicio de sesión en los próximos 5 minutos. Luego haz clic en el icono de LocalGateKeys en el campo de inicio de sesión del sitio y elige el inicio de sesión: la página recibe la contraseña, donde la página y la automatización del navegador pueden leerla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approuver une fois autorise une connexion dans les 5 prochaines minutes. Cliquez ensuite sur l’icône LocalGateKeys dans le champ de connexion du site et choisissez l’identifiant : la page reçoit le mot de passe, où la page et l’automatisation du navigateur peuvent le lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approva una volta consente un accesso nei prossimi 5 minuti. Poi fai clic sull'icona di LocalGateKeys nel campo di accesso del sito e scegli l'accesso: la pagina riceve la password, dove la pagina e l'automazione del browser possono leggerla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「今回だけ承認」で、今後 5 分間に 1 回のサインインを許可します。その後、サイトのサインイン欄にある LocalGateKeys のアイコンをクリックしてログインを選んでください。パスワードはページに渡され、ページやブラウザの自動操作から読み取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 승인하면 앞으로 5분 동안 한 번 로그인할 수 있습니다. 그런 다음 사이트의 로그인 필드에 있는 LocalGateKeys 아이콘을 클릭하고 로그인을 선택하세요. 비밀번호는 페이지로 전달되며, 페이지와 브라우저 자동화가 읽을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén keer goedkeuren staat één inlog toe in de komende 5 minuten. Klik daarna op het LocalGateKeys-pictogram in het inlogveld van de website en kies de login: de pagina krijgt het wachtwoord, waar de pagina en browserautomatisering het kunnen lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatwierdź raz pozwala na jedno logowanie w ciągu następnych 5 minut. Następnie kliknij ikonę LocalGateKeys w polu logowania witryny i wybierz login: strona otrzymuje hasło, gdzie strona i automatyzacja przeglądarki mogą je odczytać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprovar uma vez permite uma entrada nos próximos 5 minutos. Depois clique no ícone do LocalGateKeys no campo de login do site e escolha o login: a página recebe a senha, onde a página e a automação do navegador podem lê-la."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“仅批准一次”允许在接下来 5 分钟内登录一次。然后点按网站登录栏中的 LocalGateKeys 图标并选择登录项：页面会收到密码，页面和浏览器自动化都能读取它。"
          }
        }
      }
    },
