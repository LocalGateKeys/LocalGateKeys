    "settings.hideFromCapture.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Programme, Bildschirmaufnahmen und Videoanrufe können dieses Fenster nicht erfassen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other programs, screen recorders and video calls cannot capture this window"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otros programas, grabadores de pantalla y videollamadas no pueden capturar esta ventana"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autres programmes, enregistreurs d’écran et appels vidéo ne peuvent pas capturer cette fenêtre"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altri programmi, registratori dello schermo e videochiamate non possono acquisire questa finestra"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のプログラム、画面録画、ビデオ通話からこのウィンドウをキャプチャできなくします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 프로그램, 화면 녹화 도구, 화상 통화에서 이 창을 캡처할 수 없습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere programma's, schermopnames en videogesprekken kunnen dit venster niet vastleggen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inne programy, nagrywarki ekranu i rozmowy wideo nie mogą przechwycić tego okna"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outros programas, gravadores de tela e chamadas de vídeo não conseguem capturar esta janela"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他程序、屏幕录制工具和视频通话无法捕获此窗口"
          }
        }
      }
    },
    "settings.hideFromCapture.restart" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits geöffnete Fenster bleiben verborgen, bis Sie LocalGateKeys beenden und wieder öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows that are already open stay hidden until you quit and reopen LocalGateKeys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ventanas que ya están abiertas siguen ocultas hasta que cierres y vuelvas a abrir LocalGateKeys."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fenêtres déjà ouvertes restent masquées jusqu’à ce que vous quittiez et rouvriez LocalGateKeys."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le finestre già aperte restano nascoste finché non chiudi e riapri LocalGateKeys."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに開いているウインドウは、LocalGateKeys を終了して再度開くまで隠れたままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 열려 있는 창은 LocalGateKeys를 종료했다가 다시 열 때까지 숨겨진 상태로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vensters die al open zijn, blijven verborgen tot je LocalGateKeys afsluit en opnieuw opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okna, które są już otwarte, pozostaną ukryte, dopóki nie zamkniesz i ponownie nie otworzysz LocalGateKeys."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As janelas que já estão abertas continuam ocultas até você encerrar e abrir o LocalGateKeys de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已打开的窗口会保持隐藏，直到你退出并重新打开 LocalGateKeys。"
          }
        }
      }
    },
