          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederherstellungsphrase bestätigt. Bewahren Sie die aufgeschriebene Kopie versiegelt und getrennt von Ihren Backups auf; LocalGateKeys speichert sie nirgendwo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frase de recuperación confirmada. Mantén la copia escrita sellada y separada de tus copias de seguridad; LocalGateKeys no la guarda en ningún sitio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frase di recupero confermata. Tieni la copia scritta sigillata e separata dai backup; LocalGateKeys non la memorizza da nessuna parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リカバリーフレーズを確認しました。書き留めたものは封をして、バックアップとは別に保管してください。LocalGateKeysはどこにも保存していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구 문구를 확인했습니다. 적어 둔 사본은 봉인하여 백업과 따로 보관하세요. LocalGateKeys는 이 문구를 어디에도 저장하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herstelzin bevestigd. Houd de opgeschreven kopie verzegeld en gescheiden van je back-ups; LocalGateKeys slaat hem nergens op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fraza odzyskiwania potwierdzona. Trzymaj zapisaną kopię zapieczętowaną i osobno od kopii zapasowych; LocalGateKeys nigdzie jej nie przechowuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frase de recuperação confirmada. Mantenha a cópia escrita lacrada e separada dos seus backups; o LocalGateKeys não a guarda em lugar nenhum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复短语已确认。请将书面副本封存，并与备份分开保管；LocalGateKeys 不会在任何地方存储它。"
          }
        }
