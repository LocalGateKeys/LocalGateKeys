    },
    "sync.theKeyFileInThe5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schlüsseldatei im Synchronisierungsordner wurde durch eine ältere Kopie ersetzt und konnte nicht zurückgesetzt werden. Die Synchronisierung wurde angehalten. Prüfen Sie den Ordner oder setzen Sie die Synchronisierung auf diesem PC zurück und treten Sie erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
