    "That code is from a different device than the one this %@ is paired with. Nothing was changed. To sync with that device, leave sync and pair again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Code stammt von einem anderen Gerät als dem, mit dem dieses Gerät (%@) gekoppelt ist. Es wurde nichts geändert. Um mit jenem Gerät zu synchronisieren, verlassen Sie Sync und koppeln Sie erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese código es de un dispositivo distinto del que este %@ tiene emparejado. No se cambió nada. Para sincronizar con ese dispositivo, sal de la sincronización y vuelve a emparejar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
