    "Hidden fields are masked on screen and treated like passwords when exported." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verborgene Felder werden auf dem Bildschirm maskiert und beim Export wie Passwörter behandelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los campos ocultos se enmascaran en pantalla y se tratan como contraseñas al exportar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
