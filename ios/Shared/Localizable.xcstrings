    "sync.theNameOfInThe" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Name von %@ in der Schlüsseldatei konnte nicht gelesen werden; er wird als „Unbenanntes Gerät“ angezeigt. Die Synchronisierung wird fortgesetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
