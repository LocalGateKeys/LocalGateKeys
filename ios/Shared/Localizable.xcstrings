          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo de chave na pasta de sincronização está danificado. Redefina a sincronização neste iPad ou restaure a pasta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步文件夹中的密钥文件已损坏。请重置这台 iPad 上的同步，或恢复该文件夹。"
          }
        }
      }
    },
    "ipad.sync.theKeyFileInThe3" : {
      "comment" : "iPad wording of \"The key file in the sync folder is missing. Check the folde…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schlüsseldatei im Sync-Ordner fehlt. Prüfen Sie den Ordner oder setzen Sie Sync auf diesem iPad zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key file in the sync folder is missing. Check the folder, or reset sync on this iPad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta el archivo de claves de la carpeta de sincronización. Revisa la carpeta o restablece la sincronización en este iPad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de clé du dossier de synchronisation est introuvable. Vérifiez le dossier, ou réinitialisez la synchronisation sur cet iPad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file della chiave nella cartella di sincronizzazione manca. Controlla la cartella, oppure reimposta la sincronizzazione su questo iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期フォルダ内の鍵ファイルがありません。フォルダを確認するか、このiPadの同期をリセットしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화 폴더에 키 파일이 없습니다. 폴더를 확인하거나 이 iPad에서 동기화를 초기화하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het sleutelbestand in de synchronisatiemap ontbreekt. Controleer de map, of reset de synchronisatie op deze iPad."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brakuje pliku klucza w folderze synchronizacji. Sprawdź folder lub zresetuj synchronizację na tym iPadzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo de chave na pasta de sincronização está ausente. Verifique a pasta ou redefina a sincronização neste iPad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步文件夹中缺少密钥文件。请检查该文件夹，或重置这台 iPad 上的同步。"
          }
        }
      }
    },
    "ipad.sync.theKeyFileInThe5" : {
      "comment" : "iPad wording of \"The key file in the sync folder was replaced by an older co…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schlüsseldatei im Sync-Ordner wurde durch eine ältere Kopie ersetzt und konnte nicht zurückgelegt werden. Sync wurde beendet. Prüfen Sie den Ordner oder setzen Sie Sync auf diesem iPad zurück und treten Sie erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key file in the sync folder was replaced by an older copy and could not be put back. Sync stopped. Check the folder, or reset sync on this iPad and join again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de claves de la carpeta de sincronización fue reemplazado por una copia más antigua y no se pudo volver a poner. La sincronización se detuvo. Revisa la carpeta o restablece la sincronización en este iPad y únete de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de clé du dossier de synchronisation a été remplacé par une copie plus ancienne et n’a pas pu être remis en place. La synchronisation s’est arrêtée. Vérifiez le dossier, ou réinitialisez la synchronisation sur cet iPad et rejoignez de nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file della chiave nella cartella di sincronizzazione è stato sostituito da una copia meno recente e non è stato possibile rimetterlo a posto. La sincronizzazione si è fermata. Controlla la cartella, oppure reimposta la sincronizzazione su questo iPad e unisciti di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期フォルダ内の鍵ファイルが古いコピーに置き換えられ、元に戻せませんでした。同期を停止しました。フォルダを確認するか、このiPadの同期をリセットして、もう一度参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화 폴더의 키 파일이 이전 사본으로 교체되었고 되돌릴 수 없었습니다. 동기화가 중지되었습니다. 폴더를 확인하거나 이 iPad에서 동기화를 초기화하고 다시 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het sleutelbestand in de synchronisatiemap is door een oudere kopie vervangen en kon niet worden teruggezet. De synchronisatie is gestopt. Controleer de map, of reset de synchronisatie op deze iPad en voeg opnieuw toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik klucza w folderze synchronizacji został zastąpiony starszą kopią i nie udało się go przywrócić. Synchronizacja zatrzymana. Sprawdź folder lub zresetuj synchronizację na tym iPadzie i dołącz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo de chave na pasta de sincronização foi substituído por uma cópia mais antiga e não pôde ser recolocado. A sincronização parou. Verifique a pasta ou redefina a sincronização neste iPad e entre novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步文件夹中的密钥文件被较旧的副本替换，且无法恢复。同步已停止。请检查该文件夹，或重置这台 iPad 上的同步并重新加入。"
          }
        }
      }
    },
    "ipad.sync.theSyncFolderHadAn" : {
      "comment" : "iPad wording of \"The sync folder had an older or altered key file. This iPho…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sync-Ordner enthielt eine ältere oder veränderte Schlüsseldatei. Dieses iPad hat die vertrauenswürdige Kopie zurückgelegt; Sync läuft weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sync folder had an older or altered key file. This iPad put the trusted copy back; sync continues."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta de sincronización tenía un archivo de claves más antiguo o alterado. Este iPad volvió a poner la copia de confianza; la sincronización continúa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier de synchronisation contenait un fichier de clé plus ancien ou modifié. Cet iPad a remis en place la copie de confiance ; la synchronisation continue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartella di sincronizzazione conteneva un file della chiave meno recente o alterato. Questo iPad ha rimesso a posto la copia attendibile; la sincronizzazione continua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期フォルダの鍵ファイルが古いか、改ざんされていました。このiPadが信頼できるコピーを戻したため、同期は続行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화 폴더에 이전 버전이거나 변조된 키 파일이 있었습니다. 이 iPad가 신뢰하는 사본을 되돌렸으며 동기화는 계속됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De synchronisatiemap bevatte een ouder of gewijzigd sleutelbestand. Deze iPad heeft de vertrouwde kopie teruggezet; de synchronisatie gaat door."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder synchronizacji zawierał starszy lub zmieniony plik klucza. Ten iPad przywrócił zaufaną kopię; synchronizacja trwa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta de sincronização tinha um arquivo de chave mais antigo ou alterado. Este iPad recolocou a cópia confiável; a sincronização continua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步文件夹中的密钥文件较旧或被改动过。这台 iPad 已放回可信的副本；同步继续进行。"
          }
        }
      }
    },
    "ipad.sync.theSyncKeyInThat" : {
      "comment" : "iPad wording of \"The sync key in that folder changed after this iPhone was p…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sync-Schlüssel in diesem Ordner hat sich geändert, nachdem dieses iPad gekoppelt wurde. Verlassen Sie Sync auf diesem iPad und verwenden Sie dann „Ordner beitreten“ mit dem aktuellen Sync-Passwort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sync key in that folder changed after this iPad was paired. Leave sync on this iPad, then use Join a folder with the current sync password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave de sincronización de esa carpeta cambió después de emparejar este iPad. Sal de la sincronización en este iPad y usa Unirse a una carpeta con la contraseña de sincronización actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé de synchronisation de ce dossier a changé après l’association de cet iPad. Quittez la synchronisation sur cet iPad, puis utilisez Rejoindre un dossier avec le mot de passe de synchronisation actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave di sincronizzazione in quella cartella è cambiata dopo l'associazione di questo iPad. Esci dalla sincronizzazione su questo iPad, poi usa Unisciti a una cartella con la password di sincronizzazione attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPadのペアリング後に、そのフォルダの同期鍵が変更されました。このiPadの同期から退出してから、現在の同期パスワードで「フォルダに参加」を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPad가 페어링된 후 해당 폴더의 동기화 키가 변경되었습니다. 이 iPad의 동기화를 나간 다음 현재 동기화 비밀번호로 폴더 참여를 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De synchronisatiesleutel in die map is gewijzigd nadat deze iPad was gekoppeld. Verlaat de synchronisatie op deze iPad en gebruik daarna Een map toevoegen met het huidige synchronisatiewachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucz synchronizacji w tym folderze zmienił się po sparowaniu tego iPada. Opuść synchronizację na tym iPadzie, a potem użyj Dołącz do folderu z aktualnym hasłem synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave de sincronização dessa pasta mudou depois que este iPad foi pareado. Saia da sincronização neste iPad e use Entrar em uma pasta com a senha de sincronização atual."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该文件夹中的同步密钥在这台 iPad 配对后发生了变化。请退出这台 iPad 上的同步，然后使用当前的同步密码“加入文件夹”。"
          }
        }
      }
    },
