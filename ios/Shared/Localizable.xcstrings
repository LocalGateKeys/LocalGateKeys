        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Documenten in andere apps openen\" staat uit. Zet het aan om dit bestand te openen, of gebruik Kopie opslaan… in plaats daarvan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opcja „Otwieraj dokumenty w innych aplikacjach” jest wyłączona. Włącz ją, aby otworzyć ten plik, lub użyj zamiast tego opcji Zapisz kopię…."
