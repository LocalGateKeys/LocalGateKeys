    "whatsNew.1.2.security.detail" : {
      "comment" : "What's new 1.2 sheet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkennen Sie Logins auf Websites ohne HTTPS und Websites, die Zwei-Faktor-Codes oder Passkeys anbieten, die Sie noch nicht nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spot logins on sites without HTTPS, and sites that offer two-factor codes or passkeys you don't use yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detecta inicios de sesión en sitios sin HTTPS y sitios que ofrecen códigos de dos factores o llaves de acceso que aún no usas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repérez les identifiants sur des sites sans HTTPS, et les sites qui proposent des codes à deux facteurs ou des clés d’accès que vous n’utilisez pas encore."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Individua i login su siti senza HTTPS e i siti che offrono codici a due fattori o passkey che non usi ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS のないサイトのログインや、まだ使っていない 2 段階認証コードやパスキーに対応したサイトがわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPS가 없는 사이트의 로그인과, 아직 사용하지 않는 2단계 인증 코드나 패스키를 지원하는 사이트를 찾아 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie logins op sites zonder HTTPS, en sites die tweestapscodes of passkeys bieden die je nog niet gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykrywaj loginy na stronach bez HTTPS oraz strony oferujące kody dwuskładnikowe lub klucze dostępu, których jeszcze nie używasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre logins em sites sem HTTPS e sites que oferecem códigos de dois fatores ou chaves de acesso que você ainda não usa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找出没有 HTTPS 的网站上的登录项,以及提供你尚未使用的双重验证码或通行密钥的网站。"
          }
        }
      }
    },
