    "Bring your logins over from another password manager or browser. On iOS 26, open Apple Passwords and choose Export Data to Another App, or import a file exported from Bitwarden, 1Password, KeePass and others." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holen Sie Ihre Anmeldungen aus einem anderen Passwortmanager oder Browser herüber. Öffnen Sie unter iOS 26 Apple Passwörter und wählen Sie „Daten in andere App exportieren“, oder importieren Sie eine aus Bitwarden, 1Password, KeePass und anderen exportierte Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trae tus inicios de sesión de otro gestor de contraseñas o navegador. En iOS 26, abre Contraseñas de Apple y elige Exportar datos a otra app, o importa un archivo exportado de Bitwarden, 1Password, KeePass y otros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez vos identifiants depuis un autre gestionnaire de mots de passe ou un navigateur. Sur iOS 26, ouvrez Mots de passe et choisissez Exporter les données vers une autre app, ou importez un fichier exporté depuis Bitwarden, 1Password, KeePass et d’autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta qui i tuoi accessi da un altro gestore di password o browser. Su iOS 26, apri Password di Apple e scegli Esporta dati in un'altra app, oppure importa un file esportato da Bitwarden, 1Password, KeePass e altri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のパスワードマネージャやブラウザからログインを取り込みます。iOS 26では、パスワードアプリを開いて「別のAppにデータを書き出す」を選ぶか、Bitwarden、1Password、KeePassなどから書き出したファイルをインポートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 비밀번호 관리자나 브라우저에서 로그인을 가져옵니다. iOS 26에서는 Apple 암호를 열어 다른 앱으로 데이터 내보내기를 선택하거나, Bitwarden, 1Password, KeePass 등에서 내보낸 파일을 가져오세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haal je logins binnen uit een andere wachtwoordmanager of browser. Open op iOS 26 Apple Wachtwoorden en kies Exporteer gegevens naar een andere app, of importeer een bestand dat is geëxporteerd uit Bitwarden, 1Password, KeePass en andere."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenieś loginy z innego menedżera haseł lub przeglądarki. W iOS 26 otwórz Apple Passwords i wybierz Eksportuj dane do innej aplikacji albo zaimportuj plik wyeksportowany z Bitwarden, 1Password, KeePass i innych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traga seus logins de outro gerenciador de senhas ou navegador. No iOS 26, abra as Senhas da Apple e escolha Exportar Dados para Outro App, ou importe um arquivo exportado do Bitwarden, 1Password, KeePass e outros."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从其他密码管理器或浏览器导入您的登录。在 iOS 26 上，请打开“密码”应用并选择“将数据导出到其他 App”，或导入从 Bitwarden、1Password、KeePass 等导出的文件。"
          }
        }
      }
    },
    "Browser" : {
      "extractionState" : "manual",
      "localizations" : {
