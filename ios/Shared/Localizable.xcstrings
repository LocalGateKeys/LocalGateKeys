    "ipad.sync.anotherDeviceRunsANewer" : {
      "comment" : "iPad wording of \"Another device runs a newer Wi-Fi sync. Update LocalGateKey…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderes Gerät verwendet eine neuere WLAN-Synchronisierung. Aktualisieren Sie LocalGateKeys auf diesem iPad."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
