          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus elementos se quedan como están; solo cambia la contraseña que los abre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos éléments restent tels quels ; seul le mot de passe qui les ouvre change."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi elementi restano come sono; cambia solo la password che li apre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目はそのままで、それらを開くパスワードのみが変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목은 그대로 유지되며 항목을 여는 비밀번호만 변경됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je items blijven zoals ze zijn; alleen het wachtwoord waarmee ze worden geopend, verandert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje elementy zostają bez zmian; zmienia się tylko hasło, które je otwiera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus itens continuam como estão; só a senha que os abre muda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的项目保持不变；只有用于打开它们的密码会更改。"
          }
        }
      }
    },
    "Your last backup is more than 7 days old. Back up again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr letztes Backup ist älter als 7 Tage. Erstellen Sie erneut ein Backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu última copia de seguridad tiene más de 7 días. Haz otra copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre dernière sauvegarde date de plus de 7 jours. Sauvegardez de nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo ultimo backup ha più di 7 giorni. Esegui di nuovo il backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後のバックアップから7日以上経っています。もう一度バックアップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 백업이 7일이 넘었습니다. 다시 백업하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je laatste back-up is meer dan 7 dagen oud. Maak opnieuw een back-up."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja ostatnia kopia zapasowa ma ponad 7 dni. Wykonaj ją ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu último backup tem mais de 7 dias. Faça backup novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您上次备份已超过 7 天。请再次备份。"
          }
        }
      }
    },
    "Your new master password is set. The same recovery phrase still opens the vault. Touch ID was turned off; turn it on again in Settings if you use it. Old backups keep their old contents under the old master password, so protect or replace them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr neues Master-Passwort ist festgelegt. Dieselbe Wiederherstellungsphrase öffnet den Tresor weiterhin. Touch ID wurde ausgeschaltet; aktivieren Sie es in den Einstellungen wieder, falls Sie es verwenden. Alte Backups behalten ihren alten Inhalt unter dem alten Master-Passwort, schützen oder ersetzen Sie sie daher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu nueva contraseña maestra está establecida. La misma frase de recuperación sigue abriendo la bóveda. Touch ID se desactivó; vuelve a activarlo en Ajustes si lo usas. Las copias de seguridad antiguas conservan su contenido antiguo bajo la contraseña maestra anterior, así que protégelas o reemplázalas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre nouveau mot de passe principal est défini. La même phrase de récupération ouvre toujours le coffre-fort. Touch ID a été désactivé ; réactivez-le dans Réglages si vous l’utilisez. Les anciennes sauvegardes gardent leur ancien contenu sous l’ancien mot de passe principal ; protégez-les ou remplacez-les."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua nuova password principale è impostata. La stessa frase di recupero apre ancora la cassaforte. Touch ID è stato disattivato; riattivalo in Impostazioni se lo usi. I vecchi backup mantengono il loro vecchio contenuto con la vecchia password principale, quindi proteggili o sostituiscili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいマスターパスワードを設定しました。同じリカバリーフレーズで、引き続き保管庫を開けます。Touch IDはオフになりました。使う場合は、設定でもう一度オンにしてください。古いバックアップは、古いマスターパスワードのもとで古い内容のままなので、保護するか置き換えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 마스터 비밀번호가 설정되었습니다. 같은 복구 문구로 계속 보관함을 열 수 있습니다. Touch ID가 꺼졌으니 사용한다면 설정에서 다시 켜세요. 이전 백업은 이전 마스터 비밀번호 아래 이전 내용을 그대로 유지하므로 보호하거나 교체하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je nieuwe hoofdwachtwoord is ingesteld. Dezelfde herstelzin opent de kluis nog steeds. Touch ID is uitgeschakeld; schakel het in Instellingen weer in als je het gebruikt. Oude back-ups behouden hun oude inhoud onder het oude hoofdwachtwoord, dus beveilig of vervang ze."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje nowe hasło główne zostało ustawione. Ta sama fraza odzyskiwania nadal otwiera sejf. Touch ID zostało wyłączone; włącz je ponownie w Ustawieniach, jeśli z niego korzystasz. Stare kopie zapasowe zachowują swoją zawartość pod starym hasłem głównym, więc zabezpiecz je lub zastąp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua nova senha mestra foi definida. A mesma frase de recuperação ainda abre o cofre. O Touch ID foi desativado; ative-o novamente em Ajustes, se você o usa. Os backups antigos mantêm o conteúdo antigo com a senha mestra antiga, então proteja-os ou substitua-os."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的新主密码已设置。同一个恢复短语仍可打开保管库。Touch ID 已关闭；如果您使用它，请在“设置”中重新开启。旧备份在旧主密码下保留其原有内容，因此请保护或替换它们。"
          }
        }
      }
    },
    "Your other devices get the restored vault the next time they sync" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
