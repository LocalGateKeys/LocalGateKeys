    "Import the file into the destination app right away, then delete it. Cloud-synced folders and backups may keep copies." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importieren Sie die Datei sofort in die Ziel-App und löschen Sie sie dann. In Cloud-synchronisierten Ordnern und in Backups können Kopien erhalten bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa el archivo en la app de destino de inmediato y luego elimínalo. Las carpetas sincronizadas en la nube y las copias de seguridad pueden conservar copias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez aussitôt le fichier dans l'app de destination, puis supprimez-le. Les dossiers synchronisés avec le cloud et les sauvegardes peuvent en garder des copies."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa subito il file nell'app di destinazione, poi eliminalo. Le cartelle sincronizzate nel cloud e i backup possono conservarne delle copie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すぐにこのファイルを移行先のアプリにインポートし、その後ファイルを削除してください。クラウド同期されたフォルダーやバックアップにコピーが残る場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일을 대상 앱으로 즉시 가져온 다음 삭제하세요. 클라우드 동기화 폴더와 백업에 사본이 남아 있을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importeer het bestand direct in de doel-app en verwijder het daarna. Mappen met cloudsynchronisatie en back-ups kunnen kopieën bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaimportuj plik do aplikacji docelowej od razu, a potem go usuń. Foldery synchronizowane z chmurą i kopie zapasowe mogą zachować kopie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe o arquivo no app de destino imediatamente e depois exclua-o. Pastas sincronizadas na nuvem e backups podem manter cópias."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请立即将该文件导入目标应用，然后删除它。云同步文件夹和备份可能保留副本。"
          }
        }
      }
    },
