    "Copies a 2FA code you pinned in LocalGateKeys. The clipboard clears itself after the time chosen in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiert einen 2FA-Code, den du in LocalGateKeys angeheftet hast. Die Zwischenablage leert sich nach der in den Einstellungen gewählten Zeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia un código 2FA que fijaste en LocalGateKeys. El portapapeles se vacía solo tras el tiempo elegido en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie un code 2FA que vous avez épinglé dans LocalGateKeys. Le presse-papiers se vide après le délai choisi dans les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia un codice 2FA che hai fissato in LocalGateKeys. Gli appunti si svuotano dopo il tempo scelto nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeysで固定した2FAコードをコピーします。クリップボードは設定で選んだ時間が過ぎると消去されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys에서 고정한 2FA 코드를 복사합니다. 클립보드는 설정에서 고른 시간이 지나면 지워집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieert een 2FA-code die je in LocalGateKeys hebt vastgezet. Het klembord wordt gewist na de tijd die je in Instellingen kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiuje kod 2FA przypięty w LocalGateKeys. Schowek czyści się po czasie wybranym w Ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia um código 2FA que você fixou no LocalGateKeys. A área de transferência é limpa após o tempo escolhido em Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拷贝你在 LocalGateKeys 中固定的 2FA 验证码。剪贴板会在设置中选定的时间后自动清除。"
          }
        }
      }
    },
    "Copies made as you save. Older ones may still hold deleted items." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
