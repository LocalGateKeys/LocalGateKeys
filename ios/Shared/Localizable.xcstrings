        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスは%@に期限切れになりました。使うたびに本人確認が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 접근이 만료되었습니다. 사용할 때마다 본인 확인이 필요합니다."
