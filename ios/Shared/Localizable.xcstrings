          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedido enviado. Os dispositivos do titular podem recusá-lo durante o período de espera (%lld dias)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
