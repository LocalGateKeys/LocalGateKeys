    "If you don't recognise it, choose Undo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie es nicht erkennen, wählen Sie „Rückgängig“."
