    "sync.thisPcMissedAPassword" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser PC hat eine Passwortänderung verpasst. Treten Sie dem Ordner mit dem aktuellen Synchronisierungspasswort erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This PC missed a password change. Join the folder again with the current sync password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PC se perdió un cambio de contraseña. Vuelve a unirte a la carpeta con la contraseña de sincronización actual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo PC ha perso un cambio di password. Unisciti di nuovo alla cartella con la password di sincronizzazione attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このPCは、パスワードの変更を受け取れませんでした。現在の同期パスワードで、もう一度フォルダーに参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 PC가 비밀번호 변경을 놓쳤습니다. 현재 동기화 비밀번호로 폴더에 다시 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze pc heeft een wachtwoordwijziging gemist. Sluit opnieuw aan bij de map met het huidige synchronisatiewachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten komputer przegapił zmianę hasła. Dołącz do folderu ponownie z bieżącym hasłem synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PC perdeu uma alteração de senha. Entre na pasta novamente com a senha de sincronização atual."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台电脑错过了一次密码更改。请使用当前的同步密码重新加入该文件夹。"
          }
        }
      }
    },
