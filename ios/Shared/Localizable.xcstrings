    "Locks the vault when you have not touched the app for this long, even while it is open on screen." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperrt den Tresor, wenn Sie die App so lange nicht berührt haben, auch wenn sie noch auf dem Bildschirm geöffnet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea la caja fuerte cuando no has tocado la app durante este tiempo, incluso si sigue abierta en pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouille le coffre lorsque vous n’avez pas touché l’app pendant cette durée, même si elle est ouverte à l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocca la cassaforte quando non tocchi l’app per questo tempo, anche se è aperta sullo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを画面に開いたままでも、この時間操作しないと保管庫をロックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 화면에 열려 있더라도 이 시간 동안 앱을 만지지 않으면 보관함을 잠급니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergrendelt de kluis als je de app zo lang niet hebt aangeraakt, ook als hij nog open op het scherm staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokuje sejf, gdy przez tak długi czas nie dotykasz aplikacji, nawet jeśli jest otwarta na ekranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueia o cofre quando você não toca no app por esse tempo, mesmo com ele aberto na tela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使应用仍在屏幕上打开，只要这么长时间没有触碰应用，就会锁定保险库。"
          }
        }
      }
    },
