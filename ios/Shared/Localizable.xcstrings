          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes dispositivos foram adicionados a este grupo de sincronização por outro dispositivo. Se forem seus, escolha Estes são meus dispositivos. Os dispositivos que você não confirmou perdem o acesso na próxima troca da chave de sincronização."
          }
