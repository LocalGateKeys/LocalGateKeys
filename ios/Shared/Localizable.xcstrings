    "Every entry links to the one before it; nothing was changed or removed." : {
      "comment" : "Security centre: access log check",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Eintrag ist mit dem vorherigen verknüpft; nichts wurde geändert oder entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada entrada está enlazada con la anterior; no se cambió ni se quitó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque entrée est liée à la précédente ; rien n'a été modifié ni supprimé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni voce è collegata alla precedente; nulla è stato modificato o rimosso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各エントリは前のエントリにつながっています。変更や削除はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 항목이 이전 항목과 연결되어 있으며 변경되거나 삭제된 것이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke regel is gekoppeld aan de vorige; er is niets gewijzigd of verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy wpis jest powiązany z poprzednim; nic nie zmieniono ani nie usunięto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada entrada está ligada à anterior; nada foi alterado ou removido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每条记录都与上一条相连，没有任何内容被更改或删除。"
          }
        }
      }
    },
    "Every item here is deleted for good. This cannot be undone." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Eintrag hier wird endgültig gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
