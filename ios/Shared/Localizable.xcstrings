    "ipad.appPasswordSettings.localgatekeysOpensOnlyWith" : {
      "comment" : "iPad wording of \"On: LocalGateKeys opens only with the app password, your re…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An: LocalGateKeys öffnet sich nur mit dem App-Passwort, Ihrer Wiederherstellungsphrase oder (falls an) Face ID. Der iPad-Code kann es nicht öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On: LocalGateKeys opens only with the app password, your recovery phrase, or (if on) Face ID. The iPad passcode cannot open it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado: LocalGateKeys solo se abre con la contraseña de la app, tu frase de recuperación o (si está activado) Face ID. El código del iPad no puede abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activé : LocalGateKeys ne s’ouvre qu’avec le mot de passe de l’app, votre phrase de récupération ou (si activé) Face ID. Le code de l’iPad ne peut pas l’ouvrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attivato: LocalGateKeys si apre solo con la password per app, la frase di recupero o (se attivo) Face ID. Il codice dell'iPad non può aprirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オン: LocalGateKeysは、アプリパスワード、リカバリーフレーズ、または(オンの場合)Face IDでのみ開きます。iPadのパスコードでは開けません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜짐: LocalGateKeys는 앱 비밀번호, 복구 문구 또는 (켜져 있다면) Face ID로만 열립니다. iPad 암호로는 열 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aan: LocalGateKeys opent alleen met het app-wachtwoord, je herstelzin of (indien aan) Face ID. De toegangscode van de iPad kan het niet openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włączone: LocalGateKeys otwiera się tylko za pomocą hasła aplikacji, frazy odzyskiwania lub (jeśli włączone) Face ID. Kod dostępu do iPada go nie otworzy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativado: o LocalGateKeys só abre com a senha do app, sua frase de recuperação ou (se ativado) o Face ID. O código do iPad não o abre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已开启：LocalGateKeys 只能通过应用密码、您的恢复短语或（若已开启）Face ID 打开。iPad 锁屏密码无法打开它。"
          }
        }
      }
    },
    "ipad.appPasswordSettings.offAnyoneWhoKnows" : {
      "comment" : "iPad wording of \"Off: anyone who knows this iPhone's passcode can open Local…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus: Jeder, der den Code dieses iPads kennt, kann LocalGateKeys öffnen. Ein App-Passwort verhindert das: Der Code allein kann den Tresor dann nicht mehr öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Off: anyone who knows this iPad's passcode can open LocalGateKeys. An app password closes that: the passcode alone can no longer open the vault."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado: cualquiera que conozca el código de este iPad puede abrir LocalGateKeys. Una contraseña de la app lo evita: el código por sí solo ya no puede abrir la bóveda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé : toute personne qui connaît le code de cet iPad peut ouvrir LocalGateKeys. Un mot de passe d’app l’empêche : le code seul ne peut plus ouvrir le coffre-fort."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivato: chiunque conosca il codice di questo iPad può aprire LocalGateKeys. Una password per app lo impedisce: il solo codice non può più aprire la cassaforte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ: このiPadのパスコードを知っている人なら誰でもLocalGateKeysを開けます。アプリパスワードを設定すると、パスコードだけでは保管庫を開けなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "꺼짐: 이 iPad의 암호를 아는 사람은 누구나 LocalGateKeys를 열 수 있습니다. 앱 비밀번호를 설정하면 암호만으로는 더 이상 보관함을 열 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit: iedereen die de toegangscode van deze iPad kent, kan LocalGateKeys openen. Een app-wachtwoord verhelpt dat: de toegangscode alleen kan de kluis dan niet meer openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyłączone: każdy, kto zna kod dostępu do tego iPada, może otworzyć LocalGateKeys. Hasło aplikacji to zamyka: sam kod dostępu nie otworzy już sejfu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado: qualquer pessoa que saiba o código deste iPad pode abrir o LocalGateKeys. Uma senha do app evita isso: só o código não abre mais o cofre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已关闭：任何知道这台 iPad 锁屏密码的人都能打开 LocalGateKeys。应用密码可以防止这一点：仅凭锁屏密码将无法再打开保管库。"
          }
        }
      }
    },
