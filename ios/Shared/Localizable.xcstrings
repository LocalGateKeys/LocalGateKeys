      }
    },
    "ipad.sync.thisPcHasAnOlder2" : {
      "comment" : "iPad wording of \"This iPhone has an older sync key than %@. Let the cloud fo…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPad hat einen älteren Sync-Schlüssel als %@. Lassen Sie den Cloud-Ordner zu Ende synchronisieren oder treten Sie dem Ordner mit dem neuesten Sync-Passwort erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPad has an older sync key than %@. Let the cloud folder finish syncing, or join the folder again with the newest sync password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPad tiene una clave de sincronización más antigua que %@. Deja que la carpeta en la nube termine de sincronizar, o únete de nuevo a la carpeta con la contraseña de sincronización más reciente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPad a une clé de synchronisation plus ancienne que %@. Laissez le dossier cloud terminer sa synchronisation, ou rejoignez de nouveau le dossier avec le mot de passe de synchronisation le plus récent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo iPad ha una chiave di sincronizzazione meno recente di %@. Lascia che la cartella cloud finisca di sincronizzarsi, oppure unisciti di nuovo alla cartella con la password di sincronizzazione più recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPadの同期鍵は%@より古くなっています。クラウドフォルダの同期が完了するのを待つか、最新の同期パスワードでもう一度フォルダに参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPad의 동기화 키가 %@보다 오래되었습니다. 클라우드 폴더의 동기화가 끝나기를 기다리거나 최신 동기화 비밀번호로 폴더에 다시 참여하세요."
