    "collectionShare.removeHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kennt das aktuelle Freigabepasswort, daher braucht das Entfernen ein neues. Die anderen synchronisieren weiter, ohne es einzugeben; geben Sie es nur Personen, die Sie später einladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ knows the current share password, so removing them needs a new one. The others keep syncing without typing it; give it only to people you invite later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ conoce la contraseña actual, así que para quitarle hace falta una nueva. Los demás siguen sincronizando sin escribirla; dásela solo a quien invites más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ connaît le mot de passe de partage actuel ; pour le retirer, il en faut donc un nouveau. Les autres continuent la synchronisation sans le saisir ; donnez-le seulement aux personnes que vous inviterez plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ conosce la password di condivisione attuale, quindi per rimuoverla ne serve una nuova. Gli altri continuano la sincronizzazione senza digitarla; dalla solo a chi inviterai in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は現在の共有パスワードを知っているため、削除するには新しいパスワードが必要です。ほかの人は入力しなくても同期を続けられます。新しいパスワードは、今後招待する人にだけ伝えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 현재 공유 비밀번호를 알고 있으므로 제거하려면 새 비밀번호가 필요합니다. 다른 사람들은 입력하지 않아도 동기화를 계속하니, 새 비밀번호는 나중에 초대할 사람에게만 알려 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kent het huidige deelwachtwoord, dus voor het verwijderen is een nieuw wachtwoord nodig. De anderen blijven synchroniseren zonder het te typen; geef het alleen aan mensen die je later uitnodigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zna obecne hasło udostępniania, więc usunięcie wymaga nowego. Pozostali nadal korzystają z synchronizacji bez wpisywania go; podaj je tylko osobom, które zaprosisz później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ conhece a senha de compartilhamento atual, então remover essa pessoa exige uma nova. Os outros continuam a sincronização sem digitá-la; passe-a só para quem você convidar depois."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 知道当前的共享密码，因此移除此人需要新密码。其他人无需输入即可继续同步；只把新密码告诉以后邀请的人。"
          }
        }
      }
    },
    "collectionShare.removeText" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ erhält keine Änderungen an „%2$@“ mehr, und die Kopien der Einträge wandern dort in den Papierkorb. Da %1$@ das aktuelle Freigabepasswort kennt, bekommt die Sammlung das neue Freigabepasswort, das Sie eingegeben haben. Die anderen synchronisieren weiter, ohne es einzugeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ will stop receiving changes to “%2$@”, and their copies of its items will move to their trash. Because %1$@ knows the current share password, the collection gets the new share password you typed. The others keep syncing without typing it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ dejará de recibir cambios de «%2$@» y sus copias de los elementos irán a su papelera. Como %1$@ conoce la contraseña actual, la colección recibe la nueva contraseña que escribiste. Los demás siguen sincronizando sin escribirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ne recevra plus les modifications de « %2$@ », et ses copies des éléments iront dans sa corbeille. Comme %1$@ connaît le mot de passe de partage actuel, la collection reçoit le nouveau mot de passe de partage que vous avez saisi. Les autres continuent la synchronisation sans le saisir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ non riceverà più le modifiche a «%2$@» e le sue copie degli elementi finiranno nel suo cestino. Poiché %1$@ conosce la password di condivisione attuale, la raccolta riceve la nuova password di condivisione che hai digitato. Gli altri continuano la sincronizzazione senza digitarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は「%2$@」の変更を受け取らなくなり、その項目のコピーはその人のごみ箱に移動します。%1$@は現在の共有パスワードを知っているため、コレクションには入力した新しい共有パスワードが設定されます。ほかの人は入力しなくても同期を続けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) 더 이상 “%2$@”의 변경 사항을 받지 않으며, 해당 항목의 사본은 그 사람의 휴지통으로 이동합니다. %1$@이(가) 현재 공유 비밀번호를 알고 있으므로 컬렉션에는 입력한 새 공유 비밀번호가 적용됩니다. 다른 사람들은 입력하지 않아도 동기화를 계속합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ krijgt geen wijzigingen aan “%2$@” meer, en de kopieën van de items gaan naar de eigen prullenbak. Omdat %1$@ het huidige deelwachtwoord kent, krijgt de verzameling het nieuwe deelwachtwoord dat je hebt getypt. De anderen blijven synchroniseren zonder het te typen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ przestanie otrzymywać zmiany w „%2$@”, a kopie elementów trafią do kosza tej osoby. Ponieważ %1$@ zna obecne hasło udostępniania, kolekcja dostaje wpisane przez Ciebie nowe hasło udostępniania. Pozostali nadal korzystają z synchronizacji bez wpisywania go."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ deixará de receber as alterações de “%2$@”, e as cópias dos itens irão para a lixeira dessa pessoa. Como %1$@ conhece a senha de compartilhamento atual, a coleção recebe a nova senha de compartilhamento que você digitou. Os outros continuam a sincronização sem digitá-la."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 将不再收到“%2$@”的更改，其项目副本会移到其回收站。由于 %1$@ 知道当前的共享密码，集合将改用您输入的新共享密码。其他人无需输入即可继续同步。"
          }
        }
      }
    },
