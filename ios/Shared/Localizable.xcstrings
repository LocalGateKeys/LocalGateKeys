          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近のバックアップがありません。所有者のアプリはプランの作成後、共有フォルダーにバックアップを書き込んでいません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 백업이 없습니다. 계획을 만든 뒤 소유자의 앱이 공유 폴더에 백업을 쓰지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen recente back-up: de app van de eigenaar heeft sinds het plan geen back-up naar de gedeelde map geschreven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak aktualnej kopii zapasowej: aplikacja właściciela nie zapisała żadnej kopii zapasowej w udostępnionym folderze od utworzenia planu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum backup recente: o app do titular não gravou nenhum backup na pasta compartilhada desde a criação do plano."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
