    "Face ID is locked after too many attempts. Lock and unlock your iPhone with its passcode, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID ist nach zu vielen Versuchen gesperrt. Sperren und entsperren Sie Ihr iPhone mit dem Code und versuchen Sie es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID está bloqueado por demasiados intentos. Bloquea y desbloquea tu iPhone con su código y vuelve a intentarlo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID è bloccato dopo troppi tentativi. Blocca e sblocca il tuo iPhone con il suo codice, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試行回数が多すぎたため、Face IDがロックされました。iPhoneをロックしてからパスコードで解除し、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시도 횟수가 너무 많아 Face ID가 잠겼습니다. iPhone을 잠갔다가 암호로 잠금 해제한 다음 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID is vergrendeld na te veel pogingen. Vergrendel je iPhone en ontgrendel hem met je toegangscode, en probeer het daarna opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID jest zablokowane po zbyt wielu próbach. Zablokuj i odblokuj iPhone'a kodem dostępu, a potem spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Face ID está bloqueado após muitas tentativas. Bloqueie e desbloqueie o iPhone com o código dele e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多次尝试后，Face ID 已被锁定。请用锁屏密码锁定并解锁 iPhone，然后重试。"
          }
        }
      }
    },
