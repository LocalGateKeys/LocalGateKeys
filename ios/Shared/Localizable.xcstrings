    "settings.autoSync.desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiert, wenn du LocalGateKeys entsperrst, wenn du zur App zurückkehrst und nachdem du etwas geändert hast. Aus: Es wird nur synchronisiert, wenn du „Jetzt synchronisieren“ wählst oder zum Aktualisieren nach unten ziehst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syncs when you unlock LocalGateKeys, when you come back to it and after you change something. Off: it syncs only when you choose Sync now or pull down to refresh."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza cuando desbloqueas LocalGateKeys, cuando vuelves a la app y después de cambiar algo. Desactivado: solo sincroniza cuando eliges Sincronizar ahora o deslizas hacia abajo para actualizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronise lorsque vous déverrouillez LocalGateKeys, lorsque vous revenez dans l’app et après une modification. Désactivé : la synchronisation n’a lieu que lorsque vous choisissez Synchroniser maintenant ou tirez vers le bas pour actualiser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizza quando sblocchi LocalGateKeys, quando torni all’app e dopo una modifica. Disattivato: sincronizza solo quando scegli Sincronizza ora o trascini verso il basso per aggiornare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeysのロックを解除したとき、アプリに戻ったとき、変更を加えたあとに同期します。オフ:「今すぐ同期」を選ぶか、下に引いて更新したときだけ同期します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys를 잠금 해제할 때, 앱으로 돌아올 때, 항목을 변경한 뒤에 동기화합니다. 끔: ‘지금 동기화’를 선택하거나 아래로 당겨 새로 고칠 때만 동기화합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchroniseert wanneer je LocalGateKeys ontgrendelt, wanneer je terugkomt in de app en nadat je iets hebt gewijzigd. Uit: er wordt alleen gesynchroniseerd wanneer je Nu synchroniseren kiest of omlaag trekt om te vernieuwen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizuje po odblokowaniu LocalGateKeys, po powrocie do aplikacji i po wprowadzeniu zmian. Wyłączone: synchronizacja odbywa się tylko po wybraniu Synchronizuj teraz lub przeciągnięciu w dół, aby odświeżyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincroniza quando você desbloqueia o LocalGateKeys, quando volta ao app e depois de alterar algo. Desativado: sincroniza apenas quando você escolhe Sincronizar agora ou puxa para baixo para atualizar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解锁 LocalGateKeys 时、返回 App 时以及更改内容后进行同步。关闭：仅在你选择“立即同步”或下拉刷新时同步。"
          }
        }
      }
    },
