    "sync.thisSyncFolderNowHolds" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Synchronisierungsordner enthält jetzt eine andere Synchronisierungsgruppe. Die Synchronisierung wurde angehalten, und es wurde nichts geschrieben. Verlassen Sie die Synchronisierung oder setzen Sie sie auf diesem PC zurück und treten Sie dann dem richtigen Ordner bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This sync folder now holds a different sync group. Sync stopped and nothing was written. Leave sync, or reset sync on this PC, then join the right folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta carpeta de sincronización ahora contiene un grupo de sincronización distinto. La sincronización se detuvo y no se escribió nada. Sal de la sincronización, o restablece la sincronización en este PC, y luego únete a la carpeta correcta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa cartella di sincronizzazione ora contiene un altro gruppo di sincronizzazione. Sincronizzazione interrotta e nulla è stato scritto. Esci dalla sincronizzazione, oppure reimposta la sincronizzazione su questo PC, poi unisciti alla cartella giusta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この同期フォルダーに、別の同期グループが入っています。同期を停止し、何も書き込みませんでした。同期から退出するか、このPCの同期をリセットしてから、正しいフォルダーに参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 동기화 폴더에 이제 다른 동기화 그룹이 있습니다. 동기화가 중지되었으며 아무것도 기록되지 않았습니다. 동기화를 나가거나 이 PC에서 동기화를 초기화한 다음 올바른 폴더에 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze synchronisatiemap bevat nu een andere synchronisatiegroep. Synchronisatie gestopt en er is niets geschreven. Verlaat de synchronisatie, of reset de synchronisatie op deze pc, en sluit dan aan bij de juiste map."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten folder synchronizacji zawiera teraz inną grupę synchronizacji. Synchronizacja zatrzymana i nic nie zapisano. Opuść synchronizację lub zresetuj synchronizację na tym komputerze, a potem dołącz do właściwego folderu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta pasta de sincronização agora contém um grupo de sincronização diferente. A sincronização parou e nada foi gravado. Saia da sincronização, ou redefina a sincronização neste PC, e depois entre na pasta certa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此同步文件夹现在包含另一个同步组。同步已停止，且未写入任何内容。请退出同步，或重置这台电脑上的同步，然后加入正确的文件夹。"
          }
        }
      }
    },
