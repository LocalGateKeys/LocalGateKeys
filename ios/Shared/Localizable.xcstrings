    "sync.thisPcHasAnOlder" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser PC hat einen älteren Synchronisierungsschlüssel als %@. Verlassen Sie die Synchronisierung auf diesem PC und koppeln Sie ihn dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This PC has an older sync key than %@. Leave sync on this PC, then pair it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PC tiene una clave de sincronización más antigua que %@. Sal de la sincronización en este PC y luego empareja de nuevo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo PC ha una chiave di sincronizzazione più vecchia di %@. Esci dalla sincronizzazione su questo PC, poi associalo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このPCの同期キーは%@より古くなっています。このPCで同期から退出し、もう一度ペアリングしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 PC의 동기화 키가 %@보다 오래되었습니다. 이 PC에서 동기화 나가기를 실행한 다음 다시 페어링하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze pc heeft een oudere synchronisatiesleutel dan %@. Verlaat de synchronisatie op deze pc en koppel hem daarna opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten komputer ma starszy klucz synchronizacji niż %@. Opuść synchronizację na tym komputerze, a potem sparuj go ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PC tem uma chave de sincronização mais antiga que %@. Saia da sincronização neste PC e pareie-o novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台电脑的同步密钥比%@的旧。请在这台电脑上退出同步，然后重新配对。"
          }
        }
      }
    },
