    "collectionShare.leaveText.mac" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ verlassen? Die Einträge bleiben auf diesem Mac, werden aber nicht mehr mit den anderen synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave “%@”? Its items stay on this Mac but no longer sync with the others."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Salir de «%@»? Sus elementos se quedan en este Mac, pero ya no se sincronizan con los demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitter « %@ » ? Ses éléments restent sur ce Mac mais ne sont plus synchronisés avec les autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasciare «%@»? I suoi elementi restano su questo Mac ma non si sincronizzano più con gli altri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」から退出しますか？ その項目はこのMacに残りますが、ほかの人とは同期されなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”에서 나갈까요? 그 항목은 이 Mac에 남지만 더 이상 다른 사람들과 동기화되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” verlaten? De items blijven op deze Mac maar worden niet meer met de anderen gesynchroniseerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opuścić „%@”? Jej elementy zostaną na tym Macu, ale nie będą już objęte synchronizacją z innymi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sair de “%@”? Os itens dela ficam neste Mac, mas deixam de ser sincronizados com os outros."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要退出“%@”吗？其中的项目会保留在这台 Mac 上，但不再与其他人同步。"
          }
        }
      }
    },
