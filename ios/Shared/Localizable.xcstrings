    "Also suggests logins set to match one exact site, not only logins that match the whole domain." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlägt auch Anmeldungen vor, die für genau eine Website gelten, nicht nur solche, die zur ganzen Domain passen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También sugiere inicios de sesión configurados para un sitio exacto, no solo los que coinciden con todo el dominio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggère aussi les identifiants réglés pour un site précis, et pas seulement ceux qui correspondent à tout le domaine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggerisce anche gli accessi impostati per un sito preciso, non solo quelli che corrispondono all’intero dominio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドメイン全体に一致するログインだけでなく、特定の1つのサイトに一致するよう設定されたログインも候補に表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도메인 전체와 일치하는 로그인뿐 아니라, 정확히 한 사이트에 맞게 설정된 로그인도 제안합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelt ook logins voor die voor één exacte site zijn ingesteld, niet alleen logins die bij het hele domein passen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpowiada też loginy ustawione dla jednej konkretnej witryny, a nie tylko te pasujące do całej domeny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Também sugere logins definidos para um site exato, não só os que correspondem ao domínio inteiro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除了匹配整个域名的登录信息，也会建议设置为只匹配某一个确切网站的登录信息。"
          }
        }
      }
    },
