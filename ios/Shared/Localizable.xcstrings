    "whatsNew.1.2.removal.detail" : {
      "comment" : "What's new 1.2 sheet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nehmen Sie ein Gerät im Tab „Sync“ aus der Synchronisierung. Seine Kopie des Tresors wird beim nächsten Öffnen gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a device out of sync from the Sync tab. Its copy of the vault is erased the next time it opens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saca un dispositivo de la sincronización desde la pestaña Sync. Su copia de la bóveda se borra la próxima vez que se abra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirez un appareil de la synchronisation depuis l’onglet Synchronisation. Sa copie du coffre-fort est effacée à sa prochaine ouverture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Togli un dispositivo dalla sincronizzazione dalla scheda Sync. La sua copia della cassaforte viene cancellata alla successiva apertura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「同期」タブでデバイスを同期から外せます。そのデバイスの保管庫のコピーは、次に開いたときに消去されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화 탭에서 기기를 동기화에서 제외하세요. 그 기기의 보관함 사본은 다음에 열 때 지워집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haal een apparaat uit de synchronisatie via het tabblad Sync. Zijn kopie van de kluis wordt gewist zodra het weer opent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń urządzenie z synchronizacji na karcie Sync. Jego kopia sejfu zostanie wymazana przy następnym otwarciu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire um dispositivo da sincronização na aba Sync. A cópia do cofre nele é apagada na próxima vez que ele abrir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“同步”标签页中将设备移出同步。该设备上的保险库副本会在下次打开时被清除。"
          }
        }
      }
    },
