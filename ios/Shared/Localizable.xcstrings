    "Off · no network access at all when on" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus · wenn ein, überhaupt kein Netzwerkzugriff"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado · con él activado no hay ningún acceso a la red"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No · se attiva, nessun accesso alla rete"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフ · オンにするとネットワークへのアクセスが一切なくなります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
