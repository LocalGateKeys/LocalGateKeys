    "vault.proNeededSharing.mac" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geteilte Sammlungen erfordern LocalGateKeys Pro. Einträge, die bereits mit Ihnen geteilt wurden, bleiben auf diesem Mac und funktionieren weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shared collections need LocalGateKeys Pro. Items already shared with you stay on this Mac and keep working."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las colecciones compartidas requieren LocalGateKeys Pro. Los elementos que ya se compartieron contigo se quedan en este Mac y siguen funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
