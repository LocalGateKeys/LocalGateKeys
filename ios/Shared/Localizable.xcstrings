    "This item was changed elsewhere while you were editing. Save again to keep your version, or cancel to keep the other one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Eintrag wurde woanders geändert, während Sie ihn bearbeitet haben. Speichern Sie erneut, um Ihre Version zu behalten, oder brechen Sie ab, um die andere zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este elemento se cambió en otro lugar mientras lo editabas. Guarda de nuevo para conservar tu versión o cancela para conservar la otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet élément a été modifié ailleurs pendant que vous le modifiiez. Enregistrez à nouveau pour garder votre version, ou annulez pour garder l’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo elemento è stato modificato altrove mentre lo stavi modificando. Salva di nuovo per mantenere la tua versione, oppure annulla per mantenere l’altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "編集中にこの項目が別の場所で変更されました。自分の版を残すにはもう一度保存し、もう一方を残すにはキャンセルしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집하는 동안 이 항목이 다른 곳에서 변경되었습니다. 내 버전을 유지하려면 다시 저장하고, 다른 버전을 유지하려면 취소하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit item is elders gewijzigd terwijl je het bewerkte. Bewaar opnieuw om jouw versie te houden, of annuleer om de andere te houden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten element został zmieniony gdzie indziej podczas edycji. Zapisz ponownie, aby zachować swoją wersję, lub anuluj, aby zachować tę drugą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este item foi alterado em outro lugar enquanto você editava. Salve de novo para manter a sua versão ou cancele para manter a outra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您编辑期间，此项目已在别处被更改。再次存储可保留您的版本，取消则保留另一个版本。"
          }
        }
      }
    },
