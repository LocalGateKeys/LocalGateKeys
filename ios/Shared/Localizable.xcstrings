    "Downloads each site's logo. That tells the site you have an account there; nothing else is sent." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt das Logo jeder Website herunter. Das teilt der Website mit, dass Sie dort ein Konto haben; sonst wird nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga el logotipo de cada sitio. Eso le indica al sitio que tienes una cuenta allí; no se envía nada más."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica il logo di ogni sito. Questo dice al sito che hai un account lì; non viene inviato altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各サイトのロゴをダウンロードします。そのサイトにアカウントがあることがサイトに伝わりますが、それ以外は送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 사이트의 로고를 다운로드합니다. 이 경우 해당 사이트에 계정이 있다는 사실이 사이트에 알려지며, 그 외에는 아무것도 전송되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloadt het logo van elke site. Daarmee weet de site dat je daar een account hebt; er wordt verder niets verstuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pobiera logo każdej witryny. Dzięki temu witryna wie, że masz tam konto; nic więcej nie jest wysyłane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa o logo de cada site. Isso informa ao site que você tem uma conta lá; nada mais é enviado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载每个网站的徽标。这会让网站知道您在那里有账户；不会发送其他任何内容。"
          }
        }
      }
    },
