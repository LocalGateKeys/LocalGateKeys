    "sync.theKeyFileInThe" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schlüsseldatei im Synchronisierungsordner wurde verändert. Die Synchronisierung wurde angehalten. Wenn dies weiterhin passiert, setzen Sie die Synchronisierung auf diesem PC zurück und treten Sie erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key file in the sync folder was altered. Sync stopped. If this keeps happening, reset sync on this PC and join again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de claves de la carpeta de sincronización fue alterado. La sincronización se detuvo. Si esto sigue ocurriendo, restablece la sincronización en este PC y vuelve a unirte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file della chiave nella cartella di sincronizzazione è stato alterato. Sincronizzazione interrotta. Se continua a succedere, reimposta la sincronizzazione su questo PC e unisciti di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期フォルダー内のキーファイルが改ざんされました。同期を停止しました。これが続く場合は、このPCの同期をリセットして、もう一度参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화 폴더의 키 파일이 변경되었습니다. 동기화가 중지되었습니다. 계속되면 이 PC에서 동기화를 초기화하고 다시 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het sleutelbestand in de synchronisatiemap is gewijzigd. Synchronisatie gestopt. Als dit zich blijft voordoen, reset dan de synchronisatie op deze pc en sluit opnieuw aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik klucza w folderze synchronizacji został zmieniony. Synchronizacja zatrzymana. Jeśli to się powtarza, zresetuj synchronizację na tym komputerze i dołącz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo de chave na pasta de sincronização foi alterado. A sincronização parou. Se isso continuar acontecendo, redefina a sincronização neste PC e entre novamente."
          }
        },
