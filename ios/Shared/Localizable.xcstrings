    "Switch on the Safari extension and AutoFill to fill logins and passkeys." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie die Safari-Erweiterung und AutoFill, um Anmeldungen und Passkeys auszufüllen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa la extensión de Safari y el autorrelleno para rellenar inicios de sesión y claves de acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez l’extension Safari et le remplissage automatique pour remplir les identifiants et les clés d’accès."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva l'estensione di Safari e la compilazione automatica per compilare accessi e passkey."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインとパスキーを入力するには、Safari機能拡張と自動入力をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인과 패스키를 채우려면 Safari 확장 프로그램과 자동 완성을 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel de Safari-extensie en automatisch invullen in om logins en passkeys in te vullen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz rozszerzenie Safari i AutoFill, aby uzupełniać loginy i klucze dostępu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
