    "Tell the other person these six words, in person or by phone. Never send them with the file." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nennen Sie der anderen Person diese sechs Wörter persönlich oder telefonisch. Senden Sie sie niemals zusammen mit der Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dile a la otra persona estas seis palabras, en persona o por teléfono. Nunca las envíes junto con el archivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di' all'altra persona queste sei parole, di persona o per telefono. Non inviarle mai insieme al file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この6語を、直接または電話で相手に伝えてください。ファイルと一緒に送らないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 여섯 단어를 직접 만나거나 전화로 상대방에게 알려 주세요. 파일과 함께 절대 보내지 마세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertel deze zes woorden aan de ander, persoonlijk of telefonisch. Stuur ze nooit mee met het bestand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedz drugiej osobie te sześć słów, osobiście lub przez telefon. Nigdy nie wysyłaj ich razem z plikiem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga estas seis palavras à outra pessoa, pessoalmente ou por telefone. Nunca as envie com o arquivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请当面或通过电话告诉对方这六个词。切勿与文件一起发送。"
          }
        }
      }
    },
