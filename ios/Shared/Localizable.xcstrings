          }
        }
      }
    },
    "sync.theOtherDeviceAlreadyHas" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das andere Gerät hat bereits die maximale Zahl gekoppelter Geräte. Entfernen Sie dort zuerst eines."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The other device already has the most paired devices. Remove one there first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El otro dispositivo ya tiene el máximo de dispositivos emparejados. Quita uno allí primero."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'altro dispositivo ha già il numero massimo di dispositivi associati. Rimuovine prima uno lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一方のデバイスは、ペアリング数の上限にすでに達しています。先にそちらで1台削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기에 이미 페어링된 기기가 최대 개수입니다. 먼저 그곳에서 하나를 제거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het andere apparaat heeft al het maximale aantal gekoppelde apparaten. Verwijder daar eerst een apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drugie urządzenie ma już maksymalną liczbę sparowanych urządzeń. Najpierw usuń tam jedno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O outro dispositivo já tem o máximo de dispositivos pareados. Remova um lá primeiro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一台设备已达到配对设备数量上限。请先在那里移除一台。"
          }
        }
      }
    },
    "sync.theOtherDeviceCouldNot" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das andere Gerät konnte nicht erreicht werden. Prüfen Sie, ob beide im selben WLAN sind und das andere Gerät seinen Code anzeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The other device could not be reached. Check that both are on the same Wi-Fi and that the other device shows its code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo contactar con el otro dispositivo. Comprueba que ambos estén en el mismo Wi-Fi y que el otro dispositivo muestre su código."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere l'altro dispositivo. Controlla che entrambi siano sulla stessa rete Wi-Fi e che l'altro dispositivo mostri il suo codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一方のデバイスに接続できませんでした。両方が同じWi-Fiに接続していることと、もう一方にコードが表示されていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기에 연결할 수 없습니다. 두 기기가 같은 Wi-Fi에 있는지, 다른 기기에 코드가 표시되어 있는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het andere apparaat kon niet worden bereikt. Controleer of beide op hetzelfde wifi-netwerk zitten en of het andere apparaat zijn code toont."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się połączyć z drugim urządzeniem. Sprawdź, czy oba są w tej samej sieci Wi-Fi i czy drugie urządzenie pokazuje swój kod."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível alcançar o outro dispositivo. Verifique se os dois estão no mesmo Wi-Fi e se o outro dispositivo mostra o código dele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接到另一台设备。请检查两者是否在同一个 Wi-Fi 上，并且另一台设备正在显示它的代码。"
          }
        }
      }
    },
    "sync.theOtherDeviceDeclinedOr" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das andere Gerät hat abgelehnt, oder dort hat niemand rechtzeitig „Annehmen“ gewählt. Zeigen Sie dort einen neuen Code an und wählen Sie „Annehmen“, wenn beide Bildschirme denselben Code zeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The other device declined, or nobody chose Accept there in time. Show a new code there and choose Accept when both screens show the same code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El otro dispositivo rechazó, o nadie eligió Aceptar allí a tiempo. Muestra un código nuevo allí y elige Aceptar cuando ambas pantallas muestren el mismo código."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'altro dispositivo ha rifiutato, oppure nessuno ha scelto Accetta lì in tempo. Mostra lì un nuovo codice e scegli Accetta quando entrambi gli schermi mostrano lo stesso codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一方のデバイスが拒否したか、時間内に誰もそちらで「承認」を選びませんでした。そちらで新しいコードを表示し、両方の画面に同じコードが表示されたら「承認」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기가 거절했거나 제때 수락을 선택하지 않았습니다. 그곳에서 새 코드를 표시하고 두 화면에 같은 코드가 표시될 때 수락을 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het andere apparaat heeft geweigerd, of niemand heeft daar op tijd Accepteren gekozen. Toon daar een nieuwe code en kies Accepteren wanneer beide schermen dezelfde code tonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drugie urządzenie odrzuciło lub nikt tam na czas nie wybrał Akceptuj. Pokaż tam nowy kod i wybierz Akceptuj, gdy oba ekrany pokazują ten sam kod."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O outro dispositivo recusou, ou ninguém escolheu Aceitar lá a tempo. Mostre um novo código lá e escolha Aceitar quando as duas telas mostrarem o mesmo código."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一台设备拒绝了，或者没有人及时在那里选择“接受”。请在那里显示新的代码，并在两个屏幕显示相同代码时选择“接受”。"
          }
        }
      }
