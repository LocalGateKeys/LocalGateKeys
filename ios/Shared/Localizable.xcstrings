        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze iPad moet opnieuw aan de synchronisatie deelnemen (hij heeft een wachtwoordwijziging gemist, of is verwijderd). Voeg de map opnieuw toe met het huidige synchronisatiewachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten iPad musi ponownie dołączyć do synchronizacji (przegapił zmianę hasła lub został usunięty). Dołącz do folderu ponownie z aktualnym hasłem synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPad precisa entrar na sincronização novamente (perdeu uma alteração de senha ou foi removido). Entre novamente na pasta com a senha de sincronização atual."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPad 必须重新加入同步（它错过了一次密码更改，或已被移除）。请使用当前的同步密码重新加入该文件夹。"
          }
        }
      }
    },
