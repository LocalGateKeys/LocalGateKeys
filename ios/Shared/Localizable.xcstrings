    "collectionShare.forgetLinkHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wurde dieses Gerät verloren oder zurückgesetzt, vergessen Sie den Freigabelink. Danach können Sie diese Sammlung löschen oder erneut teilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If that device was lost or reset, forget the share link. Then you can delete this collection or share it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ese dispositivo se perdió o se restableció, olvida el enlace compartido. Después podrás eliminar esta colección o volver a compartirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cet appareil a été perdu ou réinitialisé, oubliez le lien de partage. Vous pourrez ensuite supprimer cette collection ou la partager à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quel dispositivo è stato perso o reimpostato, dimentica il link di condivisione. Poi potrai eliminare questa raccolta o condividerla di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのデバイスを紛失したかリセットした場合は、共有リンクを忘れてください。その後、このコレクションを削除したり、もう一度共有したりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 기기를 잃어버렸거나 초기화했다면 공유 링크를 잊으세요. 그러면 이 컬렉션을 삭제하거나 다시 공유할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is dat apparaat kwijt of opnieuw ingesteld, vergeet dan de deellink. Daarna kun je deze verzameling verwijderen of opnieuw delen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli to urządzenie zginęło lub zostało zresetowane, zapomnij link udostępniania. Potem możesz usunąć tę kolekcję albo udostępnić ją ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se esse dispositivo foi perdido ou redefinido, esqueça o link de compartilhamento. Depois você pode excluir esta coleção ou compartilhá-la de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果该设备已丢失或已重置，请忘记共享链接。之后您可以删除此集合或重新共享它。"
          }
        }
      }
    },
