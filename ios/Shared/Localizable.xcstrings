    "No recent backup: the owner's app has not written a backup to the shared folder since the plan was made." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein aktuelles Backup: Die App des Inhabers hat seit dem Plan kein Backup in den geteilten Ordner geschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay una copia de seguridad reciente: la app del titular no ha escrito ninguna copia de seguridad en la carpeta compartida desde que se creó el plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune sauvegarde récente : l’app du propriétaire n’a écrit aucune sauvegarde dans le dossier partagé depuis la création du plan."
          }
        },
        "it" : {
          "stringUnit" : {
