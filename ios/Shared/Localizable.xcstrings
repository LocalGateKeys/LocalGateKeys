    "sync.thisPcLeftSyncRemove" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser PC hat die Synchronisierung verlassen. Entfernen Sie ihn auf einem Ihrer anderen Geräte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This PC left sync. Remove it on one of your other devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PC salió de la sincronización. Quítalo en uno de tus otros dispositivos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo PC è uscito dalla sincronizzazione. Rimuovilo su uno degli altri tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このPCは同期から退出しました。ほかのデバイスの1台で削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 PC가 동기화를 나갔습니다. 다른 기기에서 이 PC를 제거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze pc heeft de synchronisatie verlaten. Verwijder hem op een van je andere apparaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten komputer opuścił synchronizację. Usuń go na jednym z pozostałych urządzeń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PC saiu da sincronização. Remova-o em um dos seus outros dispositivos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台电脑已退出同步。请在您的其他设备之一上移除它。"
          }
        }
      }
    },
