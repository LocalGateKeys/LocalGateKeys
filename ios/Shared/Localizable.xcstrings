    "Locked · this login always asks for the master password. Reveal to view or edit." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesperrt · Diese Anmeldung verlangt immer das Master-Passwort. Zum Ansehen oder Bearbeiten anzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueado · este inicio de sesión siempre pide la contraseña maestra. Revela para verlo o editarlo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloccato · questo accesso chiede sempre la password principale. Rivela per vedere o modificare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック中 · このログインでは常にマスターパスワードを確認します。表示すると確認や編集ができます。"
