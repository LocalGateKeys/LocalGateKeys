    "Checked %lld unique passwords · %lld logins exposed · %lld errors. Not found does not prove a password is safe." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld einzigartige Passwörter geprüft · %2$lld Anmeldungen betroffen · %3$lld Fehler. „Nicht gefunden“ beweist nicht, dass ein Passwort sicher ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checked %1$lld unique passwords · %2$lld logins exposed · %3$lld errors. Not found does not prove a password is safe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se comprobaron %1$lld contraseñas únicas · %2$lld inicios de sesión expuestos · %3$lld errores. Que no se encuentre no demuestra que una contraseña sea segura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld mots de passe uniques vérifiés · %2$lld identifiants exposés · %3$lld erreurs. Un résultat « non trouvé » ne prouve pas qu’un mot de passe est sûr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controllate %1$lld password uniche · %2$lld accessi esposti · %3$lld errori. Non trovata non dimostra che una password sia sicura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重複しないパスワードを%1$lld件確認 · %2$lld件のログインが漏えい · エラー%3$lld件。「見つかりませんでした」は、パスワードが安全であることを証明するものではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고유한 비밀번호 %1$lld개를 확인했습니다 · 노출된 로그인 %2$lld개 · 오류 %3$lld개. 발견되지 않았다고 해서 비밀번호가 안전하다는 뜻은 아닙니다."
          }
        },
        "nl" : {
          "stringUnit" : {
