        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 보관함의 동기화 설정이 손상되었습니다. 이 iPad에서 동기화를 초기화한 다음 다시 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De synchronisatie-instellingen van deze kluis zijn beschadigd. Reset de synchronisatie op deze iPad en voeg daarna opnieuw toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia synchronizacji tego sejfu są uszkodzone. Zresetuj synchronizację na tym iPadzie, a potem dołącz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ajustes de sincronização deste cofre estão danificados. Redefina a sincronização neste iPad e entre novamente."
