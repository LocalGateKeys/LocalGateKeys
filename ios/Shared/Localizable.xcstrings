        }
      }
    },
    "Your recovery phrase changed. Enter the backup password once so the new phrase can reset it. Until then the backup password can't be reset with the phrase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Wiederherstellungsphrase hat sich geändert. Geben Sie das Backup-Passwort einmal ein, damit die neue Phrase es zurücksetzen kann. Bis dahin kann das Backup-Passwort nicht mit der Phrase zurückgesetzt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu frase de recuperación ha cambiado. Escribe una vez la contraseña de copia de seguridad para que la nueva frase pueda restablecerla. Hasta entonces, la contraseña no se puede restablecer con la frase."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre phrase de récupération a changé. Saisissez une fois le mot de passe de sauvegarde pour que la nouvelle phrase puisse le réinitialiser. D’ici là, la phrase ne peut pas réinitialiser le mot de passe de sauvegarde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua frase di recupero è cambiata. Inserisci una volta la password del backup perché la nuova frase possa reimpostarla. Fino ad allora la password del backup non può essere reimpostata con la frase."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リカバリーフレーズが変更されました。新しいフレーズでリセットできるように、バックアップパスワードを一度入力してください。それまでは、フレーズでバックアップパスワードをリセットできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구 문구가 변경되었습니다. 새 문구로 재설정할 수 있도록 백업 비밀번호를 한 번 입력하세요. 그 전까지는 문구로 백업 비밀번호를 재설정할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je herstelzin is gewijzigd. Voer het back-upwachtwoord één keer in zodat de nieuwe zin het opnieuw kan instellen. Tot die tijd kan het back-upwachtwoord niet met de zin opnieuw worden ingesteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fraza odzyskiwania została zmieniona. Wpisz raz hasło kopii zapasowej, aby nowa fraza mogła je zresetować. Do tego czasu nie można zresetować hasła frazą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua frase de recuperação mudou. Digite a senha de backup uma vez para que a nova frase possa redefini-la. Até lá, a senha de backup não pode ser redefinida com a frase."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的恢复短语已更改。请输入一次备份密码，以便新短语可以重置它。在此之前，无法用短语重置备份密码。"
          }
        }
      }
    },
    "Your recovery phrase stays the same." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Wiederherstellungsphrase bleibt gleich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu frase de recuperación sigue siendo la misma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
