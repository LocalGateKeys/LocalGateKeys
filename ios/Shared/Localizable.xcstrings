        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartella condivisa non è disponibile. Controlla che esista ancora e che sia sincronizzata con questo iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有フォルダーを利用できません。フォルダーがまだ存在し、このiPadと同期されているか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 폴더를 사용할 수 없습니다. 폴더가 아직 있고 이 iPad와 동기화되는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gedeelde map is niet beschikbaar. Controleer of hij nog bestaat en met deze iPad wordt gesynchroniseerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępniony folder jest niedostępny. Sprawdź, czy nadal istnieje i czy jest synchronizowany z tym iPadem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta compartilhada não está disponível. Verifique se ela ainda existe e se está sendo sincronizada com este iPad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享文件夹不可用。请检查它是否仍然存在并与这台 iPad 同步。"
          }
        }
      }
    },
    "ipad.collectionShare.leaveText" : {
      "comment" : "iPad wording of \"Leave “%@”? Its items stay on this iPhone but no longer syn…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ verlassen? Die Einträge bleiben auf diesem iPad, werden aber nicht mehr mit den anderen synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave “%@”? Its items stay on this iPad but no longer sync with the others."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Salir de «%@»? Sus elementos se quedan en este iPad, pero ya no se sincronizan con los demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitter « %@ » ? Ses éléments restent sur cet iPad mais ne sont plus synchronisés avec les autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasciare «%@»? I suoi elementi restano su questo iPad ma non si sincronizzano più con gli altri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」から退出しますか？ その項目はこのiPadに残りますが、ほかの人とは同期されなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”에서 나갈까요? 그 항목은 이 iPad에 남지만 더 이상 다른 사람들과 동기화되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” verlaten? De items blijven op deze iPad maar worden niet meer met de anderen gesynchroniseerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opuścić „%@”? Jej elementy zostaną na tym iPadzie, ale nie będą już objęte synchronizacją z innymi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sair de “%@”? Os itens dela ficam neste iPad, mas deixam de ser sincronizados com os outros."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要退出“%@”吗？其中的项目会保留在这台 iPad 上，但不再与其他人同步。"
          }
        }
      }
    },
    "ipad.collectionShare.rejoinRequired" : {
      "comment" : "iPad wording of \"This iPhone can no longer open the shared collection. Ask t…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPad kann die geteilte Sammlung nicht mehr öffnen. Fragen Sie die Person, die sie geteilt hat, ob Sie entfernt wurden, und treten Sie dann erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This iPad can no longer open the shared collection. Ask the person who shared it whether you were removed, then join again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPad ya no puede abrir la colección compartida. Pregunta a quien la compartió si te quitó y luego vuelve a unirte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPad ne peut plus ouvrir la collection partagée. Demandez à la personne qui l’a partagée si vous avez été retiré, puis rejoignez-la à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo iPad non riesce più ad aprire la raccolta condivisa. Chiedi a chi l'ha condivisa se sei stato rimosso, poi unisciti di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPadでは共有コレクションを開けなくなりました。共有した人に削除されたかどうかを確認してから、もう一度参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPad에서 더 이상 공유 컬렉션을 열 수 없습니다. 공유한 사람에게 제거되었는지 확인한 뒤 다시 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze iPad kan de gedeelde verzameling niet meer openen. Vraag degene die hem deelde of je bent verwijderd en doe daarna opnieuw mee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten iPad nie może już otworzyć udostępnionej kolekcji. Zapytaj osobę, która ją udostępniła, czy Cię usunęła, a potem dołącz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPad não consegue mais abrir a coleção compartilhada. Pergunte a quem a compartilhou se você foi removido e depois entre de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPad 无法再打开此共享集合。请询问共享者您是否已被移出，然后重新加入。"
          }
        }
      }
    },
    "ipad.collectionShare.removedFromShare" : {
      "comment" : "iPad wording of \"You were removed from this shared collection. Its items on …\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wurden aus dieser geteilten Sammlung entfernt. Ihre Einträge auf diesem iPad wurden in den Papierkorb verschoben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You were removed from this shared collection. Its items on this iPad were moved to the trash."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te quitaron de esta colección compartida. Sus elementos en este iPad se movieron a la papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez été retiré de cette collection partagée. Ses éléments sur cet iPad ont été placés dans la corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei stato rimosso da questa raccolta condivisa. I suoi elementi su questo iPad sono stati spostati nel cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この共有コレクションから削除されました。このiPad上のその項目はごみ箱に移動されました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 공유 컬렉션에서 제거되었습니다. 이 iPad에 있던 해당 항목은 휴지통으로 이동했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent uit deze gedeelde verzameling verwijderd. De items ervan op deze iPad zijn naar de prullenbak verplaatst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięto Cię z tej udostępnionej kolekcji. Jej elementy na tym iPadzie przeniesiono do kosza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você foi removido desta coleção compartilhada. Os itens dela neste iPad foram movidos para a lixeira."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您已被移出此共享集合。它在这台 iPad 上的项目已移到回收站。"
          }
        }
      }
    },
    "ipad.collectionShare.stopText" : {
      "comment" : "iPad wording of \"Stop sharing “%@” on this iPhone? The collection and its it…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ auf diesem iPad nicht mehr teilen? Die Sammlung und ihre Einträge bleiben hier. Die anderen behalten ihre Kopien, aber niemand kann mehr Personen hereinlassen oder entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop sharing “%@” on this iPad? The collection and its items stay here. The others keep their copies, but nobody can let people in or remove them any more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dejar de compartir «%@» en este iPad? La colección y sus elementos se quedan aquí. Los demás conservan sus copias, pero ya nadie podrá dejar entrar ni quitar personas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêter de partager « %@ » sur cet iPad ? La collection et ses éléments restent ici. Les autres gardent leurs copies, mais plus personne ne pourra laisser entrer ou retirer des personnes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompere la condivisione di «%@» su questo iPad? La raccolta e i suoi elementi restano qui. Gli altri mantengono le loro copie, ma nessuno potrà più far entrare o rimuovere persone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPadで「%@」の共有を停止しますか？ コレクションとその項目はここに残ります。ほかの人はコピーを保持しますが、人を承認したり削除したりすることは誰にもできなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPad에서 “%@” 공유를 중지할까요? 컬렉션과 그 항목은 여기에 남습니다. 다른 사람들은 사본을 유지하지만, 더 이상 아무도 사람을 승인하거나 제거할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppen met het delen van “%@” op deze iPad? De verzameling en de items blijven hier. De anderen houden hun kopieën, maar niemand kan nog mensen toelaten of verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończyć udostępnianie „%@” na tym iPadzie? Kolekcja i jej elementy zostaną tutaj. Pozostali zachowają swoje kopie, ale nikt nie będzie już mógł wpuszczać ani usuwać osób."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parar de compartilhar “%@” neste iPad? A coleção e os itens dela ficam aqui. Os outros mantêm suas cópias, mas ninguém mais poderá liberar ou remover pessoas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要在这台 iPad 上停止共享“%@”吗？集合及其项目会保留在这里。其他人保留各自的副本，但再也没有人能允许他人加入或移除他人。"
          }
        }
      }
    },
