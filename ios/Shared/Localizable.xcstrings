            "value" : "Es wird bei der nächsten Synchronisierung von diesem iPhone und von Ihren anderen Geräten entfernt. Es kann nur auf Ihrem PC bearbeitet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quita de este iPhone y de tus otros dispositivos en la siguiente sincronización. Solo se puede editar en tu PC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est retiré de cet iPhone et de vos autres appareils à la prochaine synchronisation. Il ne peut être modifié que sur votre PC."
