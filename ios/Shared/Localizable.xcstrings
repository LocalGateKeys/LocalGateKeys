        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このPCはメンバー一覧から外されました。もう一度フォルダーに参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 PC가 구성원 목록에서 제외되었습니다. 폴더에 다시 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze pc is uit de ledenlijst gehaald. Sluit opnieuw aan bij de map."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten komputer został usunięty z listy członków. Dołącz do folderu ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
