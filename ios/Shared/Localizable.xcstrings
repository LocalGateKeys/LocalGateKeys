    "Deleted %@ and %@. The newest %lld backups are kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ und %2$@ gelöscht. Die neuesten %3$lld Backups bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleted %1$@ and %2$@. The newest %3$lld backups are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminaron %1$@ y %2$@. Se conservan las %3$lld copias de seguridad más recientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ et %2$@ supprimés. Les %3$lld sauvegardes les plus récentes sont conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminati %1$@ e %2$@. Vengono conservati gli ultimi %3$lld backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@と%2$@を削除しました。最新の%3$lld件のバックアップは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 및 %2$@을(를) 삭제했습니다. 최신 백업 %3$lld개는 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ en %2$@ verwijderd. De nieuwste %3$lld back-ups blijven bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięto %1$@ i %2$@. Zachowanych zostaje %3$lld najnowszych kopii zapasowych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ e %2$@ excluídos. Os %3$lld backups mais recentes são mantidos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已删除 %1$@ 和 %2$@。最新的 %3$lld 个备份会保留。"
          }
        }
      }
    },
