    "Fill and save logins in Safari and in apps. Turn them on in Devices & connections." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmeldungen in Safari und in Apps ausfüllen und speichern. Aktivieren Sie das unter „Geräte & Verbindungen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rellena y guarda inicios de sesión en Safari y en apps. Actívalos en Dispositivos y conexiones."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compila e salva gli accessi in Safari e nelle app. Attivali in Dispositivi e connessioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SafariとAppでログインの入力と保存を行います。「デバイスと接続」でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari와 앱에서 로그인을 채우고 저장합니다. 기기 및 연결에서 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul logins in en bewaar ze in Safari en in apps. Schakel ze in bij Apparaten en verbindingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzupełniaj i zapisuj loginy w Safari i w aplikacjach. Włącz je w Urządzenia i połączenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preencha e salve logins no Safari e em apps. Ative-os em Dispositivos e conexões."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Safari 和应用中填充并保存登录。请在“设备与连接”中开启。"
          }
        }
      }
    },
    "Fill card numbers, addresses and more in any text field (iOS 18 and later)." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kartennummern, Adressen und mehr in jedem Textfeld ausfüllen (iOS 18 und neuer)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rellena números de tarjeta, direcciones y más en cualquier campo de texto (iOS 18 y posterior)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compila numeri di carta, indirizzi e altro in qualsiasi campo di testo (iOS 18 e successivi)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード番号や住所などを、あらゆるテキストフィールドに入力します(iOS 18以降)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 텍스트 필드에서 카드 번호, 주소 등을 채웁니다(iOS 18 이상)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vul kaartnummers, adressen en meer in elk tekstveld in (iOS 18 en later)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzupełniaj numery kart, adresy i więcej w dowolnym polu tekstowym (iOS 18 i nowszy)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preencha números de cartão, endereços e mais em qualquer campo de texto (iOS 18 e posterior)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何文本栏中填充卡号、地址等信息（iOS 18 及更高版本）。"
          }
        }
      }
    },
    "Fill your logins in apps and in Safari. Choose LocalGateKeys as the AutoFill provider." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
