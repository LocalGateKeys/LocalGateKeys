          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otro dispositivo ejecuta una sincronización por Wi-Fi más reciente. Actualiza LocalGateKeys en este iPad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un autre appareil utilise une synchronisation Wi-Fi plus récente. Mettez à jour LocalGateKeys sur cet iPad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro dispositivo usa una sincronizzazione Wi-Fi più recente. Aggiorna LocalGateKeys su questo iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
