    "sync.hasNotSyncedForOver" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde seit über einem Jahr nicht synchronisiert und wird ignoriert. Entfernen Sie dieses Gerät, wenn es nicht mehr existiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has not synced for over a year and is ignored. Remove that device if it is gone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se ha sincronizado en más de un año y se ignora. Quita ese dispositivo si ya no existe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non si sincronizza da più di un anno e viene ignorato. Rimuovi quel dispositivo se non c'è più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は1年以上同期されておらず、無視されます。そのデバイスがもうない場合は削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 1년 넘게 동기화되지 않아 무시됩니다. 더 이상 없는 기기라면 제거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is al meer dan een jaar niet gesynchroniseerd en wordt genegeerd. Verwijder dat apparaat als het weg is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie synchronizowało się od ponad roku i jest ignorowane. Usuń to urządzenie, jeśli już go nie ma."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não sincroniza há mais de um ano e é ignorado. Remova esse dispositivo se ele não existir mais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@已超过一年没有同步，已被忽略。如果该设备已不在，请移除它。"
          }
        }
      }
    },
