    "Up to %lld earlier passwords from the last year are kept with the login and sync with it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu %lld frühere Passwörter des letzten Jahres werden bei der Anmeldung aufbewahrt und mit ihr synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conservan con el inicio de sesión hasta %lld contraseñas anteriores del último año, y se sincronizan con él."
          }
