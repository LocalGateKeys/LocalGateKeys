    " Not confirmed, so they lose access: %@. To keep one, cancel and choose These are my devices first." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Nicht bestätigt, daher verlieren sie den Zugriff: %@. Um eines zu behalten, brechen Sie ab und wählen Sie zuerst „Das sind meine Geräte“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " No confirmados, por lo que pierden el acceso: %@. Para conservar alguno, cancela y elige primero Estos son mis dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Non confirmés, ils perdent donc l’accès : %@. Pour en garder un, annulez et choisissez d’abord Ce sont mes appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Non confermati, quindi perdono l'accesso: %@. Per mantenerne uno, annulla e scegli prima Sono i miei dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 未確認のため、アクセスできなくなるデバイス: %@。残したい場合は、キャンセルして、先に「これらは自分のデバイスです」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 확인하지 않아 접근 권한을 잃는 기기: %@. 유지하려면 취소하고 먼저 내 기기가 맞습니다를 선택하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Niet bevestigd, dus ze verliezen toegang: %@. Wil je er een behouden, annuleer dan en kies eerst Dit zijn mijn apparaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Niepotwierdzone, więc tracą dostęp: %@. Aby zachować któreś, anuluj i najpierw wybierz To są moje urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Não confirmados, então perdem o acesso: %@. Para manter algum, cancele e escolha primeiro Estes são os meus dispositivos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 未确认，因此它们会失去访问权限：%@。若要保留某台设备，请先取消并选择“这些是我的设备”。"
          }
        }
      }
    },
