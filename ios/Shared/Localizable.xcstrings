          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten kod pochodzi z innego urządzenia niż to, z którym sparowano to urządzenie (%@). Nic nie zostało zmienione. Aby synchronizować z tamtym urządzeniem, opuść synchronizację i sparuj ponownie."
          }
