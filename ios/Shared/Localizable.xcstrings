    "developer.agent.status.pathTooLong" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht verfügbar: Der Socket-Pfad ist länger, als macOS erlaubt (104 Byte). Ein kürzerer Benutzername behebt das."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not available: the socket path is longer than macOS allows (104 bytes). A shorter user name fixes this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No disponible: la ruta del socket es más larga de lo que permite macOS (104 bytes). Un nombre de usuario más corto lo soluciona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non disponible : le chemin du socket est plus long que ce que macOS autorise (104 octets). Un nom d’utilisateur plus court règle le problème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non disponibile: il percorso del socket è più lungo di quanto consenta macOS (104 byte). Un nome utente più corto risolve il problema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用できません:ソケットのパスが macOS の上限(104 バイト)を超えています。短いユーザ名にすると解決します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용할 수 없음: 소켓 경로가 macOS 허용 길이(104바이트)보다 깁니다. 더 짧은 사용자 이름을 쓰면 해결됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
