        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一个项目需要这台 iPhone 上更新版本的 LocalGateKeys。请更新 LocalGateKeys；在此之前该项目会等待。"
          }
        }
      }
    },
    "sync.reportedAnImpossibleVersionNumber" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat eine unmögliche Versionsnummer für diesen Tresor gemeldet; sie wurde ignoriert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reported an impossible version number for this vault; it was ignored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ informó de un número de versión imposible para esta bóveda; se ignoró."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha segnalato un numero di versione impossibile per questa cassaforte; è stato ignorato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が、この保管庫についてありえないバージョン番号を報告したため、無視されました。"
