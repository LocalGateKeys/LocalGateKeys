        }
      }
    },
    "There is no way to reset this password. If you forget it, your vault cannot be opened, so keep it somewhere safe." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Passwort kann nicht zurückgesetzt werden. Wenn Sie es vergessen, lässt sich Ihr Tresor nicht öffnen. Bewahren Sie es daher sicher auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay forma de restablecer esta contraseña. Si la olvidas, tu bóveda no se puede abrir, así que guárdala en un lugar seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’existe aucun moyen de réinitialiser ce mot de passe. Si vous l’oubliez, votre coffre-fort ne pourra pas être ouvert ; gardez-le donc en lieu sûr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c'è modo di reimpostare questa password. Se la dimentichi, la cassaforte non potrà essere aperta, quindi conservala in un posto sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このパスワードをリセットする方法はありません。忘れると保管庫を開けなくなるため、安全な場所に保管してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 비밀번호를 재설정할 방법은 없습니다. 잊어버리면 보관함을 열 수 없으니 안전한 곳에 보관하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit wachtwoord kan niet worden gereset. Vergeet je het, dan kan je kluis niet worden geopend; bewaar het dus op een veilige plek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tego hasła nie da się zresetować. Jeśli je zapomnisz, Twojego sejfu nie będzie można otworzyć, więc przechowuj je w bezpiecznym miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há como redefinir esta senha. Se você a esquecer, seu cofre não poderá ser aberto, então guarde-a em um lugar seguro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此密码无法重置。如果您忘记了它，您的保管库将无法打开，所以请妥善保管。"
          }
        }
      }
    },
    "These are my devices" : {
      "extractionState" : "manual",
      "localizations" : {
