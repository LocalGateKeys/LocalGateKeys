    },
    "It is saved in LocalGateKeys on this Mac and syncs to your PC with your other items." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird in LocalGateKeys auf diesem Mac gespeichert und mit Ihren anderen Einträgen mit Ihrem PC synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda en LocalGateKeys en este Mac y se sincroniza con tu PC junto con tus otros elementos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est enregistré dans LocalGateKeys sur ce Mac et se synchronise avec votre PC en même temps que vos autres éléments."
