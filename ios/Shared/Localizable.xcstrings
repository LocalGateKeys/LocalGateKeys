    "sync.runsAnOlderLocalgatekeysAnd" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verwendet ein älteres LocalGateKeys und kann nicht per WLAN mit diesem PC synchronisieren. Aktualisieren Sie LocalGateKeys auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ runs an older LocalGateKeys and cannot sync over Wi-Fi with this PC. Update LocalGateKeys on that device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usa una versión más antigua de LocalGateKeys y no puede sincronizar por Wi-Fi con este PC. Actualiza LocalGateKeys en ese dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usa una versione più vecchia di LocalGateKeys e non può sincronizzarsi tramite Wi-Fi con questo PC. Aggiorna LocalGateKeys su quel dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は古いLocalGateKeysを使っており、このPCとWi-Fiで同期できません。そのデバイスのLocalGateKeysを更新してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 이전 버전의 LocalGateKeys를 실행 중이어서 이 PC와 Wi-Fi로 동기화할 수 없습니다. 해당 기기의 LocalGateKeys를 업데이트하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ draait een oudere LocalGateKeys en kan niet via wifi met deze pc synchroniseren. Werk LocalGateKeys op dat apparaat bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ używa starszej wersji LocalGateKeys i nie może synchronizować się z tym komputerem przez Wi-Fi. Zaktualizuj LocalGateKeys na tamtym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ executa um LocalGateKeys mais antigo e não consegue sincronizar por Wi-Fi com este PC. Atualize o LocalGateKeys nesse dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@运行的 LocalGateKeys 版本较旧，无法通过 Wi-Fi 与这台电脑同步。请更新那台设备上的 LocalGateKeys。"
          }
        }
      }
    },
    "sync.runsAnOlderLocalgatekeysAnd.mac" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verwendet ein älteres LocalGateKeys und kann nicht über WLAN mit diesem Mac synchronisieren. Aktualisieren Sie LocalGateKeys auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ runs an older LocalGateKeys and cannot sync over Wi-Fi with this Mac. Update LocalGateKeys on that device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ejecuta una versión anterior de LocalGateKeys y no puede sincronizar por Wi-Fi con este Mac. Actualiza LocalGateKeys en ese dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usa una versione meno recente di LocalGateKeys e non può sincronizzarsi via Wi-Fi con questo Mac. Aggiorna LocalGateKeys su quel dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は古いLocalGateKeysを使用しており、このMacとWi-Fi経由で同期できません。そのデバイスのLocalGateKeysをアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 이전 버전의 LocalGateKeys를 사용 중이라 이 Mac과 Wi-Fi로 동기화할 수 없습니다. 해당 기기에서 LocalGateKeys를 업데이트하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gebruikt een oudere LocalGateKeys en kan niet via wifi met deze Mac synchroniseren. Werk LocalGateKeys op dat apparaat bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ używa starszego LocalGateKeys i nie może synchronizować przez Wi-Fi z tym Makiem. Zaktualizuj LocalGateKeys na tamtym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usa um LocalGateKeys mais antigo e não consegue sincronizar por Wi-Fi com este Mac. Atualize o LocalGateKeys nesse dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 运行的是较旧的 LocalGateKeys，无法通过 Wi-Fi 与这台 Mac 同步。请更新那台设备上的 LocalGateKeys。"
          }
        }
      }
    },
