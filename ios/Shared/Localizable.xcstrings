    },
    "Every item, encrypted with a password you choose. Restore it on a phone or in the desktop app." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Eintrag, verschlüsselt mit einem Passwort Ihrer Wahl. Stellen Sie es auf einem Telefon oder in der Desktop-App wieder her."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los elementos, cifrados con una contraseña que eliges. Restáurala en un teléfono o en la aplicación de escritorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les éléments, chiffrés avec un mot de passe de votre choix. Restaurez-la sur un téléphone ou dans l’app de bureau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni elemento, cifrato con una password che scegli tu. Ripristinalo su un telefono o nell'app desktop."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての項目を、選んだパスワードで暗号化します。iPhoneまたはデスクトップアプリで復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 비밀번호로 암호화된 모든 항목입니다. 휴대폰이나 데스크톱 앱에서 복원하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk item, versleuteld met een wachtwoord dat je kiest. Herstel het op een telefoon of in de desktop-app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy element, zaszyfrowany wybranym przez Ciebie hasłem. Przywróć go na telefonie lub w aplikacji na komputer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
