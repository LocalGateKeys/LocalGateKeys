      }
    },
    "Each profile is a separate vault with its own master password, Touch ID, sync and backups. AutoFill and Safari use the profile opened last." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Profil ist ein eigener Tresor mit eigenem Master-Passwort, Touch ID, Synchronisierung und Backups. AutoFill und Safari verwenden das zuletzt geöffnete Profil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada perfil es una bóveda independiente con su propia contraseña maestra, Touch ID, sincronización y copias de seguridad. Autorrelleno y Safari usan el último perfil abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque profil est un coffre distinct avec son propre mot de passe principal, Touch ID, sa synchronisation et ses sauvegardes. Le remplissage automatique et Safari utilisent le dernier profil ouvert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni profilo è una cassaforte separata con la propria password principale, Touch ID, sincronizzazione e backup. Compilazione automatica e Safari usano l'ultimo profilo aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルごとに、マスターパスワード、Touch ID、同期、バックアップを持つ別々の保管庫になります。自動入力と Safari は最後に開いたプロファイルを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 프로필은 자체 마스터 암호, Touch ID, 동기화와 백업을 가진 별도의 보관함입니다. 자동 완성과 Safari는 마지막으로 연 프로필을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk profiel is een aparte kluis met een eigen hoofdwachtwoord, Touch ID, synchronisatie en back-ups. Automatisch invullen en Safari gebruiken het laatst geopende profiel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy profil to osobny sejf z własnym hasłem głównym, Touch ID, synchronizacją i kopiami zapasowymi. Autouzupełnianie i Safari używają ostatnio otwartego profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada perfil é um cofre separado, com sua própria senha mestra, Touch ID, sincronização e backups. O preenchimento automático e o Safari usam o último perfil aberto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个配置文件都是独立的保险库，拥有自己的主密码、触控 ID、同步和备份。自动填充和 Safari 使用最后打开的配置文件。"
          }
        }
      }
    },
    "Each week, prove that a scheduled backup restores. Nothing is stored; if no backup ran, the test runs at the next unlock." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Woche prüfen, dass sich ein geplantes Backup wiederherstellen lässt. Nichts wird gespeichert; lief kein Backup, läuft der Test beim nächsten Entsperren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada semana, comprueba que una copia de seguridad programada se restaura. No se guarda nada; si no hubo copia, la prueba se hace al próximo desbloqueo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque semaine, vérifie qu'une sauvegarde planifiée se restaure. Rien n'est stocké ; sans sauvegarde, le test a lieu au prochain déverrouillage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni settimana verifica che un backup pianificato si ripristini. Non viene salvato nulla; se non è stato fatto alcun backup, la prova avviene al prossimo sblocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎週、予定バックアップが復元できることを確認します。何も保存されません。バックアップがない場合は次のロック解除時に実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매주 예약 백업이 복원되는지 확인합니다. 아무것도 저장하지 않으며, 백업이 없으면 다음 잠금 해제 때 테스트합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controleert elke week of een geplande back-up te herstellen is. Er wordt niets opgeslagen; was er geen back-up, dan draait de test bij de volgende ontgrendeling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co tydzień sprawdza, czy zaplanowaną kopię zapasową da się przywrócić. Nic nie jest zapisywane; bez kopii test odbędzie się przy następnym odblokowaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda semana, comprova que um backup agendado é restaurado. Nada é armazenado; se não houve backup, o teste ocorre no próximo desbloqueio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周确认计划备份可以恢复。不存储任何内容;如果没有备份,将在下次解锁时测试。"
          }
        }
      }
    },
