          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verwendet ein älteres LocalGateKeys und kann nicht über WLAN mit diesem iPhone synchronisieren. Aktualisieren Sie LocalGateKeys auf diesem Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ runs an older LocalGateKeys and cannot sync over Wi-Fi with this iPhone. Update LocalGateKeys on that device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ejecuta una versión anterior de LocalGateKeys y no puede sincronizar por Wi-Fi con este iPhone. Actualiza LocalGateKeys en ese dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ utilise une version plus ancienne de LocalGateKeys et ne peut pas se synchroniser par Wi-Fi avec cet iPhone. Mettez LocalGateKeys à jour sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usa una versione meno recente di LocalGateKeys e non può sincronizzarsi via Wi-Fi con questo iPhone. Aggiorna LocalGateKeys su quel dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は古いLocalGateKeysを使用しており、このiPhoneとWi-Fi経由で同期できません。そのデバイスのLocalGateKeysをアップデートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 이전 버전의 LocalGateKeys를 사용 중이라 이 iPhone과 Wi-Fi로 동기화할 수 없습니다. 해당 기기에서 LocalGateKeys를 업데이트하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gebruikt een oudere LocalGateKeys en kan niet via wifi met deze iPhone synchroniseren. Werk LocalGateKeys op dat apparaat bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ używa starszego LocalGateKeys i nie może synchronizować przez Wi-Fi z tym iPhonem. Zaktualizuj LocalGateKeys na tamtym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usa um LocalGateKeys mais antigo e não consegue sincronizar por Wi-Fi com este iPhone. Atualize o LocalGateKeys nesse dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 运行的是较旧的 LocalGateKeys，无法通过 Wi-Fi 与这台 iPhone 同步。请更新那台设备上的 LocalGateKeys。"
          }
        }
      }
    },
