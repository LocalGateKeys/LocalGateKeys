    "'%@' is not a login, note or passkey and was skipped." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist kein Login, keine Notiz und kein Passkey und wurde übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» no es un inicio de sesión, una nota ni una clave de acceso y se ha omitido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n'est ni un identifiant, ni une note, ni une clé d'accès et a été ignoré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" non è un accesso, una nota o una passkey ed è stato saltato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はログイン、メモ、パスキーのいずれでもないため、スキップしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@'은(는) 로그인, 메모, 패스키가 아니어서 건너뛰었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' is geen login, notitie of passkey en is overgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” nie jest loginem, notatką ani kluczem dostępu i został pominięty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" não é um login, nota ou chave de acesso e foi ignorado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不是登录信息、笔记或通行密钥，已跳过。"
          }
        }
      }
    },
    "'%@': custom fields and recovery codes have no place in a CXF file and were left out." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“: Benutzerdefinierte Felder und Wiederherstellungscodes haben in einer CXF-Datei keinen Platz und wurden weggelassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@»: los campos personalizados y los códigos de recuperación no caben en un archivo CXF y se han omitido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » : les champs personnalisés et les codes de récupération n'ont pas de place dans un fichier CXF et ont été omis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\": i campi personalizzati e i codici di recupero non trovano posto in un file CXF e sono stati omessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」: カスタムフィールドと復旧コードは CXF ファイルに入らないため、省きました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@': 사용자 지정 필드와 복구 코드는 CXF 파일에 넣을 수 없어 제외했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@': aangepaste velden en herstelcodes passen niet in een CXF-bestand en zijn weggelaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@”: pola niestandardowe i kody odzyskiwania nie mieszczą się w pliku CXF i zostały pominięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\": campos personalizados e códigos de recuperação não cabem em um arquivo CXF e foram deixados de fora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”：自定义字段和恢复代码无法放入 CXF 文件，已略去。"
          }
        }
      }
    },
    "'%@': passkey notes have no place in a CXF file and were left out." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“: Notizen zu Passkeys haben in einer CXF-Datei keinen Platz und wurden weggelassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@»: las notas de las claves de acceso no caben en un archivo CXF y se han omitido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » : les notes des clés d'accès n'ont pas de place dans un fichier CXF et ont été omises."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\": le note delle passkey non trovano posto in un file CXF e sono state omesse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」: パスキーのメモは CXF ファイルに入らないため、省きました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@': 패스키 메모는 CXF 파일에 넣을 수 없어 제외했습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@': notities bij passkeys passen niet in een CXF-bestand en zijn weggelaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@”: notatki kluczy dostępu nie mieszczą się w pliku CXF i zostały pominięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\": as notas das chaves de acesso não cabem em um arquivo CXF e foram deixadas de fora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”：通行密钥的备注无法放入 CXF 文件，已略去。"
          }
        }
      }
    },
    "'%@': this passkey's credential ID could not be read, so the passkey was skipped." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“: Die Anmeldedaten-ID dieses Passkeys konnte nicht gelesen werden, daher wurde der Passkey übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@»: no se pudo leer el ID de credencial de esta clave de acceso, así que se ha omitido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » : l’identifiant d’identification de cette clé d’accès est illisible, la clé d’accès a donc été ignorée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\": non è stato possibile leggere l’ID credenziale di questa passkey, quindi la passkey è stata saltata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」: このパスキーの認証情報 ID を読み取れなかったため、パスキーをスキップしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@': 이 패스키의 자격 증명 ID를 읽을 수 없어 패스키를 건너뛰었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@': de credential-ID van deze passkey kon niet worden gelezen, dus de passkey is overgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@”: nie udało się odczytać identyfikatora poświadczenia tego klucza dostępu, więc został pominięty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\": não foi possível ler o ID da credencial desta chave de acesso, então ela foi ignorada."
          }
