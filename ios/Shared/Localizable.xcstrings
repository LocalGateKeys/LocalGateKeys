    "Scheduled backups are skipped this session: the backup key could not be saved. The app tries again at the next unlock." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geplante Backups werden in dieser Sitzung übersprungen: Der Backup-Schlüssel konnte nicht gespeichert werden. Die App versucht es beim nächsten Entsperren erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias programadas se omiten en esta sesión: no se ha podido guardar la clave de copia de seguridad. La app lo volverá a intentar al desbloquear la próxima vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes planifiées sont ignorées pendant cette session : la clé de sauvegarde n’a pas pu être enregistrée. L’app réessaie au prochain déverrouillage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I backup programmati vengono saltati in questa sessione: non è stato possibile salvare la chiave del backup. L'app riproverà al prossimo sblocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションではスケジュールされたバックアップをスキップします。バックアップキーを保存できませんでした。次回のロック解除時にもう一度試します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 세션에서는 예약된 백업을 건너뜁니다. 백업 키를 저장하지 못했습니다. 다음 잠금 해제 때 다시 시도합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geplande back-ups worden deze sessie overgeslagen: de back-upsleutel kon niet worden opgeslagen. De app probeert het opnieuw bij de volgende ontgrendeling."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tej sesji zaplanowane kopie zapasowe są pomijane: nie udało się zapisać klucza kopii zapasowej. Aplikacja spróbuje ponownie przy następnym odblokowaniu."
          }
