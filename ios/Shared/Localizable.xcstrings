          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un IBAN se comprueba y se guarda sin espacios."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un IBAN viene controllato e salvato senza spazi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IBANはスペースなしでチェックされ、保存されます。"
