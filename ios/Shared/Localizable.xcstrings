    "Up to %lld codes can be pinned. Widgets and Shortcuts use the first %lld; Apple Watch shows all. Remove one first." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu %1$lld Codes können angeheftet werden. Widgets und Kurzbefehle nutzen die ersten %2$lld; die Apple Watch zeigt alle. Entfernen Sie zuerst einen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up to %1$lld codes can be pinned. Widgets and Shortcuts use the first %2$lld; Apple Watch shows all. Remove one first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes fijar hasta %1$lld códigos. Los widgets y Atajos usan los primeros %2$lld; el Apple Watch muestra todos. Quita uno primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez épingler jusqu’à %1$lld codes. Les widgets et Raccourcis utilisent les %2$lld premiers ; l’Apple Watch les affiche tous. Retirez-en un d’abord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi fissare fino a %1$lld codici. I widget e Comandi usano i primi %2$lld; Apple Watch li mostra tutti. Rimuovine prima uno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定できるコードは最大%1$lld件です。ウィジェットとショートカットは最初の%2$lld件を使い、Apple Watchはすべて表示します。先に1件削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코드는 최대 %1$lld개까지 고정할 수 있습니다. 위젯과 단축어는 처음 %2$lld개를 사용하고 Apple Watch는 모두 표시합니다. 먼저 하나를 제거하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt maximaal %1$lld codes vastzetten. Widgets en Opdrachten gebruiken de eerste %2$lld; Apple Watch toont ze allemaal. Verwijder er eerst een."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Można przypiąć najwyżej %1$lld kodów. Widżety i Skróty używają pierwszych %2$lld; Apple Watch pokazuje wszystkie. Najpierw usuń jeden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode fixar até %1$lld códigos. Os widgets e Atalhos usam os primeiros %2$lld; o Apple Watch mostra todos. Remova um primeiro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最多可固定 %1$lld 个验证码。小组件和快捷指令使用前 %2$lld 个；Apple Watch 显示全部。请先移除一个。"
          }
        }
      }
    },
    "Up to %lld earlier passwords from the last year are kept with the login and sync with it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis zu %lld frühere Passwörter des letzten Jahres werden bei der Anmeldung aufbewahrt und mit ihr synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conservan con el inicio de sesión hasta %lld contraseñas anteriores del último año, y se sincronizan con él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu’à %lld anciens mots de passe de la dernière année sont conservés avec l’identifiant et se synchronisent avec lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fino a %lld password precedenti dell'ultimo anno vengono conservate con l'accesso e si sincronizzano con esso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去1年間の以前のパスワードが最大%lld件まで、ログインとともに保持され、一緒に同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지난 1년의 이전 비밀번호 최대 %lld개가 로그인과 함께 보관되고 함께 동기화됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maximaal %lld eerdere wachtwoorden van het afgelopen jaar worden bij de login bewaard en synchroniseren ermee."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do %lld wcześniejszych haseł z ostatniego roku jest przechowywanych razem z loginem i synchronizuje się z nim."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Até %lld senhas anteriores do último ano são mantidas com o login e sincronizam com ele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "过去一年中最多 %lld 个以前的密码会与登录一起保留并同步。"
          }
        }
      }
    },
