      }
    },
    "%@ Nothing is checked automatically; the Security tab asks each time." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Nichts wird automatisch geprüft; der Tab „Sicherheit“ fragt jedes Mal nach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ No se comprueba nada automáticamente; la pestaña Seguridad pregunta cada vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Rien n’est vérifié automatiquement ; l’onglet Sécurité vous le demande à chaque fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Non viene controllato nulla automaticamente; la scheda Sicurezza lo chiede ogni volta."
