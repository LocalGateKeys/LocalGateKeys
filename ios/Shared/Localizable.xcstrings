    "Request sent. The owner's devices can refuse it during the waiting period (%lld days)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anfrage gesendet. Die Geräte des Inhabers können sie während der Wartezeit (%lld Tage) ablehnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitud enviada. Los dispositivos del titular pueden rechazarla durante el periodo de espera (%lld días)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande envoyée. Les appareils du propriétaire peuvent la refuser pendant le délai d’attente (%lld jours)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiesta inviata. I dispositivi del proprietario possono rifiutarla durante il periodo di attesa (%lld giorni)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "申請を送りました。所有者のデバイスは待機期間 (%lld 日) の間、申請を拒否できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청을 보냈습니다. 소유자의 기기는 대기 기간(%lld일) 동안 이 요청을 거부할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
