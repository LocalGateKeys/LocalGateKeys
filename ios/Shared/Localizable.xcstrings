    "Blocks background internet requests, website icons and breach checks" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blockiert Internetanfragen im Hintergrund, Website-Symbole und Datenleck-Prüfungen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea las solicitudes de internet en segundo plano, los iconos de sitios web y las comprobaciones de filtraciones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloque les requêtes Internet en arrière-plan, les icônes de sites web et les vérifications des fuites"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocca le richieste internet in background, le icone dei siti web e i controlli delle violazioni"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックグラウンドのインターネット通信、Webサイトのアイコン、漏えいの確認をブロックします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백그라운드 인터넷 요청, 웹사이트 아이콘, 유출 확인을 차단합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokkeert internetverzoeken op de achtergrond, websitepictogrammen en datalekcontroles"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokuje żądania internetowe w tle, ikony stron i sprawdzanie wycieków"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueia solicitações de internet em segundo plano, ícones de sites e verificações de vazamento"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阻止后台互联网请求、网站图标和泄露检查"
          }
        }
      }
    },
    "Blocks the app's optional internet features, such as breach checks. Your vault never needs the internet to work." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blockiert die optionalen Internetfunktionen der App, etwa Datenleck-Prüfungen. Ihr Tresor braucht das Internet nie, um zu funktionieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloquea las funciones opcionales de la app que usan internet, como las comprobaciones de filtraciones. Tu caja fuerte nunca necesita internet para funcionar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloque les fonctions facultatives de l’app qui utilisent internet, comme la vérification des fuites. Votre coffre n’a jamais besoin d’internet pour fonctionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocca le funzioni facoltative dell’app che usano internet, come i controlli delle violazioni. La tua cassaforte non ha mai bisogno di internet per funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "漏えいチェックなど、アプリの任意のインターネット機能をブロックします。保管庫はインターネットがなくても使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유출 확인 같은 앱의 선택적 인터넷 기능을 차단합니다. 보관함은 인터넷 없이도 항상 작동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokkeert de optionele internetfuncties van de app, zoals datalekcontroles. Je kluis heeft nooit internet nodig om te werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokuje opcjonalne funkcje aplikacji korzystające z internetu, takie jak sprawdzanie wycieków. Twój sejf nigdy nie potrzebuje internetu do działania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueia os recursos opcionais do app que usam a internet, como as verificações de vazamento. Seu cofre nunca precisa da internet para funcionar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
