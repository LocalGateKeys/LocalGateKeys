    "sync.theOtherDeviceMustJoin" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das andere Gerät muss der Synchronisierung auf diesem Gerät erneut beitreten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The other device must join sync again on that device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El otro dispositivo debe volver a unirse a la sincronización en ese dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autre appareil doit rejoindre de nouveau la synchronisation sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'altro dispositivo deve unirsi di nuovo alla sincronizzazione su quel dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一方のデバイスで、再び同期に参加する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기는 해당 기기에서 동기화에 다시 참여해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het andere apparaat moet op dat apparaat opnieuw bij de synchronisatie aansluiten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drugie urządzenie musi ponownie dołączyć do synchronizacji na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O outro dispositivo precisa entrar na sincronização novamente nesse dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
