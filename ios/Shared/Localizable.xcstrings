    "whatsNew.1.2.restore.detail" : {
      "comment" : "What's new 1.2 sheet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Holen Sie ein Handy-Backup (.lgkm) über Einstellungen › Import & Export zurück. Es wird übernommen, und nichts wird gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring back a phone backup (.lgkm) from Settings › Import & Export. It is merged in, and nothing is wiped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recupera una copia de seguridad del teléfono (.lgkm) desde Ajustes › Importar y exportar. Se combina con lo que tienes y no se borra nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupérez une sauvegarde de téléphone (.lgkm) depuis Paramètres › Import et export. Elle est fusionnée, et rien n’est effacé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recupera un backup del telefono (.lgkm) da Impostazioni › Importa ed esporta. Viene unito e non viene cancellato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 › インポートとエクスポートから、スマートフォンのバックアップ(.lgkm)を戻せます。統合されるので、何も消去されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 › 가져오기 및 내보내기에서 휴대폰 백업(.lgkm)을 되돌릴 수 있습니다. 병합되므로 아무것도 지워지지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haal een telefoonback-up (.lgkm) terug via Instellingen › Importeren en exporteren. Hij wordt samengevoegd en er wordt niets gewist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odzyskaj kopię zapasową telefonu (.lgkm) w Ustawienia › Import i eksport. Zostanie scalona i nic nie zostanie wymazane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
