          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saliste de la app mientras editabas una clave de API. Tus cambios se conservaron en este iPad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez quitté l’app pendant la modification d’une clé API. Vos modifications ont été conservées sur cet iPad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai lasciato l'app mentre modificavi una chiave API. Le tue modifiche sono state conservate su questo iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "APIキーの編集中にAppを離れました。変更内容はこのiPadに保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 키를 편집하는 동안 앱을 나갔습니다. 변경 사항은 이 iPad에 보관되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je verliet de app tijdens het bewerken van een API-sleutel. Je wijzigingen zijn op deze iPad bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opuszczono aplikację podczas edycji klucza API. Twoje zmiany zachowano na tym iPadzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você saiu do app ao editar uma chave de API. Suas alterações foram mantidas neste iPad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您在编辑 API 密钥时离开了应用。您的更改已保留在这台 iPad 上。"
          }
        }
      }
    },
