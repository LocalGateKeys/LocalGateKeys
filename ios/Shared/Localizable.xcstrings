    "Only scheduled backups made with the public key are re-locked. Older backups keep the password they were made with." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur geplante Backups, die mit dem öffentlichen Schlüssel erstellt wurden, werden neu verschlüsselt. Ältere Backups behalten das Passwort, mit dem sie erstellt wurden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se vuelven a cifrar las copias programadas hechas con la clave pública. Las copias más antiguas conservan la contraseña con la que se hicieron."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les sauvegardes planifiées créées avec la clé publique sont reverrouillées. Les anciennes sauvegardes gardent le mot de passe avec lequel elles ont été créées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono ricifrati solo i backup programmati creati con la chiave pubblica. I backup meno recenti mantengono la password con cui sono stati creati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再ロックされるのは、公開鍵で作成されたスケジュールされたバックアップだけです。以前のバックアップは作成時のパスワードのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공개 키로 만든 예약 백업만 다시 잠급니다. 이전 백업은 만들 때 사용한 비밀번호를 그대로 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen geplande back-ups die met de openbare sleutel zijn gemaakt, worden opnieuw vergrendeld. Oudere back-ups houden het wachtwoord waarmee ze zijn gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponownie blokowane są tylko zaplanowane kopie zapasowe utworzone kluczem publicznym. Starsze kopie zachowują hasło, którym je utworzono."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente os backups agendados feitos com a chave pública são bloqueados novamente. Backups mais antigos mantêm a senha com que foram criados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
