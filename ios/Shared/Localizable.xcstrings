    "Syncs when both are on the same Wi-Fi and LocalGateKeys is unlocked on the other device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisiert, wenn beide im selben WLAN sind und LocalGateKeys auf dem anderen Gerät entsperrt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sincroniza cuando ambos están en la misma Wi-Fi y LocalGateKeys está desbloqueado en el otro dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation a lieu quand les deux appareils sont sur le même réseau Wi-Fi et que LocalGateKeys est déverrouillé sur l’autre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sincronizza quando entrambi sono sullo stesso Wi-Fi e LocalGateKeys è sbloccato sull'altro dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方が同じWi-Fiに接続され、もう一方のデバイスでLocalGateKeysのロックが解除されているときに同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 기기가 같은 Wi-Fi에 있고 다른 기기에서 LocalGateKeys가 잠금 해제된 상태일 때 동기화됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchroniseert wanneer beide apparaten op hetzelfde wifi-netwerk zitten en LocalGateKeys op het andere apparaat is ontgrendeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizuje się, gdy oba urządzenia są w tej samej sieci Wi-Fi, a LocalGateKeys jest odblokowany na drugim urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
