    "collectionShare.stopText.mac" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ auf diesem Mac nicht mehr teilen? Die Sammlung und ihre Einträge bleiben hier. Die anderen behalten ihre Kopien, aber niemand kann mehr Personen hereinlassen oder entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop sharing “%@” on this Mac? The collection and its items stay here. The others keep their copies, but nobody can let people in or remove them any more."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dejar de compartir «%@» en este Mac? La colección y sus elementos se quedan aquí. Los demás conservan sus copias, pero ya nadie podrá dejar entrar ni quitar personas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêter de partager « %@ » sur ce Mac ? La collection et ses éléments restent ici. Les autres gardent leurs copies, mais plus personne ne pourra laisser entrer ou retirer des personnes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompere la condivisione di «%@» su questo Mac? La raccolta e i suoi elementi restano qui. Gli altri mantengono le loro copie, ma nessuno potrà più far entrare o rimuovere persone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacで「%@」の共有を停止しますか？ コレクションとその項目はここに残ります。ほかの人はコピーを保持しますが、人を承認したり削除したりすることは誰にもできなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 “%@” 공유를 중지할까요? 컬렉션과 그 항목은 여기에 남습니다. 다른 사람들은 사본을 유지하지만, 더 이상 아무도 사람을 승인하거나 제거할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppen met het delen van “%@” op deze Mac? De verzameling en de items blijven hier. De anderen houden hun kopieën, maar niemand kan nog mensen toelaten of verwijderen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończyć udostępnianie „%@” na tym Macu? Kolekcja i jej elementy zostaną tutaj. Pozostali zachowają swoje kopie, ale nikt nie będzie już mógł wpuszczać ani usuwać osób."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parar de compartilhar “%@” neste Mac? A coleção e os itens dela ficam aqui. Os outros mantêm suas cópias, mas ninguém mais poderá liberar ou remover pessoas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要在这台 Mac 上停止共享“%@”吗？集合及其项目会保留在这里。其他人保留各自的副本，但再也没有人能允许他人加入或移除他人。"
          }
        }
      }
    },
