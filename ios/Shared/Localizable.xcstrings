    "These passwords have not changed for over a year. Age alone is not a reason to change them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Passwörter haben sich seit über einem Jahr nicht geändert. Das Alter allein ist kein Grund, sie zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas contraseñas no han cambiado en más de un año. La antigüedad por sí sola no es motivo para cambiarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces mots de passe n’ont pas changé depuis plus d’un an. L’ancienneté seule n’est pas une raison de les changer."
          }
        },
        "it" : {
