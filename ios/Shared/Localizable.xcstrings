    "sync.oneItemNeedsANewer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Eintrag benötigt ein neueres LocalGateKeys auf diesem PC. Aktualisieren Sie LocalGateKeys; dieser Eintrag wartet bis dahin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One item needs a newer LocalGateKeys on this PC. Update LocalGateKeys; that item waits until then."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un elemento necesita una versión más reciente de LocalGateKeys en este PC. Actualiza LocalGateKeys; ese elemento espera hasta entonces."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un elemento richiede una versione più recente di LocalGateKeys su questo PC. Aggiorna LocalGateKeys; quell'elemento attende fino ad allora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目1件に、このPCのより新しいLocalGateKeysが必要です。LocalGateKeysを更新してください。それまでその項目は保留されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목 하나에는 이 PC의 더 새로운 LocalGateKeys가 필요합니다. LocalGateKeys를 업데이트하세요. 그때까지 해당 항목은 대기합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén item heeft een nieuwere LocalGateKeys op deze pc nodig. Werk LocalGateKeys bij; dat item wacht tot dan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden element wymaga nowszego LocalGateKeys na tym komputerze. Zaktualizuj LocalGateKeys; ten element poczeka do tego czasu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um item precisa de um LocalGateKeys mais novo neste PC. Atualize o LocalGateKeys; esse item aguarda até lá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一个项目需要这台电脑上有较新版本的 LocalGateKeys。请更新 LocalGateKeys；在此之前该项目会一直等待。"
          }
        }
      }
    },
