    },
    "Sends only a 5-character SHA-1 prefix over HTTPS with padding. The service sees your IP address. No password, full hash, username or website is sent." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet nur ein SHA-1-Präfix aus 5 Zeichen per HTTPS mit Padding. Der Dienst sieht Ihre IP-Adresse. Es werden weder Passwort, vollständiger Hash, Benutzername noch Website gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía solo un prefijo SHA-1 de 5 caracteres por HTTPS, con relleno. El servicio ve tu dirección IP. No se envía ninguna contraseña, hash completo, nombre de usuario ni sitio web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’envoie qu’un préfixe SHA-1 de 5 caractères via HTTPS, avec remplissage. Le service voit votre adresse IP. Aucun mot de passe, aucune empreinte complète, aucun nom d’utilisateur ni aucun site web n’est envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia solo un prefisso SHA-1 di 5 caratteri tramite HTTPS, con padding. Il servizio vede il tuo indirizzo IP. Non vengono inviati password, hash completi, nomi utente o siti web."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HTTPSで、パディング付きのSHA-1の先頭5文字のみを送信します。サービス側にはIPアドレスが見えます。パスワード、完全なハッシュ、ユーザー名、Webサイトは送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패딩을 적용하여 HTTPS로 5자 SHA-1 접두사만 보냅니다. 서비스는 사용자의 IP 주소를 볼 수 있습니다. 비밀번호, 전체 해시, 사용자 이름, 웹사이트는 전송되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstuurt alleen een SHA-1-voorvoegsel van 5 tekens via HTTPS, met padding. De dienst ziet je IP-adres. Er wordt geen wachtwoord, volledige hash, gebruikersnaam of website verstuurd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyła tylko 5-znakowy prefiks SHA-1 przez HTTPS z dopełnieniem. Usługa widzi Twój adres IP. Nie jest wysyłane żadne hasło, pełny skrót, nazwa użytkownika ani strona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia apenas um prefixo SHA-1 de 5 caracteres por HTTPS, com preenchimento. O serviço vê seu endereço IP. Nenhuma senha, hash completo, nome de usuário ou site é enviado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅通过 HTTPS 发送 5 个字符的 SHA-1 前缀（带填充）。该服务能看到您的 IP 地址。不会发送密码、完整哈希、用户名或网站。"
          }
        }
      }
    },
