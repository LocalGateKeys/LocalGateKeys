    "The vault's keys changed while this was running (for example the master password or the recovery phrase). Nothing was saved. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schlüssel des Tresors haben sich währenddessen geändert (zum Beispiel das Master-Passwort oder die Wiederherstellungsphrase). Es wurde nichts gespeichert. Versuchen Sie es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves de la bóveda cambiaron mientras se hacía esto (por ejemplo, la contraseña maestra o la frase de recuperación). No se ha guardado nada. Vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés du coffre-fort ont changé pendant l’exécution (par exemple le mot de passe principal ou la phrase de récupération). Rien n’a été enregistré. Réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiavi della cassaforte sono cambiate nel frattempo (per esempio la password principale o la frase di recupero). Non è stato salvato nulla. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "処理中に保管庫の鍵が変更されました (マスターパスワードやリカバリーフレーズなど)。何も保存されていません。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업하는 동안 보관함의 키가 바뀌었습니다(예: 마스터 비밀번호 또는 복구 문구). 아무것도 저장되지 않았습니다. 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sleutels van de kluis zijn intussen gewijzigd (bijvoorbeeld het hoofdwachtwoord of de herstelzin). Er is niets opgeslagen. Probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W trakcie tej operacji zmieniły się klucze sejfu (na przykład hasło główne lub fraza odzyskiwania). Nic nie zostało zapisane. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves do cofre mudaram enquanto isto era feito (por exemplo, a senha mestra ou a frase de recuperação). Nada foi salvo. Tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
