    "whatsNew.1.2.factors.detail" : {
      "comment" : "What's new 1.2 sheet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ergänzen Sie Ihr App-Passwort um eine Schlüsseldatei oder einen YubiKey (NFC), damit der Tresor beides zum Öffnen braucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a key file or a YubiKey (NFC) to your app password, so the vault needs both to open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un archivo de clave o una YubiKey (NFC) a la contraseña de la app, para que la bóveda necesite ambos para abrirse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un fichier clé ou une YubiKey (NFC) à votre mot de passe de l’app : le coffre-fort a alors besoin des deux pour s’ouvrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un file chiave o una YubiKey (NFC) alla password per app, così la cassaforte ha bisogno di entrambi per aprirsi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリパスワードにキーファイルまたは YubiKey(NFC)を追加すると、保管庫を開くには両方が必要になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 비밀번호에 키 파일 또는 YubiKey(NFC)를 추가하면 보관함을 열 때 둘 다 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een sleutelbestand of een YubiKey (NFC) toe aan je app-wachtwoord, zodat de kluis beide nodig heeft om te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj plik klucza lub YubiKey (NFC) do hasła aplikacji, aby do otwarcia sejfu były potrzebne oba."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um arquivo de chave ou uma YubiKey (NFC) à senha do app, para que o cofre precise dos dois para abrir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为应用密码加上密钥文件或 YubiKey(NFC),保险库需要两者才能打开。"
          }
        }
      }
    },
