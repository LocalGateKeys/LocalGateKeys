    "ipad.sync.theKeyFileInThe" : {
      "comment" : "iPad wording of \"The key file in the sync folder was altered. Sync stopped. …\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schlüsseldatei im Sync-Ordner wurde verändert. Sync wurde beendet. Wenn das immer wieder passiert, setzen Sie Sync auf diesem iPad zurück und treten Sie erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key file in the sync folder was altered. Sync stopped. If this keeps happening, reset sync on this iPad and join again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de claves de la carpeta de sincronización fue alterado. La sincronización se detuvo. Si esto sigue ocurriendo, restablece la sincronización en este iPad y únete de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de clé du dossier de synchronisation a été modifié. La synchronisation s’est arrêtée. Si cela se reproduit, réinitialisez la synchronisation sur cet iPad et rejoignez de nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file della chiave nella cartella di sincronizzazione è stato alterato. La sincronizzazione si è fermata. Se continua a succedere, reimposta la sincronizzazione su questo iPad e unisciti di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期フォルダ内の鍵ファイルが改ざんされました。同期を停止しました。これが繰り返される場合は、このiPadの同期をリセットして、もう一度参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화 폴더의 키 파일이 변조되었습니다. 동기화가 중지되었습니다. 계속 발생하면 이 iPad에서 동기화를 초기화하고 다시 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het sleutelbestand in de synchronisatiemap is gewijzigd. De synchronisatie is gestopt. Gebeurt dit steeds opnieuw, reset dan de synchronisatie op deze iPad en voeg opnieuw toe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik klucza w folderze synchronizacji został zmieniony. Synchronizacja zatrzymana. Jeśli to się powtarza, zresetuj synchronizację na tym iPadzie i dołącz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo de chave na pasta de sincronização foi alterado. A sincronização parou. Se isso continuar acontecendo, redefina a sincronização neste iPad e entre novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步文件夹中的密钥文件被改动过。同步已停止。如果此情况持续发生，请重置这台 iPad 上的同步并重新加入。"
          }
        }
      }
    },
    "ipad.sync.theKeyFileInThe2" : {
      "comment" : "iPad wording of \"The key file in the sync folder is damaged. Reset sync on t…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schlüsseldatei im Sync-Ordner ist beschädigt. Setzen Sie Sync auf diesem iPad zurück oder stellen Sie den Ordner wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
