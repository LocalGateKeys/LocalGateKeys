        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Er wordt niets automatisch gecontroleerd; het tabblad Beveiliging vraagt het telkens opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Nic nie jest sprawdzane automatycznie; karta Bezpieczeństwo pyta za każdym razem."
