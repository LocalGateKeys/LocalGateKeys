    "Vault, Sync, Security and Settings tabs. Search from the Vault, sort the list and pin favorites." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabs „Tresor“, „Sync“, „Sicherheit“ und „Einstellungen“. Suchen Sie im Tresor, sortieren Sie die Liste und heften Sie Favoriten an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pestañas Bóveda, Sincronización, Seguridad y Ajustes. Busca desde la Bóveda, ordena la lista y fija favoritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onglets Coffre-fort, Synchronisation, Sécurité et Réglages. Recherchez depuis le coffre-fort, triez la liste et épinglez des favoris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schede Cassaforte, Sincronizzazione, Sicurezza e Impostazioni. Cerca dalla Cassaforte, ordina l'elenco e fissa i preferiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「保管庫」「同期」「セキュリティ」「設定」のタブ。保管庫から検索し、リストを並べ替え、お気に入りを固定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관함, 동기화, 보안, 설정 탭. 보관함에서 검색하고, 목록을 정렬하고, 즐겨찾기를 고정하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tabbladen Kluis, Synchronisatie, Beveiliging en Instellingen. Zoek vanuit de Kluis, sorteer de lijst en zet favorieten vast."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karty Sejf, Sync, Bezpieczeństwo i Ustawienia. Wyszukuj z poziomu Sejfu, sortuj listę i przypinaj ulubione."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abas Cofre, Sincronização, Segurança e Ajustes. Busque no Cofre, ordene a lista e fixe favoritos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“保管库”“同步”“安全”和“设置”标签页。可在保管库中搜索、为列表排序并置顶收藏。"
          }
        }
      }
    },
