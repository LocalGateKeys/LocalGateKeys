        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보기, 복사, 입력할 때마다 본인 확인을 요청합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraagt bij elke weergave, kopie en invulling om te bevestigen dat jij het bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosi o potwierdzenie tożsamości przy każdym odsłonięciu, skopiowaniu i wypełnieniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pede para confirmar que é você a cada exibição, cópia e preenchimento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次显示、拷贝和填充时都要求确认是你本人。"
          }
        }
      }
    },
