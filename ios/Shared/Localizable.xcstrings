            "value" : "Wenn aus, bleiben gelöschte Einträge im Papierkorb, bis Sie sie löschen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está desactivado, los elementos eliminados permanecen en la papelera hasta que los borres"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé, les éléments supprimés restent dans la corbeille jusqu’à ce que vous les supprimiez"
          }
        },
        "it" : {
          "stringUnit" : {
