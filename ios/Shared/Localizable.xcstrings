    "sync.aDeviceCouldNotBe" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Gerät konnte in diesem Netzwerk nicht erreicht werden. Prüfen Sie, ob es im selben WLAN ist und LocalGateKeys dort entsperrt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A device could not be reached on this network. Check that it is on the same Wi-Fi and that LocalGateKeys is unlocked there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo contactar con un dispositivo en esta red. Comprueba que esté en el mismo Wi-Fi y que LocalGateKeys esté desbloqueado allí."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere un dispositivo su questa rete. Controlla che sia sulla stessa rete Wi-Fi e che LocalGateKeys sia sbloccato lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このネットワークでデバイスに接続できませんでした。同じWi-Fiに接続していること、そのデバイスでLocalGateKeysがロック解除されていることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 네트워크에서 기기에 연결할 수 없습니다. 같은 Wi-Fi에 있는지, 해당 기기에서 LocalGateKeys가 잠금 해제되어 있는지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een apparaat kon op dit netwerk niet worden bereikt. Controleer of het op hetzelfde wifi-netwerk zit en of LocalGateKeys daar is ontgrendeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się połączyć z urządzeniem w tej sieci. Sprawdź, czy jest w tej samej sieci Wi-Fi i czy LocalGateKeys jest tam odblokowany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível alcançar um dispositivo nesta rede. Verifique se ele está no mesmo Wi-Fi e se o LocalGateKeys está desbloqueado lá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法在此网络上连接到某台设备。请确认它与此电脑在同一个 Wi-Fi 上，并且那里的 LocalGateKeys 已解锁。"
          }
        }
      }
    },
