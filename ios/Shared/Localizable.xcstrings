          }
        }
      }
    },
    "The Windows data kept on this Mac (attachments, documents and settings from a restored Windows backup) can't be read. You can back up without it: every item is still included." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die auf diesem Mac aufbewahrten Windows-Daten (Anhänge, Dokumente und Einstellungen aus einem wiederhergestellten Windows-Backup) können nicht gelesen werden. Sie können ohne sie ein Backup erstellen: Jeder Eintrag ist weiterhin enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden leer los datos de Windows que se conservan en este Mac (archivos adjuntos, documentos y ajustes de una copia de seguridad de Windows restaurada). Puedes hacer la copia sin ellos: todos los elementos siguen incluidos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere i dati di Windows conservati su questo Mac (allegati, documenti e impostazioni di un backup di Windows ripristinato). Puoi eseguire il backup senza di essi: ogni elemento è comunque incluso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacに保持されているWindowsのデータ(復元したWindowsバックアップの添付ファイル、ドキュメント、設定)を読み取れません。それを除いてバックアップできます。すべての項目は引き続き含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에 보관된 Windows 데이터(복원한 Windows 백업의 첨부 파일, 문서, 설정)를 읽을 수 없습니다. 이 데이터 없이 백업할 수 있으며 모든 항목은 그대로 포함됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Windows-gegevens die op deze Mac worden bewaard (bijlagen, documenten en instellingen uit een herstelde Windows-back-up) kunnen niet worden gelezen. Je kunt een back-up maken zonder: elk item zit er nog steeds in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można odczytać danych z Windows przechowywanych na tym Maku (załączników, dokumentów i ustawień z przywróconej kopii zapasowej z Windows). Możesz wykonać kopię zapasową bez nich: każdy element nadal w niej jest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível ler os dados do Windows mantidos neste Mac (anexos, documentos e ajustes de um backup do Windows restaurado). Você pode fazer backup sem eles: todos os itens continuam incluídos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 上保留的 Windows 数据（来自已还原 Windows 备份的附件、文档和设置）无法读取。您可以不含它进行备份：所有项目仍会包含在内。"
          }
        }
      }
    },
    "The accounts could not be saved on this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Konten konnten nicht auf diesem Gerät gespeichert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron guardar las cuentas en este dispositivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare gli account su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントをこのデバイスに保存できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에 계정을 저장할 수 없었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De accounts konden niet op dit apparaat worden bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać kont na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível salvar as contas neste dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法在此设备上保存这些账户。"
          }
        }
      }
    },
    "The app password file on this iPhone is damaged, so neither the app password nor the recovery phrase can open it. Use Start fresh, then restore a backup if you have one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App-Passwort-Datei auf diesem iPhone ist beschädigt, daher können weder das App-Passwort noch die Wiederherstellungsphrase sie öffnen. Verwenden Sie „Neu beginnen“ und stellen Sie dann ein Backup wieder her, falls Sie eines haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de la contraseña de la app en este iPhone está dañado, por lo que ni la contraseña de la app ni la frase de recuperación pueden abrirlo. Usa Empezar de cero y luego restaura una copia de seguridad si tienes una."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file della password per app su questo iPhone è danneggiato, quindi né la password per app né la frase di recupero possono aprirlo. Usa Ricomincia da zero, poi ripristina un backup se ne hai uno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneのアプリパスワードファイルが破損しているため、アプリパスワードでもリカバリーフレーズでも開けません。「最初からやり直す」を使い、バックアップがあれば復元してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone의 앱 비밀번호 파일이 손상되어 앱 비밀번호도 복구 문구도 보관함을 열 수 없습니다. 새로 시작을 사용한 다음, 백업이 있으면 복원하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het app-wachtwoordbestand op deze iPhone is beschadigd, dus noch het app-wachtwoord noch de herstelzin kan het openen. Gebruik Opnieuw beginnen en herstel daarna een back-up als je er een hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik hasła aplikacji na tym iPhonie jest uszkodzony, więc nie otworzy go ani hasło aplikacji, ani fraza odzyskiwania. Użyj opcji Zacznij od nowa, a potem przywróć kopię zapasową, jeśli ją masz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo da senha do app neste iPhone está danificado, então nem a senha do app nem a frase de recuperação conseguem abri-lo. Use Começar do zero e depois restaure um backup, se tiver um."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPhone 上的应用密码文件已损坏，因此应用密码和恢复短语都无法打开它。请使用“重新开始”，如果有备份，再还原备份。"
          }
        }
      }
    },
    "The app password is already on." : {
      "extractionState" : "manual",
      "localizations" : {
