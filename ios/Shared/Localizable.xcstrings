          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se comprobaron %1$lld contraseñas únicas · %2$lld inicios de sesión expuestos · %3$lld errores. Que no se encuentre no demuestra que una contraseña sea segura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
