    "Are you sure? Leave sync on this Mac now?" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher? Sync auf diesem Mac jetzt verlassen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro? ¿Salir ahora de la sincronización en este Mac?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vraiment quitter la synchronisation sur ce Mac maintenant ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro? Uscire ora dalla sincronizzazione su questo Mac?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よろしいですか? このMacの同期から今すぐ退出しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정말 지금 이 Mac에서 동기화를 나가시겠습니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je het zeker? Nu de synchronisatie op deze Mac verlaten?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na pewno? Opuścić teraz synchronizację na tym Maku?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza? Sair da sincronização neste Mac agora?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确定吗？现在退出这台 Mac 上的同步？"
          }
        }
      }
    },
