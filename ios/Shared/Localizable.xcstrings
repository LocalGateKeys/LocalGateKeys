          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい同期パスワードを設定してください。現在のものとは異なる必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 동기화 비밀번호를 선택하세요. 현재 비밀번호와 달라야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een nieuw synchronisatiewachtwoord; het moet verschillen van het huidige."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz nowe hasło synchronizacji; musi różnić się od obecnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma nova senha de sincronização; ela deve ser diferente da atual."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请选择新的同步密码；它必须与当前的不同。"
          }
        }
      }
    },
    "sync.chooseThisOnlyIfYou" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie dies nur, wenn Sie den Tresor dieses PCs selbst aus einem Backup wiederhergestellt haben. Ihren anderen Geräten wird mitgeteilt, dass diese Kopie jetzt die aktuelle ist, und die Warnung verschwindet.\n\nWenn Sie kein Backup wiederhergestellt haben, wählen Sie „Abbrechen“, prüfen Sie die letzten Änderungen und ändern Sie Ihr Master-Passwort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose this only if you restored this PC's vault from a backup yourself. Your other devices are told this copy is now the current one, and the warning stops.\n\nIf you did not restore a backup, choose Cancel, check recent changes and change your master password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige esto solo si tú mismo restauraste la bóveda de este PC desde una copia de seguridad. A tus otros dispositivos se les dice que esta copia es ahora la actual, y la advertencia desaparece.\n\nSi no restauraste una copia de seguridad, elige Cancelar, revisa los cambios recientes y cambia tu contraseña maestra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli questa opzione solo se hai ripristinato tu stesso la cassaforte di questo PC da un backup. Agli altri dispositivi viene comunicato che questa copia ora è quella attuale e l'avviso scompare.\n\nSe non hai ripristinato un backup, scegli Annulla, controlla le modifiche recenti e cambia la password principale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分でバックアップからこのPCの保管庫を復元した場合にのみ、これを選んでください。ほかのデバイスには、このコピーが現在のものになったと通知され、警告は表示されなくなります。\n\nバックアップを復元していない場合は「キャンセル」を選び、最近の変更を確認して、マスターパスワードを変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 PC의 보관함을 직접 백업에서 복원한 경우에만 선택하세요. 다른 기기에는 이 사본이 현재 사본이라고 알려지며 경고가 중지됩니다.\n\n백업을 복원하지 않았다면 취소를 선택하고 최근 변경 사항을 확인한 다음 마스터 비밀번호를 변경하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies dit alleen als je de kluis van deze pc zelf uit een back-up hebt hersteld. Je andere apparaten krijgen te horen dat deze kopie nu de huidige is, en de waarschuwing stopt.\n\nAls je geen back-up hebt hersteld, kies dan Annuleren, controleer recente wijzigingen en wijzig je hoofdwachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz to tylko wtedy, gdy sejf tego komputera został przez Ciebie samodzielnie przywrócony z kopii zapasowej. Pozostałe urządzenia dowiedzą się, że ta kopia jest teraz bieżąca, a ostrzeżenie zniknie.\n\nJeśli nie przywracano kopii zapasowej, wybierz Anuluj, sprawdź ostatnie zmiany i zmień hasło główne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha isto somente se você mesmo restaurou o cofre deste PC a partir de um backup. Seus outros dispositivos são informados de que esta cópia agora é a atual, e o aviso deixa de aparecer.\n\nSe você não restaurou um backup, escolha Cancelar, confira as alterações recentes e altere sua senha mestra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在您自己用备份还原了这台电脑的保管库时才选择此项。您的其他设备会被告知这个副本现在是最新的，警告也会停止。\n\n如果您没有还原过备份，请选择“取消”，检查最近的更改并更改您的主密码。"
          }
        }
      }
    },
