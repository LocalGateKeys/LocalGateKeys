    "secret_scan.intro.mac" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sucht nach privaten SSH-Schlüsseln in .ssh-Ordnern und nach .env-Dateien in dem Ordner, den du wählst. Es liest Dateien nur, zeigt nie Werte und löscht oder verschiebt nie etwas."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looks for SSH private keys in .ssh folders and for .env files in the folder you choose. It only reads files, never shows values, and never deletes or moves anything."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca claves privadas SSH en carpetas .ssh y archivos .env en la carpeta que elijas. Solo lee archivos, nunca muestra valores y nunca elimina ni mueve nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche les clés privées SSH dans les dossiers .ssh et les fichiers .env dans le dossier que vous choisissez. Elle lit seulement les fichiers, n’affiche jamais de valeurs et ne supprime ni ne déplace rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca chiavi private SSH nelle cartelle .ssh e file .env nella cartella che scegli. Legge solo i file, non mostra mai i valori e non elimina né sposta nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだフォルダ内の .ssh フォルダにある SSH 秘密鍵と .env ファイルを探します。ファイルを読むだけで、値を表示したり、削除や移動をしたりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 폴더에서 .ssh 폴더의 SSH 개인 키와 .env 파일을 찾습니다. 파일을 읽기만 하며, 값을 보여 주거나 무엇을 삭제하거나 옮기지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoekt naar persoonlijke SSH-sleutels in .ssh-mappen en naar .env-bestanden in de map die je kiest. Leest alleen bestanden, toont nooit waarden en verwijdert of verplaatst nooit iets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szuka prywatnych kluczy SSH w folderach .ssh i plików .env w wybranym folderze. Tylko czyta pliki, nigdy nie pokazuje wartości i niczego nie usuwa ani nie przenosi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procura chaves privadas SSH em pastas .ssh e arquivos .env na pasta que você escolher. Só lê arquivos, nunca mostra valores e nunca apaga nem move nada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你选择的文件夹中查找 .ssh 文件夹里的 SSH 私钥和 .env 文件。它只读取文件，从不显示值，也从不删除或移动任何内容。"
          }
        }
      }
    },
