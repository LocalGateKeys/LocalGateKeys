    "collectionShare.sharedDone" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist geteilt. Nennen Sie den anderen das Freigabepasswort und wo der Ordner liegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is shared. Tell the others the share password and where the folder is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» está compartida. Di a los demás la contraseña y dónde está la carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est partagée. Donnez aux autres le mot de passe de partage et l’emplacement du dossier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» è condivisa. Comunica agli altri la password di condivisione e dove si trova la cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を共有しました。ほかの人に共有パスワードとフォルダーの場所を伝えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”을(를) 공유했습니다. 다른 사람들에게 공유 비밀번호와 폴더 위치를 알려 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is gedeeld. Vertel de anderen het deelwachtwoord en waar de map staat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolekcja „%@” jest udostępniona. Podaj innym hasło udostępniania i powiedz, gdzie jest folder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” está compartilhada. Conte aos outros a senha de compartilhamento e onde fica a pasta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已共享。请告诉其他人共享密码以及文件夹的位置。"
          }
        }
      }
    },
    "collectionShare.sharedTwice" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sammlung wird von zwei Ihrer Geräte geteilt; beenden Sie auf einem davon das Teilen oder verlassen Sie sie dort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This collection is shared from two of your devices; stop sharing or leave it on one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta colección se comparte desde dos de tus dispositivos; deja de compartirla o sal de ella en uno de ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette collection est partagée depuis deux de vos appareils ; arrêtez le partage ou quittez-la sur l'un d'eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa raccolta è condivisa da due dei tuoi dispositivi; interrompi la condivisione o lasciala su uno dei due."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコレクションはお使いの2台のデバイスから共有されています。どちらか一方で共有を停止するか、退出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 컬렉션은 내 기기 두 대에서 공유되고 있습니다. 그중 한 기기에서 공유를 중지하거나 나가세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze verzameling wordt vanaf twee van je apparaten gedeeld; stop met delen of verlaat haar op een van beide."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta kolekcja jest udostępniana z dwóch Twoich urządzeń; na jednym z nich zakończ udostępnianie albo ją opuść."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta coleção é compartilhada a partir de dois dispositivos seus; pare de compartilhar ou saia dela em um deles."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此集合由您的两台设备共享；请在其中一台上停止共享或退出。"
          }
        }
      }
    },
