    "sync.thisPcWasDroppedFrom" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser PC wurde aus der Mitgliederliste entfernt. Treten Sie dem Ordner erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This PC was dropped from the member list. Join the folder again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PC fue eliminado de la lista de miembros. Vuelve a unirte a la carpeta."
