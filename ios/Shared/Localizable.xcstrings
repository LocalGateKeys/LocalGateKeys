    "whatsNew.1.2.kit.detail" : {
      "comment" : "What's new 1.2 sheet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drucken Sie Ihre Wiederherstellungsschritte und Backup-Angaben aus und bewahren Sie sie sicher auf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Print your recovery steps and backup details, and keep them somewhere safe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprime tus pasos de recuperación y los datos de tus copias de seguridad, y guárdalos en un lugar seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprimez vos étapes de récupération et les détails de vos sauvegardes, et gardez-les en lieu sûr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stampa i passaggi di recupero e i dettagli dei backup e conservali in un posto sicuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復旧手順とバックアップの情報を印刷して、安全な場所に保管しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구 단계와 백업 정보를 인쇄해 안전한 곳에 보관하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Print je herstelstappen en back-upgegevens en bewaar ze op een veilige plek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydrukuj kroki odzyskiwania i dane kopii zapasowych i przechowuj je w bezpiecznym miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imprima os passos de recuperação e os detalhes dos backups e guarde-os em um lugar seguro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打印你的恢复步骤和备份信息,并存放在安全的地方。"
          }
        }
      }
    },
