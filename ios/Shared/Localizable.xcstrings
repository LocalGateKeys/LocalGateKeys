    "sync.thisPcCannotRemoveItself" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser PC kann sich nicht selbst entfernen. Verwenden Sie stattdessen „Synchronisierung verlassen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This PC cannot remove itself. Use Leave sync instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PC no puede quitarse a sí mismo. Usa Salir de la sincronización en su lugar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo PC non può rimuovere se stesso. Usa invece Esci dalla sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このPC自身は削除できません。代わりに「同期から退出」を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 PC는 스스로를 제거할 수 없습니다. 대신 동기화 나가기를 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze pc kan zichzelf niet verwijderen. Gebruik in plaats daarvan Synchronisatie verlaten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten komputer nie może usunąć samego siebie. Użyj zamiast tego Opuść synchronizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este PC não pode remover a si mesmo. Use Sair da sincronização."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台电脑无法移除自己。请改用“退出同步”。"
          }
        }
      }
    },
