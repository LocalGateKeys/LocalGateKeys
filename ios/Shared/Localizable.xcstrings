    "Your items stay as they are; only the password that opens them changes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Einträge bleiben unverändert; nur das Passwort, das sie öffnet, ändert sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus elementos se quedan como están; solo cambia la contraseña que los abre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi elementi restano come sono; cambia solo la password che li apre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目はそのままで、それらを開くパスワードのみが変わります。"
