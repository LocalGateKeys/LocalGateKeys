    "whatsNew.1.2.languages.detail" : {
      "comment" : "What's new 1.2 sheet",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys folgt der Sprache Ihres iPhones: Englisch, Französisch, Deutsch, Spanisch, Italienisch, Niederländisch, Polnisch, brasilianisches Portugiesisch, Japanisch, Koreanisch oder vereinfachtes Chinesisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys follows your iPhone's language: English, French, German, Spanish, Italian, Dutch, Polish, Brazilian Portuguese, Japanese, Korean or Simplified Chinese."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys usa el idioma de tu iPhone: inglés, francés, alemán, español, italiano, neerlandés, polaco, portugués de Brasil, japonés, coreano o chino simplificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys suit la langue de votre iPhone : anglais, français, allemand, espagnol, italien, néerlandais, polonais, portugais du Brésil, japonais, coréen ou chinois simplifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys segue la lingua del tuo iPhone: inglese, francese, tedesco, spagnolo, italiano, olandese, polacco, portoghese brasiliano, giapponese, coreano o cinese semplificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys は iPhone の言語で表示されます:英語、フランス語、ドイツ語、スペイン語、イタリア語、オランダ語、ポーランド語、ポルトガル語(ブラジル)、日本語、韓国語、簡体中国語。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys는 iPhone의 언어를 따릅니다: 영어, 프랑스어, 독일어, 스페인어, 이탈리아어, 네덜란드어, 폴란드어, 브라질 포르투갈어, 일본어, 한국어, 중국어 간체."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys volgt de taal van je iPhone: Engels, Frans, Duits, Spaans, Italiaans, Nederlands, Pools, Braziliaans Portugees, Japans, Koreaans of vereenvoudigd Chinees."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys używa języka Twojego iPhone’a: angielskiego, francuskiego, niemieckiego, hiszpańskiego, włoskiego, niderlandzkiego, polskiego, portugalskiego (Brazylia), japońskiego, koreańskiego lub chińskiego uproszczonego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LocalGateKeys segue o idioma do seu iPhone: inglês, francês, alemão, espanhol, italiano, holandês, polonês, português do Brasil, japonês, coreano ou chinês simplificado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LocalGateKeys 会使用你 iPhone 的语言:英语、法语、德语、西班牙语、意大利语、荷兰语、波兰语、巴西葡萄牙语、日语、韩语或简体中文。"
          }
        }
      }
    },
