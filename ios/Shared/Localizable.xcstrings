    "sync.thisPcSSyncIdentity" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierungsidentität dieses PCs passt nicht zu seiner Kopplung. Setzen Sie die Synchronisierung auf diesem PC zurück und koppeln Sie erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This PC's sync identity does not match its pairing. Reset sync on this PC and pair again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La identidad de sincronización de este PC no coincide con su emparejamiento. Restablece la sincronización en este PC y empareja de nuevo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'identità di sincronizzazione di questo PC non corrisponde alla sua associazione. Reimposta la sincronizzazione su questo PC e associalo di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このPCの同期用ID情報が、ペアリングと一致しません。このPCの同期をリセットして、もう一度ペアリングしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 PC의 동기화 ID가 페어링과 일치하지 않습니다. 이 PC에서 동기화를 초기화하고 다시 페어링하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De synchronisatie-identiteit van deze pc komt niet overeen met zijn koppeling. Reset de synchronisatie op deze pc en koppel opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tożsamość synchronizacji tego komputera nie zgadza się z jego parowaniem. Zresetuj synchronizację na tym komputerze i sparuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A identidade de sincronização deste PC não corresponde ao pareamento dele. Redefina a sincronização neste PC e pareie novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台电脑的同步身份与其配对不符。请重置这台电脑上的同步并重新配对。"
          }
        }
      }
    },
