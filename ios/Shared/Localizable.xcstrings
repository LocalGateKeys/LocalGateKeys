        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管庫は完全には消去されませんでした(削除できませんでした: %@)。「ロック解除」をタップしてもう一度消去するか、「それでも最初からやり直す」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보관함이 완전히 지워지지 않았습니다(삭제할 수 없음: %@). 잠금 해제를 탭하여 다시 지우거나 그래도 새로 시작하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kluis is niet volledig gewist (kon niet verwijderen: %@). Tik op Ontgrendelen om het wissen opnieuw te proberen, of op Toch opnieuw beginnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sejf nie został w pełni wymazany (nie udało się usunąć: %@). Dotknij Odblokuj, aby ponowić wymazywanie, lub Mimo to zacznij od nowa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cofre não foi totalmente apagado (não foi possível excluir: %@). Toque em Desbloquear para tentar apagar de novo, ou em Começar do zero mesmo assim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保管库未被完全抹掉（无法删除：%@）。请轻点“解锁”再次尝试抹掉，或选择“仍然重新开始”。"
          }
        }
      }
    },
