        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 이 보관함에 대해 불가능한 버전 번호를 보고하여 무시되었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
