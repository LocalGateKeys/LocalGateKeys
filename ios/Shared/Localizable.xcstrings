    "collectionShare.superseded" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand anderes ist im selben Moment beigetreten, daher hat Ihr Beitritt die anderen nicht erreicht. Treten Sie mit dem Freigabepasswort erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Someone else joined at the same moment, so your join did not reach the others. Join again with the share password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra persona se unió en el mismo momento, así que tu unión no llegó a los demás. Vuelve a unirte con la contraseña de la colección compartida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelqu’un d’autre a rejoint au même moment, votre adhésion n’a donc pas atteint les autres. Rejoignez à nouveau avec le mot de passe de partage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'altra persona si è unita nello stesso momento, quindi la tua adesione non ha raggiunto gli altri. Unisciti di nuovo con la password di condivisione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じタイミングで別の人が参加したため、あなたの参加は他のメンバーに届きませんでした。共有パスワードでもう一度参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 순간에 다른 사람이 참여해서 내 참여가 다른 사람들에게 전달되지 않았습니다. 공유 비밀번호로 다시 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iemand anders deed op hetzelfde moment mee, dus je deelname bereikte de anderen niet. Doe opnieuw mee met het deelwachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ktoś inny dołączył w tej samej chwili, więc Twoje dołączenie nie dotarło do pozostałych. Dołącz ponownie, używając hasła udostępniania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra pessoa entrou no mesmo momento, então sua entrada não chegou aos outros. Entre de novo com a senha de compartilhamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人在同一时刻加入，因此您的加入没有传达给其他人。请使用共享密码重新加入。"
          }
        }
      }
    },
    "collectionShare.tampered" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
