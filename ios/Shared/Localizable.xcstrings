          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립보드에 이미지가 없습니다. QR 코드의 스크린샷을 복사(⌃⇧⌘4)한 다음 붙여넣으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er staat geen afbeelding op het klembord. Kopieer een schermafbeelding van de QR-code (⌃⇧⌘4) en plak die daarna."
          }
        },
        "pl" : {
          "stringUnit" : {
