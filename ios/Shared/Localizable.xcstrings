    "Entries stay encrypted for %lld days. Expired entries are purged on the next vault write. Older backups may retain copies." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Einträge bleiben %lld Tage lang verschlüsselt. Abgelaufene Einträge werden beim nächsten Schreibvorgang im Tresor endgültig entfernt. Ältere Backups können Kopien enthalten."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Einträge bleiben %lld Tage lang verschlüsselt. Abgelaufene Einträge werden beim nächsten Schreibvorgang im Tresor endgültig entfernt. Ältere Backups können Kopien enthalten."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Entries stay encrypted for %lld day. Expired entries are purged on the next vault write. Older backups may retain copies."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Entries stay encrypted for %lld days. Expired entries are purged on the next vault write. Older backups may retain copies."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Las entradas permanecen cifradas durante %lld días. Las entradas caducadas se purgan en la siguiente escritura en la bóveda. Las copias de seguridad más antiguas pueden conservar copias."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Las entradas permanecen cifradas durante %lld días. Las entradas caducadas se purgan en la siguiente escritura en la bóveda. Las copias de seguridad más antiguas pueden conservar copias."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Le voci restano cifrate per %lld giorni. Le voci scadute vengono eliminate alla prossima scrittura della cassaforte. I backup più vecchi possono conservarne delle copie."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Le voci restano cifrate per %lld giorni. Le voci scadute vengono eliminate alla prossima scrittura della cassaforte. I backup più vecchi possono conservarne delle copie."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "エントリは%lld日間、暗号化されたまま残ります。期限切れのエントリは、次回の保管庫への書き込み時に消去されます。古いバックアップにコピーが残っている場合があります。"
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "항목은 %lld일 동안 암호화된 상태로 유지됩니다. 만료된 항목은 다음 보관함 쓰기 때 완전히 삭제됩니다. 이전 백업에 사본이 남아 있을 수 있습니다."
                }
              }
            }
          }
        },
        "nl" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Items blijven %lld dagen versleuteld. Verlopen items worden bij de volgende schrijfactie in de kluis verwijderd. Oudere back-ups kunnen kopieën bewaren."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Items blijven %lld dagen versleuteld. Verlopen items worden bij de volgende schrijfactie in de kluis verwijderd. Oudere back-ups kunnen kopieën bewaren."
                }
              }
            }
          }
        },
        "pl" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Wpisy pozostają zaszyfrowane przez %lld dni. Wygasłe wpisy są usuwane przy następnym zapisie sejfu. Starsze kopie zapasowe mogą zachować kopie."
                }
              },
              "many" : {
