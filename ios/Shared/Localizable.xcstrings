          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was removed from sync and was not contacted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se quitó de la sincronización y no se contactó con él."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stato rimosso dalla sincronizzazione e non è stato contattato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は同期から削除されており、接続しませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 동기화에서 제거되었으며 연락하지 않았습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is uit de synchronisatie verwijderd en er is geen contact mee gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ usunięto z synchronizacji i nie nawiązano z nim kontaktu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ foi removido da sincronização e não foi contatado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@已从同步中移除，未与其联系。"
          }
        }
      }
    },
    "sync.wasReplacedByAnOlder" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde durch eine ältere Kopie ersetzt (zum Beispiel aus dem Dateiverlauf der Cloud) und übersprungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was replaced by an older copy (for example from the cloud's file history) and was skipped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fue reemplazado por una copia más antigua (por ejemplo, del historial de archivos de la nube) y se omitió."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stato sostituito da una copia più vecchia (ad esempio dalla cronologia dei file del cloud) ed è stato saltato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が古いコピー(クラウドのファイル履歴からなど)に置き換えられたため、スキップしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 이전 사본(예: 클라우드의 파일 기록)으로 바뀌어 건너뛰었습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is door een oudere kopie vervangen (bijvoorbeeld uit de bestandsgeschiedenis van de cloud) en is overgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zostało zastąpione starszą kopią (na przykład z historii plików w chmurze) i zostało pominięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ foi substituído por uma cópia mais antiga (por exemplo, do histórico de arquivos da nuvem) e foi ignorado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@被较旧的副本替换（例如来自云端的文件历史记录），已被跳过。"
          }
        }
      }
    },
    "sync.wasRewrittenWithoutANew" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde ohne neue Versionsnummer neu geschrieben und übersprungen. Jemand mit Zugriff auf den Ordner hat sie möglicherweise verändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was rewritten without a new version number and was skipped. Someone with access to the folder may have altered it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se reescribió sin un número de versión nuevo y se omitió. Puede que alguien con acceso a la carpeta lo haya alterado."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stato riscritto senza un nuovo numero di versione ed è stato saltato. Qualcuno con accesso alla cartella potrebbe averlo alterato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が新しいバージョン番号なしで書き直されたため、スキップしました。フォルダーにアクセスできる誰かが改ざんした可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 새 버전 번호 없이 다시 쓰여 건너뛰었습니다. 폴더에 접근할 수 있는 누군가가 변경했을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is herschreven zonder nieuw versienummer en is overgeslagen. Iemand met toegang tot de map heeft het mogelijk gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zostało przepisane bez nowego numeru wersji i zostało pominięte. Ktoś z dostępem do folderu mógł to zmienić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ foi regravado sem um novo número de versão e foi ignorado. Alguém com acesso à pasta pode tê-lo alterado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@被重写且没有新的版本号，已被跳过。有权访问该文件夹的人可能篡改了它。"
          }
        }
      }
    },
    "sync.wasWrittenWithAnotherSync" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde mit einem anderen Synchronisierungsschlüssel geschrieben und wird ignoriert, bis dieses Gerät wieder synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ was written with another sync key and is ignored until that device syncs again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se escribió con otra clave de sincronización y se ignora hasta que ese dispositivo vuelva a sincronizarse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stato scritto con un'altra chiave di sincronizzazione e viene ignorato finché quel dispositivo non si sincronizza di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は別の同期キーで書き込まれており、そのデバイスが再び同期するまで無視されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 다른 동기화 키로 작성되었으며 해당 기기가 다시 동기화할 때까지 무시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is met een andere synchronisatiesleutel geschreven en wordt genegeerd totdat dat apparaat weer synchroniseert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ zapisano innym kluczem synchronizacji i jest ignorowane, dopóki to urządzenie nie zsynchronizuje się ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ foi gravado com outra chave de sincronização e é ignorado até que esse dispositivo sincronize novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@是用另一个同步密钥写入的，在该设备再次同步之前会被忽略。"
          }
        }
      }
    },
    "sync.wiFiSyncCouldNot" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die WLAN-Synchronisierung konnte nicht zu lauschen beginnen. Prüfen Sie Adresse und Port und dass keine andere App diesen Port verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi sync could not start listening. Check the address and port, and that no other app uses that port."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización por Wi-Fi no pudo empezar a escuchar. Comprueba la dirección y el puerto, y que ninguna otra aplicación use ese puerto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione Wi-Fi non è riuscita a mettersi in ascolto. Controlla l'indirizzo e la porta, e che nessun'altra app usi quella porta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi同期が待ち受けを開始できませんでした。アドレスとポートを確認し、ほかのアプリがそのポートを使っていないことも確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi 동기화가 수신을 시작할 수 없습니다. 주소와 포트를 확인하고, 다른 앱이 해당 포트를 사용하고 있지 않은지 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wifi-synchronisatie kon niet gaan luisteren. Controleer het adres en de poort, en dat geen andere app die poort gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja Wi-Fi nie mogła zacząć nasłuchiwać. Sprawdź adres i port oraz czy żadna inna aplikacja nie używa tego portu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização por Wi-Fi não conseguiu começar a escutar. Verifique o endereço e a porta e se nenhum outro app usa essa porta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wi-Fi 同步无法开始监听。请检查地址和端口，并确认没有其他应用占用该端口。"
          }
        }
      }
    },
