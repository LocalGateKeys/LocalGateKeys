    "sync.theSyncFolderHadAn" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Synchronisierungsordner enthielt eine ältere oder veränderte Schlüsseldatei. Dieser PC hat die vertrauenswürdige Kopie wieder eingesetzt; die Synchronisierung wird fortgesetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sync folder had an older or altered key file. This PC put the trusted copy back; sync continues."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carpeta de sincronización tenía un archivo de claves más antiguo o alterado. Este PC restauró la copia de confianza; la sincronización continúa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartella di sincronizzazione conteneva un file della chiave più vecchio o alterato. Questo PC ha rimesso a posto la copia attendibile; la sincronizzazione continua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期フォルダーに、古いか改ざんされたキーファイルがありました。このPCが信頼できるコピーを書き戻しました。同期は続行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화 폴더에 이전 또는 변경된 키 파일이 있었습니다. 이 PC가 신뢰할 수 있는 사본을 되돌렸으며 동기화는 계속됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De synchronisatiemap had een oudere of gewijzigde sleutelbestand. Deze pc heeft de vertrouwde kopie teruggezet; synchronisatie gaat door."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder synchronizacji miał starszy lub zmieniony plik klucza. Ten komputer przywrócił zaufaną kopię; synchronizacja trwa dalej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pasta de sincronização tinha um arquivo de chave mais antigo ou alterado. Este PC restaurou a cópia confiável; a sincronização continua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步文件夹中的密钥文件较旧或被改动过。这台电脑已放回可信的副本；同步继续进行。"
          }
        }
      }
    },
