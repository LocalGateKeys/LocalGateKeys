    "developer.agents.touchID.desc" : {
      "comment" : "AI agents (Mac): Settings > Developer and the approval panel",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach „Einmal erlauben“ wird nach Touch ID gefragt, oder nach deinem Master-Passwort, wenn Touch ID nicht verfügbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approve once then asks for Touch ID, or your master password when Touch ID is not available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras Aprobar una vez se pide Touch ID, o tu contraseña maestra si Touch ID no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après Approuver une fois, Touch ID est demandé, ou votre mot de passe principal si Touch ID n’est pas disponible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo Approva una volta viene chiesto Touch ID, o la tua password principale quando Touch ID non è disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「今回だけ承認」の後に Touch ID を求めます。Touch ID が使えない場合はマスターパスワードを求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 승인을 누르면 Touch ID를 요청하며, Touch ID를 사용할 수 없으면 마스터 비밀번호를 요청합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na Eén keer goedkeuren wordt om Touch ID gevraagd, of om je hoofdwachtwoord als Touch ID niet beschikbaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po kliknięciu Zatwierdź raz pojawia się prośba o Touch ID lub o hasło główne, gdy Touch ID jest niedostępne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de Aprovar uma vez, o Touch ID é pedido, ou sua senha mestra quando o Touch ID não estiver disponível."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按“仅批准一次”后会要求 Touch ID；Touch ID 不可用时要求输入主密码。"
          }
        }
      }
    },
