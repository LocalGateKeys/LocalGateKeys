    "sync.theKeyFileInThe5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schlüsseldatei im Synchronisierungsordner wurde durch eine ältere Kopie ersetzt und konnte nicht zurückgesetzt werden. Die Synchronisierung wurde angehalten. Prüfen Sie den Ordner oder setzen Sie die Synchronisierung auf diesem PC zurück und treten Sie erneut bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key file in the sync folder was replaced by an older copy and could not be put back. Sync stopped. Check the folder, or reset sync on this PC and join again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de claves de la carpeta de sincronización fue reemplazado por una copia más antigua y no se pudo restaurar. La sincronización se detuvo. Revisa la carpeta o restablece la sincronización en este PC y vuelve a unirte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de clé du dossier de synchronisation a été remplacé par une copie plus ancienne et n’a pas pu être remis en place. La synchronisation s’est arrêtée. Vérifiez le dossier, ou réinitialisez la synchronisation sur ce PC et rejoignez de nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file della chiave nella cartella di sincronizzazione è stato sostituito da una copia più vecchia e non è stato possibile rimetterlo a posto. Sincronizzazione interrotta. Controlla la cartella, oppure reimposta la sincronizzazione su questo PC e unisciti di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期フォルダー内のキーファイルが古いコピーに置き換えられ、元に戻せませんでした。同期を停止しました。フォルダーを確認するか、このPCの同期をリセットして、もう一度参加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화 폴더의 키 파일이 이전 사본으로 바뀌었으며 되돌릴 수 없었습니다. 동기화가 중지되었습니다. 폴더를 확인하거나 이 PC에서 동기화를 초기화하고 다시 참여하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het sleutelbestand in de synchronisatiemap is door een oudere kopie vervangen en kon niet worden teruggezet. Synchronisatie gestopt. Controleer de map, of reset de synchronisatie op deze pc en sluit opnieuw aan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik klucza w folderze synchronizacji został zastąpiony starszą kopią i nie udało się go przywrócić. Synchronizacja zatrzymana. Sprawdź folder lub zresetuj synchronizację na tym komputerze i dołącz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo de chave na pasta de sincronização foi substituído por uma cópia mais antiga e não pôde ser restaurado. A sincronização parou. Verifique a pasta, ou redefina a sincronização neste PC e entre novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步文件夹中的密钥文件被较旧的副本替换，且无法恢复原状。同步已停止。请检查该文件夹，或重置这台电脑上的同步并重新加入。"
          }
        }
      }
    },
