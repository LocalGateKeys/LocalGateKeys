    "factors.mac.yubikeyAccessDenied" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat LocalGateKeys den Zugriff auf den YubiKey nicht erlaubt. Erlauben Sie LocalGateKeys unter Systemeinstellungen › Datenschutz & Sicherheit › Eingabeüberwachung und versuchen Sie es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS did not let LocalGateKeys use the YubiKey. Allow LocalGateKeys in System Settings › Privacy & Security › Input Monitoring, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no dejó que LocalGateKeys usara la YubiKey. Permite LocalGateKeys en Ajustes del Sistema › Privacidad y seguridad › Monitorización de entrada y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n’a pas autorisé LocalGateKeys à utiliser la YubiKey. Autorisez LocalGateKeys dans Réglages Système › Confidentialité et sécurité › Surveillance de l’entrée, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non ha permesso a LocalGateKeys di usare la YubiKey. Consenti LocalGateKeys in Impostazioni di Sistema › Privacy e sicurezza › Monitoraggio dell’input, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS により、LocalGateKeys による YubiKey の使用が許可されませんでした。システム設定 › プライバシーとセキュリティ › 入力監視 で LocalGateKeys を許可してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS에서 LocalGateKeys의 YubiKey 사용을 허용하지 않았습니다. 시스템 설정 › 개인정보 보호 및 보안 › 입력 모니터링에서 LocalGateKeys를 허용한 다음 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS heeft LocalGateKeys geen toegang tot de YubiKey gegeven. Sta LocalGateKeys toe in Systeeminstellingen › Privacy en beveiliging › Invoermonitoring en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nie pozwolił LocalGateKeys użyć klucza YubiKey. Zezwól LocalGateKeys w Ustawieniach systemowych › Prywatność i ochrona › Monitorowanie wprowadzania, a potem spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS não permitiu que o LocalGateKeys usasse a YubiKey. Permita o LocalGateKeys em Ajustes do Sistema › Privacidade e Segurança › Monitoramento de Entrada e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 未允许 LocalGateKeys 使用 YubiKey。请在“系统设置 › 隐私与安全性 › 输入监控”中允许 LocalGateKeys，然后重试。"
          }
        }
      }
    },
