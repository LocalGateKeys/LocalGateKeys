    "sync.aFileAttachedOnAnother" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine auf einem anderen Gerät angehängte Datei ist noch nicht angekommen. Der zugehörige Eintrag erscheint nach einer Synchronisierung, die die Datei empfängt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A file attached on another device has not arrived yet. Its item appears after a sync that receives the file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo adjuntado en otro dispositivo aún no ha llegado. Su elemento aparece tras una sincronización que reciba el archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier joint sur un autre appareil n’est pas encore arrivé. Son élément apparaît après une synchronisation qui reçoit le fichier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file allegato su un altro dispositivo non è ancora arrivato. Il suo elemento compare dopo una sincronizzazione che riceve il file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のデバイスで添付されたファイルがまだ届いていません。そのファイルを受信する同期の後に、項目が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 기기에서 첨부한 파일이 아직 도착하지 않았습니다. 파일을 받는 동기화 후에 해당 항목이 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een op een ander apparaat bijgevoegd bestand is nog niet aangekomen. Het bijbehorende item verschijnt na een synchronisatie die het bestand ontvangt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik załączony na innym urządzeniu jeszcze nie dotarł. Jego element pojawi się po synchronizacji, która odbierze plik."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo anexado em outro dispositivo ainda não chegou. O item dele aparece após uma sincronização que receba o arquivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在另一台设备上添加的文件尚未到达。收到该文件的同步完成后，它所属的项目才会出现。"
          }
        }
      }
    },
