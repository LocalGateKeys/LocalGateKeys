    "ipad.upgradeView.noSubscriptionAndNo" : {
      "comment" : "iPad wording of \"No subscription and no account. Restore it on another iPhon…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Abo und kein Konto. Stellen Sie es auf einem anderen iPad mit demselben Apple Account wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No subscription and no account. Restore it on another iPad with the same Apple Account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin suscripción y sin cuenta. Restáurala en otro iPad con la misma cuenta de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni abonnement ni compte. Restaurez-le sur un autre iPad avec le même compte Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun abbonamento e nessun account. Ripristinalo su un altro iPad con lo stesso Apple Account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションもアカウントも不要です。同じApple Accountなら、別のiPadでも復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독이나 계정이 필요 없습니다. 같은 Apple 계정으로 다른 iPad에서 복원하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen abonnement en geen account. Herstel het op een andere iPad met hetzelfde Apple-account."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez subskrypcji i bez konta. Przywróć go na innym iPadzie z tym samym kontem Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
