    "Row %lld: card details could not be stored as a payment card (%@); imported as a secure note." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeile %1$lld: Die Kartendaten konnten nicht als Zahlungskarte gespeichert werden (%2$@); als sichere Notiz importiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Row %1$lld: card details could not be stored as a payment card (%2$@); imported as a secure note."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fila %1$lld: los datos de la tarjeta no se pudieron guardar como tarjeta de pago (%2$@); importada como nota segura."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
