    "sync.theSyncKeyInThat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Synchronisierungsschlüssel in diesem Ordner hat sich geändert, nachdem dieser PC gekoppelt wurde. Verlassen Sie die Synchronisierung auf diesem PC und verwenden Sie dann „Einem Ordner beitreten“ mit dem aktuellen Synchronisierungspasswort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sync key in that folder changed after this PC was paired. Leave sync on this PC, then use Join a folder with the current sync password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave de sincronización de esa carpeta cambió después de emparejar este PC. Sal de la sincronización en este PC y luego usa Unirse a una carpeta con la contraseña de sincronización actual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave di sincronizzazione in quella cartella è cambiata dopo l'associazione di questo PC. Esci dalla sincronizzazione su questo PC, poi usa Unisciti a una cartella con la password di sincronizzazione attuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのフォルダー内の同期キーが、このPCのペアリング後に変更されました。このPCで同期から退出し、現在の同期パスワードで「フォルダーに参加」を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 PC를 페어링한 후 해당 폴더의 동기화 키가 변경되었습니다. 이 PC에서 동기화 나가기를 실행한 다음 현재 동기화 비밀번호로 폴더 참여를 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De synchronisatiesleutel in die map is gewijzigd nadat deze pc was gekoppeld. Verlaat de synchronisatie op deze pc en gebruik dan Een map toevoegen met het huidige synchronisatiewachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucz synchronizacji w tym folderze zmienił się po sparowaniu tego komputera. Opuść synchronizację na tym komputerze, a potem użyj Dołącz do folderu z bieżącym hasłem synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave de sincronização dessa pasta mudou depois que este PC foi pareado. Saia da sincronização neste PC e depois use Entrar em uma pasta com a senha de sincronização atual."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该文件夹中的同步密钥在这台电脑配对之后发生了变化。请在这台电脑上退出同步，然后使用当前的同步密码选择“加入文件夹”。"
          }
        }
      }
    },
