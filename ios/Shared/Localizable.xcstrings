    "sync.didNotMatchItsPairing" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stimmte nicht mit seiner Kopplung überein und wurde nicht synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ did not match its pairing and was not synced."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no coincidió con su emparejamiento y no se sincronizó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne correspondait pas à son association et n’a pas été synchronisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
