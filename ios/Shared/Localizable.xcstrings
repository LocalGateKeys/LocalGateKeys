    "Only bounded event types, results, counts, and item IDs are shown; secrets are never logged." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es werden nur begrenzte Ereignistypen, Ergebnisse, Zähler und Eintrags-IDs angezeigt; Geheimnisse werden nie protokolliert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se muestran tipos de evento acotados, resultados, recuentos e ID de elementos; los secretos nunca se registran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les types d’événements bornés, les résultats, les nombres et les ID d’éléments sont affichés ; les secrets ne sont jamais consignés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono mostrati solo tipi di evento, risultati, conteggi e ID di elemento limitati; i segreti non vengono mai registrati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示されるのは、限定されたイベントの種類、結果、件数、項目IDのみです。秘密情報がログに記録されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제한된 이벤트 유형, 결과, 횟수, 항목 ID만 표시되며 비밀 정보는 절대 기록되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen begrensde gebeurtenistypen, resultaten, aantallen en item-ID's worden getoond; geheimen worden nooit gelogd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazywane są tylko ograniczone typy zdarzeń, wyniki, liczniki i identyfikatory elementów; sekrety nigdy nie są zapisywane w dzienniku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente tipos de evento limitados, resultados, contagens e IDs de itens são mostrados; os segredos nunca são registrados em log."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
