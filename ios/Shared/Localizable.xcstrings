    "Other browsers aren't supported on the Mac yet. Use Safari, or AutoFill in apps that support it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Browser werden auf dem Mac noch nicht unterstützt. Verwenden Sie Safari oder AutoFill in Apps, die es unterstützen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los otros navegadores aún no se admiten en el Mac. Usa Safari o el autorrelleno en las apps compatibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli altri browser non sono ancora supportati sul Mac. Usa Safari, oppure la compilazione automatica nelle app che la supportano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その他のブラウザはMacではまだサポートされていません。Safariを使うか、対応するAppでAutoFillを使ってください。"
