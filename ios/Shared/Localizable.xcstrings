    "developer.setup.forwarding.mac" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent-Weiterleitung wird nicht bedient: Verwende ssh -A nicht mit diesem Agenten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent forwarding is not served: do not use ssh -A with this agent."
          }
        },
        "es" : {
          "stringUnit" : {
