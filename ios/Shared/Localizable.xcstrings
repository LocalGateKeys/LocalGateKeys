    },
    "The backup key on this Mac could not be read. Nothing was changed. Try again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Backup-Schlüssel auf diesem Mac konnte nicht gelesen werden. Es wurde nichts geändert. Versuchen Sie es später noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer la clave de copia de seguridad de este Mac. No se ha cambiado nada. Vuelve a intentarlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé de sauvegarde de ce Mac n’a pas pu être lue. Rien n’a été modifié. Réessayez plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile leggere la chiave del backup su questo Mac. Non è stato modificato nulla. Riprova più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac のバックアップキーを読み取れませんでした。何も変更されていません。しばらくしてからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac의 백업 키를 읽을 수 없습니다. 아무것도 변경되지 않았습니다. 나중에 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De back-upsleutel op deze Mac kon niet worden gelezen. Er is niets gewijzigd. Probeer het later opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odczytać klucza kopii zapasowej na tym Macu. Nic nie zostało zmienione. Spróbuj ponownie później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler a chave de backup neste Mac. Nada foi alterado. Tente novamente mais tarde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取这台 Mac 上的备份密钥。未做任何更改。请稍后再试。"
          }
        }
      }
    },
    "The backup key on this Mac is damaged, so scheduled backups are skipped. Set a new backup password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Backup-Schlüssel auf diesem Mac ist beschädigt, daher werden geplante Backups übersprungen. Legen Sie ein neues Backup-Passwort fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave de copia de seguridad de este Mac está dañada, así que se omiten las copias programadas. Establece una nueva contraseña de copia de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé de sauvegarde de ce Mac est endommagée ; les sauvegardes planifiées sont donc ignorées. Définissez un nouveau mot de passe de sauvegarde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave del backup su questo Mac è danneggiata, quindi i backup programmati vengono saltati. Imposta una nuova password del backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac のバックアップキーが破損しているため、スケジュールされたバックアップはスキップされます。新しいバックアップパスワードを設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac의 백업 키가 손상되어 예약된 백업을 건너뜁니다. 새 백업 비밀번호를 설정하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De back-upsleutel op deze Mac is beschadigd, dus geplande back-ups worden overgeslagen. Stel een nieuw back-upwachtwoord in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucz kopii zapasowej na tym Macu jest uszkodzony, więc zaplanowane kopie zapasowe są pomijane. Ustaw nowe hasło kopii zapasowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave de backup neste Mac está danificada, então os backups agendados são ignorados. Defina uma nova senha de backup."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 上的备份密钥已损坏，因此会跳过定时备份。请设置新的备份密码。"
          }
        }
      }
    },
    "The backup key on this Mac is damaged. The newest backup password here was set on %@. Scheduled backups are paused until you enter that backup password, or reset it with the recovery phrase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Backup-Schlüssel auf diesem Mac ist beschädigt. Das neueste Backup-Passwort hier wurde am %@ festgelegt. Geplante Backups sind pausiert, bis Sie dieses Backup-Passwort eingeben oder es mit der Wiederherstellungsphrase zurücksetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave de copia de seguridad de este Mac está dañada. La contraseña de copia de seguridad más reciente aquí se estableció el %@. Las copias programadas están en pausa hasta que escribas esa contraseña o la restablezcas con la frase de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé de sauvegarde de ce Mac est endommagée. Le mot de passe de sauvegarde le plus récent ici a été défini le %@. Les sauvegardes planifiées sont en pause jusqu’à ce que vous saisissiez ce mot de passe de sauvegarde, ou que vous le réinitialisiez avec la phrase de récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave del backup su questo Mac è danneggiata. La password del backup più recente qui è stata impostata il %@. I backup programmati sono in pausa finché non inserisci quella password del backup o la reimposti con la frase di recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac のバックアップキーが破損しています。ここで最も新しいバックアップパスワードは %@ に設定されたものです。そのバックアップパスワードを入力するか、リカバリーフレーズでリセットするまで、スケジュールされたバックアップは一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac의 백업 키가 손상되었습니다. 여기서 가장 최근의 백업 비밀번호는 %@에 설정되었습니다. 그 백업 비밀번호를 입력하거나 복구 문구로 재설정할 때까지 예약된 백업이 일시 중지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De back-upsleutel op deze Mac is beschadigd. Het nieuwste back-upwachtwoord hier is ingesteld op %@. Geplande back-ups zijn gepauzeerd totdat je dat back-upwachtwoord invoert, of het opnieuw instelt met de herstelzin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucz kopii zapasowej na tym Macu jest uszkodzony. Najnowsze hasło kopii zapasowej ustawiono tu %@. Zaplanowane kopie zapasowe są wstrzymane, dopóki nie wpiszesz tego hasła albo nie zresetujesz go frazą odzyskiwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave de backup deste Mac está danificada. A senha de backup mais recente aqui foi definida em %@. Os backups agendados ficam pausados até você digitar essa senha de backup ou redefini-la com a frase de recuperação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 上的备份密钥已损坏。此处最新的备份密码设置于 %@。在您输入该备份密码或使用恢复短语重置之前，定时备份将暂停。"
          }
        }
      }
    },
    "The backup key on this Mac is missing, but a backup password was set here on %@. Scheduled backups are paused until you enter that backup password, or reset it with the recovery phrase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Backup-Schlüssel auf diesem Mac fehlt, obwohl hier am %@ ein Backup-Passwort festgelegt wurde. Geplante Backups sind pausiert, bis Sie dieses Backup-Passwort eingeben oder es mit der Wiederherstellungsphrase zurücksetzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta la clave de copia de seguridad de este Mac, pero aquí se estableció una contraseña de copia de seguridad el %@. Las copias programadas están en pausa hasta que escribas esa contraseña o la restablezcas con la frase de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé de sauvegarde de ce Mac est introuvable, mais un mot de passe de sauvegarde a été défini ici le %@. Les sauvegardes planifiées sont en pause jusqu’à ce que vous saisissiez ce mot de passe de sauvegarde, ou que vous le réinitialisiez avec la phrase de récupération."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave del backup su questo Mac manca, ma qui è stata impostata una password del backup il %@. I backup programmati sono in pausa finché non inserisci quella password del backup o la reimposti con la frase di recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac のバックアップキーがありませんが、ここでは %@ にバックアップパスワードが設定されています。そのバックアップパスワードを入力するか、リカバリーフレーズでリセットするまで、スケジュールされたバックアップは一時停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac의 백업 키가 없지만, 여기서 %@에 백업 비밀번호가 설정되었습니다. 그 백업 비밀번호를 입력하거나 복구 문구로 재설정할 때까지 예약된 백업이 일시 중지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De back-upsleutel op deze Mac ontbreekt, maar hier is op %@ een back-upwachtwoord ingesteld. Geplande back-ups zijn gepauzeerd totdat je dat back-upwachtwoord invoert, of het opnieuw instelt met de herstelzin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brakuje klucza kopii zapasowej na tym Macu, choć hasło kopii zapasowej ustawiono tu %@. Zaplanowane kopie zapasowe są wstrzymane, dopóki nie wpiszesz tego hasła albo nie zresetujesz go frazą odzyskiwania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave de backup deste Mac está faltando, mas uma senha de backup foi definida aqui em %@. Os backups agendados ficam pausados até você digitar essa senha de backup ou redefini-la com a frase de recuperação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 上的备份密钥缺失，但此处曾于 %@ 设置过备份密码。在您输入该备份密码或使用恢复短语重置之前，定时备份将暂停。"
          }
        }
      }
    },
