    "sync.aFileAttachedOnAnother" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine auf einem anderen Gerät angehängte Datei ist noch nicht angekommen. Der zugehörige Eintrag erscheint nach einer Synchronisierung, die die Datei empfängt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A file attached on another device has not arrived yet. Its item appears after a sync that receives the file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo adjuntado en otro dispositivo aún no ha llegado. Su elemento aparece tras una sincronización que reciba el archivo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file allegato su un altro dispositivo non è ancora arrivato. Il suo elemento compare dopo una sincronizzazione che riceve il file."
