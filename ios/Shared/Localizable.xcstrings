      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher? Das kann nicht rückgängig gemacht werden. Tresor dieses iPhones jetzt löschen?"
          }
        },
        "es" : {
