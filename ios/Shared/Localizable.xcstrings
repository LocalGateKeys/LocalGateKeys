        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenSSH 한 줄(ssh-ed25519 AAAA…)입니다. 지문은 이 값에서 계산됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een OpenSSH-regel (ssh-ed25519 AAAA…). De vingerafdruk wordt eruit berekend."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiersz OpenSSH (ssh-ed25519 AAAA…). Odcisk jest z niego obliczany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma linha OpenSSH (ssh-ed25519 AAAA…). A impressão digital é calculada a partir dela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一行 OpenSSH 密钥（ssh-ed25519 AAAA…）。指纹将由它计算得出。"
          }
        }
      }
    },
    "An agent that controls your browser can read a password filled into the page. If a passkey is saved for the site, agents sign in with the passkey instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Agent, der Ihren Browser steuert, kann ein in die Seite eingefülltes Passwort lesen. Ist für die Website ein Passkey gespeichert, melden sich Agenten stattdessen mit dem Passkey an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agente que controle tu navegador puede leer una contraseña rellenada en la página. Si hay una clave de acceso guardada para el sitio, los agentes inician sesión con la clave de acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agent qui contrôle votre navigateur peut lire un mot de passe rempli dans la page. Si une clé d'accès est enregistrée pour le site, les agents se connectent plutôt avec la clé d'accès."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un agente che controlla il browser può leggere una password inserita nella pagina. Se per il sito è salvata una passkey, gli agenti accedono invece con la passkey."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブラウザーを操作するエージェントは、ページに入力されたパスワードを読み取れます。このサイトのパスキーが保存されている場合、エージェントは代わりにパスキーでサインインします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "브라우저를 제어하는 에이전트는 페이지에 채워진 비밀번호를 읽을 수 있습니다. 이 사이트의 패스키가 저장되어 있으면 에이전트는 대신 패스키로 로그인합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een agent die uw browser bestuurt, kan een wachtwoord lezen dat in de pagina is ingevuld. Als er voor de website een passkey is opgeslagen, loggen agents in plaats daarvan in met de passkey."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent sterujący przeglądarką może odczytać hasło wpisane na stronie. Jeśli dla witryny zapisano klucz dostępu, agenci logują się zamiast tego kluczem dostępu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um agente que controla o seu navegador pode ler uma senha preenchida na página. Se houver uma chave de acesso salva para o site, os agentes entram com a chave de acesso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制你浏览器的代理可以读取填入页面的密码。如果为此网站保存了通行密钥，代理将改用通行密钥登录。"
          }
        }
      }
    },
    "An encrypted backup can be restored in the desktop app." : {
