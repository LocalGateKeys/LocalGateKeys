    "Choose the folder for scheduled backups. They go into a Scheduled folder inside it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie den Ordner für geplante Backups. Sie landen in einem Unterordner „Scheduled“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la carpeta de las copias programadas. Van a una carpeta Scheduled dentro de ella."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli la cartella per i backup programmati. Vanno in una cartella Scheduled al suo interno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スケジュールされたバックアップのフォルダを選んでください。バックアップはその中の「Scheduled」フォルダに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예약된 백업의 폴더를 선택하세요. 백업은 그 안의 Scheduled 폴더에 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de map voor geplande back-ups. Ze komen in een map Scheduled daarbinnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz folder na zaplanowane kopie zapasowe. Trafiają one do folderu Scheduled wewnątrz niego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a pasta dos backups agendados. Eles vão para uma pasta Scheduled dentro dela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择定时备份的文件夹。备份会存入其中的“Scheduled”文件夹。"
          }
        }
      }
    },
    "Choose the folder for the backup. Its checksum file is saved beside it. A folder on another disk keeps it safe if this Mac fails." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie den Ordner für das Backup. Die zugehörige Prüfsummendatei wird daneben gespeichert. Ein Ordner auf einem anderen Laufwerk schützt es, falls dieser Mac ausfällt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la carpeta de la copia de seguridad. Su archivo de suma de comprobación se guarda a su lado. Una carpeta en otro disco la mantiene a salvo si este Mac falla."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli la cartella per il backup. Il suo file di checksum viene salvato accanto. Una cartella su un altro disco lo mantiene al sicuro se questo Mac si guasta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップのフォルダを選んでください。チェックサムファイルはその隣に保存されます。別のディスク上のフォルダなら、このMacが故障しても安全です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업을 저장할 폴더를 선택하세요. 체크섬 파일은 그 옆에 저장됩니다. 다른 디스크의 폴더라면 이 Mac에 문제가 생겨도 안전합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies de map voor de back-up. Het bijbehorende controlesombestand wordt ernaast bewaard. Een map op een andere schijf houdt de back-up veilig als deze Mac uitvalt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz folder na kopię zapasową. Plik sumy kontrolnej zostanie zapisany obok niej. Folder na innym dysku chroni kopię, jeśli ten Mac ulegnie awarii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a pasta do backup. O arquivo de checksum dele é salvo ao lado. Uma pasta em outro disco o mantém seguro se este Mac falhar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择备份的文件夹。其校验文件会保存在旁边。如果这台 Mac 出现故障，另一块磁盘上的文件夹可以让备份保持安全。"
          }
        }
      }
    },
