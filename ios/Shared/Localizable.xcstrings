    "ipad.emergencyKitDocument.ifLostOrVault" : {
      "comment" : "iPad wording of \"If the iPhone is lost or the vault is gone, install LocalGa…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist das iPad verloren oder der Tresor weg, installieren Sie LocalGateKeys auf einem neuen iPad und synchronisieren Sie es mit Ihrem PC, Mac oder einem anderen iPad. Ein verschlüsseltes Backup, das von diesem iPad exportiert wurde, lässt sich auf dem neuen iPad wiederherstellen (Einstellungen › Import & Export › Aus einem Backup wiederherstellen)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the iPad is lost or the vault is gone, install LocalGateKeys on a new iPad and sync it with your PC, Mac or another iPad. An encrypted backup exported from this iPad can be restored on the new iPad (Settings › Import & Export › Restore from a backup)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si pierdes el iPad o desaparece la bóveda, instala LocalGateKeys en un iPad nuevo y sincronízalo con tu PC, Mac u otro iPad. Una copia de seguridad cifrada exportada desde este iPad se puede restaurar en el iPad nuevo (Ajustes › Importar y exportar › Restaurar desde una copia de seguridad)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’iPad est perdu ou le coffre-fort a disparu, installez LocalGateKeys sur un nouvel iPad et synchronisez-le avec votre PC, votre Mac ou un autre iPad. Une sauvegarde chiffrée exportée depuis cet iPad peut être restaurée sur le nouvel iPad (Paramètres › Import et export › Restaurer depuis une sauvegarde)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se perdi l’iPad o la cassaforte non c’è più, installa LocalGateKeys su un nuovo iPad e sincronizzalo con il tuo PC, Mac o un altro iPad. Un backup cifrato esportato da questo iPad si può ripristinare sul nuovo iPad (Impostazioni › Importa ed esporta › Ripristina da un backup)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad を紛失したり保管庫がなくなったりした場合は、新しい iPad に LocalGateKeys をインストールし、PC、Mac、または別の iPad と同期してください。この iPad から書き出した暗号化バックアップは、新しい iPad で復元できます(設定 › インポートとエクスポート › バックアップから復元)。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPad를 잃어버렸거나 보관함이 사라졌다면 새 iPad에 LocalGateKeys를 설치하고 PC, Mac 또는 다른 iPad와 동기화하세요. 이 iPad에서 내보낸 암호화된 백업은 새 iPad에서 복원할 수 있습니다(설정 › 가져오기 및 내보내기 › 백업에서 복원)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is de iPad kwijt of is de kluis weg, installeer LocalGateKeys dan op een nieuwe iPad en synchroniseer hem met je pc, Mac of een andere iPad. Een versleutelde back-up die vanaf deze iPad is geëxporteerd, kun je op de nieuwe iPad herstellen (Instellingen › Importeren en exporteren › Herstellen vanuit een back-up)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli zgubisz iPada lub sejf zniknie, zainstaluj LocalGateKeys na nowym iPadzie i zsynchronizuj go z komputerem PC, Makiem lub innym iPadem. Zaszyfrowaną kopię zapasową wyeksportowaną z tego iPada można przywrócić na nowym iPadzie (Ustawienia › Import i eksport › Przywróć z kopii zapasowej)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o iPad for perdido ou o cofre sumir, instale o LocalGateKeys em um iPad novo e sincronize-o com seu PC, Mac ou outro iPad. Um backup criptografado exportado deste iPad pode ser restaurado no iPad novo (Configurações › Importar e exportar › Restaurar de um backup)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果 iPad 丢失或保险库不见了,请在新 iPad 上安装 LocalGateKeys,并与你的 PC、Mac 或另一台 iPad 同步。从这台 iPad 导出的加密备份可以在新 iPad 上还原(设置 › 导入与导出 › 从备份还原)。"
          }
        }
      }
    },
    "ipad.emergencyKitDocument.keepPageOfflineAnd" : {
      "comment" : "iPad wording of \"Keep this page offline and apart from your iPhone. It tells…\"",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahren Sie diese Seite offline und getrennt von Ihrem iPad auf. Sie zeigt, wie Sie wieder in LocalGateKeys kommen, wenn Sie das App-Passwort vergessen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep this page offline and apart from your iPad. It tells you how to get back into LocalGateKeys if you forget the app password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda esta página sin conexión y separada de tu iPad. Explica cómo volver a entrar en LocalGateKeys si olvidas la contraseña de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez cette page hors ligne et séparée de votre iPad. Elle explique comment retrouver l’accès à LocalGateKeys si vous oubliez le mot de passe de l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva questa pagina offline e separata dall’iPad. Spiega come rientrare in LocalGateKeys se dimentichi la password dell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このページはオフラインで、iPad とは別の場所に保管してください。アプリのパスワードを忘れたときに LocalGateKeys に戻る手順が書かれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 페이지는 오프라인으로, iPad와 따로 보관하세요. 앱 비밀번호를 잊었을 때 LocalGateKeys에 다시 들어가는 방법이 적혀 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar deze pagina offline en gescheiden van je iPad. Er staat op hoe je weer in LocalGateKeys komt als je het app-wachtwoord vergeet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechowuj tę stronę offline i oddzielnie od iPada. Wyjaśnia, jak wrócić do LocalGateKeys, gdy zapomnisz hasła aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde esta página offline e separada do seu iPad. Ela explica como voltar ao LocalGateKeys se você esquecer a senha do app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请将此页离线保存，并与 iPad 分开存放。它说明忘记应用密码时如何重新进入 LocalGateKeys。"
          }
        }
      }
    },
