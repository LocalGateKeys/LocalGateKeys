    "Free plan: paired devices can give this Mac their Pro licence. Items sync with Pro." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenloser Tarif: Gekoppelte Geräte können diesem Mac ihre Pro-Lizenz geben. Einträge werden mit Pro synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan gratuito: los dispositivos emparejados pueden dar su licencia Pro a este Mac. Los elementos se sincronizan con Pro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offre gratuite : les appareils associés peuvent donner leur licence Pro à ce Mac. Les éléments se synchronisent avec Pro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piano gratuito: i dispositivi associati possono dare a questo Mac la loro licenza Pro. Gli elementi si sincronizzano con Pro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料プラン: ペアリング済みのデバイスが、このMacにProライセンスを渡せます。項目の同期にはProが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료 플랜: 페어링한 기기가 이 Mac에 Pro 라이선스를 줄 수 있습니다. 항목 동기화는 Pro에서 가능합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis abonnement: gekoppelde apparaten kunnen deze Mac hun Pro-licentie geven. Items synchroniseren met Pro."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan darmowy: sparowane urządzenia mogą przekazać temu Makowi swoją licencję Pro. Elementy synchronizują się z Pro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plano gratuito: os dispositivos pareados podem dar a este Mac a licença Pro deles. Os itens sincronizam com o Pro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费版：已配对的设备可以把它们的 Pro 许可证提供给这台 Mac。项目同步需要 Pro。"
          }
        }
      }
    },
