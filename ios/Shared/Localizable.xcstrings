        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze iPad heeft een oudere synchronisatiesleutel dan %@. Laat de cloudmap eerst klaar synchroniseren, of voeg de map opnieuw toe met het nieuwste synchronisatiewachtwoord."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten iPad ma starszy klucz synchronizacji niż %@. Poczekaj, aż folder w chmurze dokończy synchronizację, lub dołącz do folderu ponownie z najnowszym hasłem synchronizacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPad tem uma chave de sincronização mais antiga que a de %@. Deixe a pasta na nuvem terminar de sincronizar ou entre novamente na pasta com a senha de sincronização mais recente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
