          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja nie mogła przenieść usuniętych elementów do kosza, ponieważ kosz jest pełny. Opróżnij kosz, a potem zsynchronizuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização não conseguiu mover os itens excluídos para a lixeira porque a lixeira está cheia. Esvazie a lixeira e sincronize novamente."
          }
        },
        "zh-Hans" : {
