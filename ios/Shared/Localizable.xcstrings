        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tożsamość synchronizacji tego Maka nie zgadza się z jego parowaniem. Zresetuj synchronizację na tym Maku i sparuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A identidade de sincronização deste Mac não corresponde ao pareamento dele. Redefina a sincronização neste Mac e pareie novamente."
