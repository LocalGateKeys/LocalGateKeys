    },
    "Strict offline mode is on, so breach checks are blocked. Turn it off in Settings › Breach checks." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der strikte Offline-Modus ist an, daher sind Kompromittierungsprüfungen blockiert. Schalten Sie ihn unter Einstellungen › Kompromittierungsprüfungen aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo estricto sin conexión está activado, por lo que las comprobaciones de filtraciones están bloqueadas. Desactívalo en Ajustes › Comprobaciones de filtraciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode hors ligne strict est activé ; les vérifications des fuites sont donc bloquées. Désactivez-le dans Réglages › Vérifications des fuites."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità offline rigorosa è attiva, quindi i controlli delle violazioni sono bloccati. Disattivala in Impostazioni › Controlli delle violazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "厳格オフラインモードがオンのため、漏えいチェックはブロックされています。設定 › 漏えいチェックでオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엄격한 오프라인 모드가 켜져 있어 유출 검사가 차단됩니다. 설정 › 유출 검사에서 끄세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strikte offlinemodus staat aan, dus datalekcontroles zijn geblokkeerd. Schakel die uit via Instellingen › Datalekcontroles."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ścisły tryb offline jest włączony, więc sprawdzanie wycieków jest zablokowane. Wyłącz go w Ustawienia › Sprawdzanie wycieków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo offline estrito está ativado, então as verificações de vazamento estão bloqueadas. Desative-o em Ajustes › Verificação de vazamentos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "严格离线模式已开启，因此泄露检查被阻止。请在“设置 › 泄露检查”中关闭。"
          }
        }
      }
    },
    "Strict offline mode is on. Turn it off in Privacy settings to run an explicit external check." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der strenge Offline-Modus ist eingeschaltet. Schalten Sie ihn in den Datenschutzeinstellungen aus, um eine ausdrückliche externe Prüfung auszuführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modo estrictamente sin conexión está activado. Desactívalo en los ajustes de Privacidad para hacer una comprobación externa explícita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode hors ligne strict est activé. Désactivez-le dans les paramètres de confidentialité pour lancer une vérification externe explicite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modalità offline rigorosa è attiva. Disattivala nelle impostazioni della privacy per eseguire un controllo esterno esplicito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "厳格オフラインモードがオンです。外部への確認を明示的に実行するには、プライバシー設定でオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엄격한 오프라인 모드가 켜져 있습니다. 외부 확인을 직접 실행하려면 개인정보 보호 설정에서 끄세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De strikte offlinemodus staat aan. Zet hem uit in de privacy-instellingen om een expliciete externe controle uit te voeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ścisły tryb offline jest włączony. Wyłącz go w ustawieniach prywatności, aby wykonać jawne sprawdzenie zewnętrzne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo offline estrito está ativado. Desative-o nas configurações de Privacidade para executar uma verificação externa explícita."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "严格离线模式已开启。请在隐私设置中关闭它，才能执行明确的外部检查。"
          }
        }
      }
    },
