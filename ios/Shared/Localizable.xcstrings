          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 단어가 문구의 순서와 일치하지 않습니다. 적어 둔 사본을 확인하고 다시 시도하거나 문구로 돌아가세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die woorden komen in die volgorde niet overeen met de zin. Controleer je opgeschreven kopie en probeer het opnieuw, of ga terug naar de zin."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te słowa nie zgadzają się z frazą w tej kolejności. Sprawdź zapisaną kopię i spróbuj ponownie lub wróć do frazy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essas palavras não correspondem à frase nessa ordem. Confira sua cópia escrita e tente novamente, ou volte para a frase."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些词语与恢复短语按该顺序不符。请核对您的书面副本后再试，或返回查看恢复短语。"
          }
        }
      }
    },
