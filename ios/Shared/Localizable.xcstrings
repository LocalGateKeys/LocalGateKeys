          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile aprire le impostazioni di compilazione automatica. Apri l'app Impostazioni › Generali › Compilazione automatica e password e attiva LocalGateKeys."
