    "sync.thisDeviceMayHaveBeen" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät wurde möglicherweise aus der Synchronisierung entfernt. Treten Sie erneut bei, falls das nicht erwartet war."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device may have been removed from sync. Re-join if that isn't expected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que este dispositivo se haya quitado de la sincronización. Vuelve a unirte si no lo esperabas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil a peut-être été retiré de la synchronisation. Rejoignez-la de nouveau si ce n’est pas attendu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
