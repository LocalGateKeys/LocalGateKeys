        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva el desbloqueo con Face ID mientras haya un archivo de clave o una YubiKey."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
