    "Are you sure? This cannot be undone. Erase this iPhone's vault now?" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher? Das kann nicht rückgängig gemacht werden. Tresor dieses iPhones jetzt löschen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro? Esto no se puede deshacer. ¿Borrar ahora la bóveda de este iPhone?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr ? Cette action est irréversible. Effacer maintenant le coffre-fort de cet iPhone ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro? Non si può annullare. Cancellare ora la cassaforte di questo iPhone?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よろしいですか? この操作は取り消せません。今すぐこのiPhoneの保管庫を消去しますか?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정말입니까? 이 작업은 되돌릴 수 없습니다. 지금 이 iPhone의 보관함을 지우시겠습니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je het zeker? Dit kan niet ongedaan worden gemaakt. De kluis van deze iPhone nu wissen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na pewno? Tego nie można cofnąć. Wymazać teraz sejf z tego iPhone'a?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem certeza? Isso não pode ser desfeito. Apagar o cofre deste iPhone agora?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确定吗？此操作无法撤销。现在抹掉这台 iPhone 的保管库？"
          }
        }
      }
    },
