        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een ander apparaat van je doet mee aan deze gedeelde verzameling. Beheer het delen op dat apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inne z Twoich urządzeń należy do tej udostępnionej kolekcji. Zarządzaj udostępnianiem na tamtym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
