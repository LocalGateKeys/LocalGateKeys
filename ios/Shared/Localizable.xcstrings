        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번의 스캔으로 최대 256개 계정을 추가할 수 있습니다. 이 계정들을 추가한 뒤 나머지는 따로 스캔하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
