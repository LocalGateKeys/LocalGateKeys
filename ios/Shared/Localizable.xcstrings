    "macOS didn't allow opening at login. Check System Settings › General › Login Items." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat das Öffnen bei der Anmeldung nicht erlaubt. Prüfen Sie Systemeinstellungen › Allgemein › Anmeldeobjekte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no permitió abrir al iniciar sesión. Revisa Ajustes del Sistema › General › Ítems de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n’a pas autorisé l’ouverture à la connexion. Vérifiez Réglages Système › Général › Ouverture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non ha consentito l'apertura al login. Controlla Impostazioni di Sistema › Generali › Elementi login."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSがログイン時に開くことを許可しませんでした。「システム設定 › 一般 › ログイン項目」を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 로그인 시 열기를 허용하지 않았습니다. 시스템 설정 › 일반 › 로그인 항목을 확인하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS stond openen bij inloggen niet toe. Controleer Systeeminstellingen › Algemeen › Inlogonderdelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nie zezwolił na otwieranie przy logowaniu. Sprawdź Ustawienia systemowe › Ogólne › Rzeczy otwierane podczas logowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS não permitiu abrir ao iniciar sessão. Verifique Ajustes do Sistema › Geral › Itens de Início."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 未允许登录时打开。请检查“系统设置 › 通用 › 登录项”。"
          }
        }
      }
    },
    "macOS didn't remove the login item. Turn it off in System Settings › General › Login Items." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat das Anmeldeobjekt nicht entfernt. Schalten Sie es unter Systemeinstellungen › Allgemein › Anmeldeobjekte aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no quitó el ítem de inicio. Desactívalo en Ajustes del Sistema › General › Ítems de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n’a pas supprimé l’élément de connexion. Désactivez-le dans Réglages Système › Général › Ouverture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non ha rimosso l'elemento login. Disattivalo in Impostazioni di Sistema › Generali › Elementi login."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSがログイン項目を削除しませんでした。「システム設定 › 一般 › ログイン項目」でオフにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 로그인 항목을 제거하지 않았습니다. 시스템 설정 › 일반 › 로그인 항목에서 끄십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS heeft het inlogonderdeel niet verwijderd. Zet het uit in Systeeminstellingen › Algemeen › Inlogonderdelen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nie usunął elementu logowania. Wyłącz go w Ustawieniach systemowych › Ogólne › Rzeczy otwierane podczas logowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS não removeu o item de início. Desative-o em Ajustes do Sistema › Geral › Itens de Início."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 未移除登录项。请在“系统设置 › 通用 › 登录项”中将其关闭。"
