{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "default_locale": "en",
  "version": "0.4.10",
  "description": "__MSG_ext_description_macos__",
  "permissions": [
    "nativeMessaging",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "api.js",
      "background-safari.js"
    ],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "api.js",
        "heuristics.js",
        "login-safety.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
